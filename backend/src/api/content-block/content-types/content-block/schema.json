{
  "kind": "collectionType",
  "collectionName": "content_blocks",
  "info": {
    "singularName": "content-block",
    "pluralName": "content-blocks",
    "displayName": "Content Block",
    "description": "Blocs de contenu réutilisables dans l'éditeur"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["header", "footer", "sidebar", "content", "cta", "other"],
      "default": "content",
      "required": true
    },
    "site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site",
      "required": true
    }
  }
}
