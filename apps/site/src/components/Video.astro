---
/**
 * Lecteur d'une vidéo de communeo.fr : image d'attente et bouton « lecture » dans la charte, puis le
 * lecteur du navigateur (commandes au clavier), sous-titres affichés d'emblée (la vidéo se comprend
 * sans le son) et transcription dépliable en dessous. Jamais de lecture automatique, rien ne se charge
 * avant le clic (`preload="none"`). Sans JavaScript : le lecteur du navigateur, directement.
 */
import { fichiersVideo, VIDEOS, type IdVideo } from '../lib/videos';

interface Props {
  id: IdVideo;
  /** Texte du bouton lecture ; par défaut le titre et la durée */
  libelle?: string;
  /** Bouton de taille moyenne (vidéo dans une colonne) */
  compact?: boolean;
  class?: string;
}

const { id, libelle, compact = false, class: classe } = Astro.props;
const { titre, duree } = VIDEOS[id];
// « Le devis en ligne · 20 s » : sur un lecteur étroit, seule la durée reste visible
const [nom, ...reste] = (libelle ?? `${titre} · ${duree}`).split(' · ');
const finVisible = reste.length ? reste.join(' · ') : nom;
const fichiers = await fichiersVideo(id);
const idTranscription = `transcription-${id}`;
---

<figure class:list={['video', classe]} data-video>
  <div class="cadre">
    <video controls preload="none" poster={fichiers.apercu} width="1920" height="1080" playsinline aria-label={titre}>
      <source src={fichiers.mp4} type="video/mp4" />
      <track kind="captions" srclang="fr" label="Français" src={fichiers.vtt} default />
      <a href={fichiers.mp4}>Télécharger la vidéo « {titre} » (MP4)</a>
    </video>
    <!-- Nom accessible = texte visible, précédé de « Lire la vidéo » (pas d'aria-label qui le contredirait) -->
    <button type="button" class:list={['lire', { compact }]} hidden data-lire>
      <span class="rond" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4v16l13-8z"></path></svg></span>
      <span class="libelle"><span class="sr-only">Lire la vidéo : </span>{reste.length > 0 && <span class="nom">{nom} · </span>}{finVisible}</span>
    </button>
  </div>
  <details class="transcription" id={idTranscription}>
    <summary>Lire la transcription</summary>
    <div class="texte" set:html={fichiers.transcription} />
  </details>
</figure>

<script>
  // Amélioration progressive : le bouton de la charte remplace celui du lecteur jusqu'au premier clic
  for (const figure of document.querySelectorAll<HTMLElement>('[data-video]')) {
    const video = figure.querySelector('video');
    const lire = figure.querySelector<HTMLButtonElement>('[data-lire]');
    if (!video || !lire) continue;
    video.controls = false;
    lire.hidden = false;
    lire.addEventListener('click', () => {
      lire.hidden = true;
      video.controls = true;
      video.focus();
      void video.play();
    });
  }
</script>

<style>
  .video {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin: 0;
  }

  .cadre {
    position: relative;
    container-type: inline-size;
    border-radius: 20px;
    overflow: hidden;
    background: var(--sauge);
    box-shadow: var(--ombre-capture);
  }

  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    background: var(--sauge);
  }

  .lire {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: calc(100% - 32px);
    min-height: 64px;
    padding: 0 clamp(16px, 4vw, 26px) 0 12px;
    border: none;
    border-radius: 40px;
    background: var(--sapin);
    color: var(--papier);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 18px 40px -18px rgba(14, 64, 51, 0.6);
    transition: background 0.2s;
  }

  /* Le style du bouton ne doit pas l'emporter sur l'attribut hidden (avant le script, après le clic) */
  .lire[hidden] {
    display: none;
  }

  .lire:hover {
    background: var(--sapin-profond);
  }

  .lire:focus-visible {
    outline: 3px solid var(--papier);
    outline-offset: 3px;
    box-shadow: 0 0 0 6px var(--sapin);
  }

  .lire.compact {
    min-height: 56px;
    gap: 12px;
    padding: 0 22px 0 10px;
    font-size: 1.0625rem;
  }

  .rond {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--papier);
    color: var(--sapin);
  }

  .compact .rond {
    width: 38px;
    height: 38px;
  }

  .transcription summary {
    width: fit-content;
    font-size: 1rem;
    font-weight: 600;
    color: var(--sapin);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .texte {
    margin-top: 12px;
    padding: 20px clamp(16px, 3vw, 28px);
    border-radius: 14px;
    background: var(--blanc);
    border: 1px solid var(--grege);
    font-size: 1rem;
    line-height: 1.6;
  }

  .texte :global(p) {
    margin: 0 0 0.75em;
  }

  .texte :global(p:last-child) {
    margin-bottom: 0;
  }

  .texte :global(em) {
    color: var(--encre-douce);
  }

  /* Lecteur étroit (téléphone, colonne, fenêtre) : le titre ne tient pas sur une ligne, il reste pour
     les lecteurs d'écran ; on voit le bouton et la durée */
  @container (max-width: 560px) {
    .nom {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  @media (max-width: 480px) {
    .lire {
      min-height: 52px;
      padding: 0 16px 0 8px;
      font-size: 0.9375rem;
    }

    .rond {
      width: 36px;
      height: 36px;
    }
  }
</style>
