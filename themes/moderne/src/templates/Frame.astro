---
/** Cadre des pages communes (mentions légales, données personnelles, accessibilité, plan du site, recherche, démarches). */
import type { PageContext } from '@communeo/theme-contract';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; lead?: string | null }
const { ctx, lead } = Astro.props;
---
<Layout ctx={ctx} heading={false}>
  <article class="mo-frame-page">
    <header class="mo-page-header">
      <h1>{ctx.title}</h1>
      {lead && <p class="mo-lead">{lead}</p>}
    </header>
    <div class="mo-prose mo-frame"><slot /></div>
  </article>
</Layout>
