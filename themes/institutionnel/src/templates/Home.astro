---
/**
 * Accueil : sections empilées sur une colonne, dans l'ordre d'importance pour un habitant —
 * accroche, accès rapides, actualités, agenda et informations pratiques, puis la vie de la commune.
 */
import type { HomeVM } from '@communeo/core';
import type { PageContext } from '@communeo/theme-contract';
import OpeningStatus from '@communeo/ui-a11y/OpeningStatus.astro';
import RichText from '@communeo/ui-a11y/RichText.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Info from '@lucide/astro/icons/info';
import OctagonAlert from '@lucide/astro/icons/octagon-alert';
import TriangleAlert from '@lucide/astro/icons/triangle-alert';
import ArticleCard from '../parts/ArticleCard.astro';
import EventCard from '../parts/EventCard.astro';
import Icon from '../parts/Icon.astro';
import Layout from '../parts/Layout.astro';

interface Props {
  ctx: PageContext;
  home: HomeVM;
}

const { ctx, home } = Astro.props;
const { site } = ctx;
const hero = home.hero;
const aside = home.practicalInfo || home.wasteCollection;
const severityIcons = { info: Info, warning: TriangleAlert, critical: OctagonAlert };
const today = home.canteen?.days.find((day) => !day.closed) ?? null;
---
<Layout ctx={ctx} heading={false} full>
  <section class="in-section in-section-plain in-hero" aria-labelledby="in-hero-title">
    <div class:list={['in-container', 'in-hero-grid', { 'in-hero-with-image': hero?.image }]}>
      <div>
        <h1 id="in-hero-title">{hero?.title ?? site.name}</h1>
        {hero?.subtitle && <p class="in-hero-subtitle">{hero.subtitle}</p>}
        {(hero?.primary || hero?.secondary) && (
          <p class="in-hero-actions">
            {hero?.primary && <a class="in-button" href={hero.primary.href}>{hero.primary.label}</a>}
            {hero?.secondary && <a class="in-button in-button-secondary" href={hero.secondary.href}>{hero.secondary.label}</a>}
          </p>
        )}
      </div>
      {hero?.image && (
        <img
          class="in-hero-image"
          src={hero.image.src}
          alt={hero.image.alt}
          srcset={hero.image.srcset ?? undefined}
          width={hero.image.width ?? undefined}
          height={hero.image.height ?? undefined}
          fetchpriority="high"
        />
      )}
    </div>
  </section>

  {home.quickLinks && (
    <section class="in-section in-section-tint" aria-labelledby="in-quick">
      <div class="in-container">
        <h2 id="in-quick">Accès rapides</h2>
        <ul class="in-tiles">
          {home.quickLinks.map((link) => (
            <li>
              <a href={link.href}>
                <span class="in-tile-icon"><Icon name={link.icon} size={26} /></span>
                <span class="in-tile-label">{link.label}</span>
                {link.description && <span class="in-tile-description">{link.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {home.featuredNews && (
    <section class="in-section" aria-labelledby="in-news">
      <div class="in-container">
        <div class="in-section-head">
          <h2 id="in-news">Actualités</h2>
          <a href="/actualites" class="in-more">Toutes les actualités<ArrowRight size={20} aria-hidden="true" /></a>
        </div>
        <div class="in-grid-3">
          {home.featuredNews.map((article) => <ArticleCard article={article} />)}
        </div>
      </div>
    </section>
  )}

  {(home.agenda || aside) && (
    <section class="in-section in-section-plain" aria-label="Agenda et informations pratiques">
      <div class:list={['in-container', 'in-split', { 'in-split-aside': home.agenda && aside }]}>
        {home.agenda && (
          <div>
            <div class="in-section-head">
              <h2 id="in-agenda">Agenda</h2>
              <a href="/agenda" class="in-more">Tout l'agenda<ArrowRight size={20} aria-hidden="true" /></a>
            </div>
            <div class="in-stack">{home.agenda.map((event) => <EventCard event={event} />)}</div>
          </div>
        )}

        {aside && (
          <div class="in-aside">
            {home.practicalInfo && (
              <section class="in-box" aria-labelledby="in-practical">
                <h2 id="in-practical" class="in-box-title">Mairie</h2>
                <OpeningStatus hours={site.contact.hours} class="in-box-status" />
                <address>
                  {site.contact.address && <span class="in-address">{site.contact.address}</span>}
                  {site.contact.phone && <a href={site.contact.phone.href}>{site.contact.phone.label}</a>}
                </address>
                {site.contact.hoursSummary.length > 0 && (
                  <dl class="in-box-hours">
                    {site.contact.hoursSummary.map((line) => <div><dt>{line.days}</dt><dd>{line.hours}</dd></div>)}
                  </dl>
                )}
                <a href="/contact" class="in-more">Contacter la mairie<ArrowRight size={20} aria-hidden="true" /></a>
              </section>
            )}

            {home.wasteCollection && (
              <section class="in-box" aria-labelledby="in-waste">
                <h2 id="in-waste" class="in-box-title">Prochaines collectes</h2>
                <ul class="in-waste-list">
                  {home.wasteCollection.map((collection) => (
                    <li>
                      <span class={`in-waste-badge in-waste-${collection.key}`} aria-hidden="true">{collection.abbreviation}</span>
                      <span>
                        <strong>{collection.label}</strong>
                        {collection.upcoming[0] && <> · <time datetime={collection.upcoming[0].iso}>{collection.upcoming[0].label}</time></>}
                      </span>
                    </li>
                  ))}
                </ul>
                <a href="/collecte-des-dechets" class="in-more">Tout le calendrier<ArrowRight size={20} aria-hidden="true" /></a>
              </section>
            )}
          </div>
        )}
      </div>
    </section>
  )}

  {home.mayorWord && (
    <section class="in-section" aria-labelledby="in-mayor">
      <div class:list={['in-container', 'in-mayor', { 'in-mayor-with-photo': home.mayorWord.photo }]}>
        {home.mayorWord.photo && (
          <img
            class="in-mayor-photo"
            src={home.mayorWord.photo.src}
            alt={home.mayorWord.photo.alt}
            width={home.mayorWord.photo.width ?? undefined}
            height={home.mayorWord.photo.height ?? undefined}
            loading="lazy"
          />
        )}
        <div>
          <h2 id="in-mayor">{home.mayorWord.title}</h2>
          <RichText doc={home.mayorWord.body} class="in-prose in-mayor-body" />
          {home.mayorWord.signature.name && (
            <p class="in-mayor-signature">
              {home.mayorWord.signature.name}
              {home.mayorWord.signature.role && <><br /><span>{home.mayorWord.signature.role}</span></>}
            </p>
          )}
        </div>
      </div>
    </section>
  )}

  {home.keyFigures && (
    <section class="in-section in-section-invert in-on-dark" aria-labelledby="in-figures">
      <div class="in-container">
        <h2 id="in-figures" class="cn-sr-only">La commune en chiffres</h2>
        <ul class="in-figures">
          {home.keyFigures.map((figure) => (
            <li>
              <Icon name={figure.icon} fallback="figure" size={30} />
              <p class="in-figure-value">{figure.value}</p>
              <p>{figure.label}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {(home.disruptions || home.canteen) && (
    <section class="in-section in-section-plain" aria-label="Perturbations et cantine">
      <div class:list={['in-container', 'in-split', { 'in-split-half': home.disruptions && home.canteen }]}>
        {home.disruptions && (
          <div>
            <div class="in-section-head">
              <h2 id="in-disruptions">Perturbations en cours</h2>
              <a href="/perturbations" class="in-more">Toutes<ArrowRight size={20} aria-hidden="true" /></a>
            </div>
            <ul class="in-disruptions">
              {home.disruptions.map((alert) => {
                const Severity = severityIcons[alert.severity.key];
                return (
                  <li class={`in-disruption in-alert-${alert.severity.key}`}>
                    <Severity size={24} aria-hidden="true" />
                    <div>
                      <p class="in-disruption-kind">{alert.severity.label}{alert.type && <> · {alert.type.label}</>}</p>
                      <p class="in-disruption-title">{alert.link ? <a href={alert.link.href}>{alert.title}</a> : alert.title}</p>
                      <p class="in-meta">{alert.period ?? alert.message}{alert.location && <> · {alert.location}</>}</p>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        )}

        {home.canteen && (
          <div>
            <div class="in-section-head">
              <h2 id="in-canteen">Cantine</h2>
              <a href="/cantine" class="in-more">Toute la semaine<ArrowRight size={20} aria-hidden="true" /></a>
            </div>
            <div class="in-box in-canteen">
              {today ? (
                <>
                  <p class="in-canteen-day">
                    <strong>{today.day.label} {today.date.label}</strong>
                    {home.canteen.school && <> · {home.canteen.school}</>}
                  </p>
                  <ul class="in-canteen-menu">
                    {today.courses.map((course) => (
                      <li>
                        {course.dish}
                        {course.badges.map((badge) => <span class="in-tag in-tag-soft">{badge}</span>)}
                      </li>
                    ))}
                  </ul>
                </>
              ) : (
                <p>{home.canteen.label}{home.canteen.school && <> · {home.canteen.school}</>}</p>
              )}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  {home.associations && (
    <section class="in-section" aria-labelledby="in-assos">
      <div class="in-container">
        <div class="in-section-head">
          <h2 id="in-assos">Associations</h2>
          <a href="/associations" class="in-more">Annuaire des associations<ArrowRight size={20} aria-hidden="true" /></a>
        </div>
        <ul class="in-assos">
          {home.associations.map((association) => (
            <li>
              <a href={association.href}>
                {association.logo ? (
                  <img src={association.logo.src} alt="" width={association.logo.width ?? undefined} height={association.logo.height ?? undefined} loading="lazy" />
                ) : (
                  <span class="in-initials" aria-hidden="true">{association.name.slice(0, 2).toUpperCase()}</span>
                )}
                <span class="in-asso-name">{association.name}</span>
                <span class="in-meta">{association.category.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {(home.freeContent || home.newsletter || home.partners) && (
    <section class="in-section in-section-plain" aria-label="La commune">
      <div class:list={['in-container', 'in-split', { 'in-split-half': home.freeContent && (home.newsletter || home.partners) }]}>
        {home.freeContent && (
          <div>
            <h2 id="in-free">{home.freeContent.title ?? `Découvrir ${site.name}`}</h2>
            <RichText doc={home.freeContent.body} class="in-prose in-free" />
          </div>
        )}

        {(home.newsletter || home.partners) && (
          <div class="in-aside">
            {home.newsletter && (
              <section class="in-box" aria-labelledby="in-newsletter">
                <h2 id="in-newsletter" class="in-box-title">Lettre d'information</h2>
                <p>Recevez l'actualité de la commune une fois par mois, par e-mail.</p>
                <p><a href="/contact" class="in-button">S'inscrire à la lettre d'information</a></p>
                <p class="in-meta">Désinscription possible à tout moment. <a href="/donnees-personnelles">Données personnelles</a></p>
              </section>
            )}

            {home.partners && (
              <section aria-labelledby="in-partners">
                <h2 id="in-partners" class="in-box-title">Partenaires</h2>
                <ul class="in-partners">
                  {home.partners.map((partner) => (
                    <li>
                      {partner.href ? (
                        <a href={partner.href} target="_blank" rel="noopener noreferrer">
                          {partner.logo
                            ? <img src={partner.logo.src} alt={partner.name} width={partner.logo.width ?? undefined} height={partner.logo.height ?? undefined} loading="lazy" />
                            : partner.name}
                          <span class="cn-sr-only"> (nouvelle fenêtre)</span>
                        </a>
                      ) : partner.logo ? (
                        <img src={partner.logo.src} alt={partner.name} width={partner.logo.width ?? undefined} height={partner.logo.height ?? undefined} loading="lazy" />
                      ) : (
                        partner.name
                      )}
                    </li>
                  ))}
                </ul>
              </section>
            )}
          </div>
        )}
      </div>
    </section>
  )}
</Layout>
