{
  "kind": "collectionType",
  "collectionName": "sites",
  "info": {
    "singularName": "site",
    "pluralName": "sites",
    "displayName": "Site",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 100
    },
    "slug": {
      "type": "uid",
      "targetField": "nom",
      "required": true
    },
    "theme": {
      "type": "enumeration",
      "enum": ["classique", "moderne", "accessible"],
      "default": "classique",
      "required": true
    },
    "colors": {
      "type": "json"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "contact_mail": {
      "type": "email",
      "required": true
    },
    "contact_phone": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "pages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::page.page",
      "mappedBy": "site"
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "site"
    },
    "evenements": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::evenement.evenement",
      "mappedBy": "site"
    }
  }
}
