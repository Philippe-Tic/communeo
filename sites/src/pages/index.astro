---
import type { Article, Event, TeamMember, Association, HomepageQuickLink } from '../types/strapi';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import StrapiImage from '../components/StrapiImage.astro';
import Section from '../components/Section.astro';
import {
  getSiteConfig,
  getFeaturedArticles,
  getUpcomingEvents,
  getMayor,
  getPublishedAssociations,
  formatDate,
} from '../utils/strapi';

// Récupération des données principales
const siteConfig = await getSiteConfig();
const hp = siteConfig.homepage;

// Récupération parallèle des données
let featuredArticles: Article[] = [];
let upcomingEvents: Event[] = [];
let mayor: TeamMember | null = null;
let associations: Association[] = [];

try {
  const articlesCount = hp?.articles_count ?? 3;
  const eventsCount = hp?.events_count ?? 3;
  const showArticles = hp?.show_articles ?? true;
  const showEvents = hp?.show_events ?? true;

  // Fetch data in parallel — conditional fetches only if enabled
  const [articlesData, eventsData, mayorData, associationsData] = await Promise.all([
    showArticles ? getFeaturedArticles(articlesCount) : Promise.resolve([]),
    showEvents ? getUpcomingEvents(eventsCount) : Promise.resolve([]),
    hp?.show_mayor_word ? getMayor() : Promise.resolve(null),
    hp?.show_associations ? getPublishedAssociations(hp.associations_count ?? 6) : Promise.resolve([]),
  ]);

  featuredArticles = articlesData;
  upcomingEvents = eventsData;
  mayor = mayorData;
  associations = associationsData;
} catch (error) {
  console.error('Erreur lors de la récupération des données d\'accueil:', error);
}

// Mapping icône enum → SVG path
const ICON_PATHS: Record<string, string> = {
  document: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  identity: 'M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5zm6-10.125a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0zm1.294 6.336a6.721 6.721 0 01-3.17.789 6.721 6.721 0 01-3.168-.789 3.376 3.376 0 016.338 0z',
  folder: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
  mail: 'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75',
  alert: 'M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0',
  clock: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z',
  phone: 'M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z',
  map: 'M15 10.5a3 3 0 11-6 0 3 3 0 016 0z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z',
  calendar: 'M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5',
  users: 'M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z',
  building: 'M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21',
  heart: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z',
  info: 'M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z',
  shield: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  book: 'M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25',
  globe: 'M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418',
  tree: 'M12 3L4 14h5v7h6v-7h5L12 3z',
  star: 'M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z',
};

// Accès rapides par défaut (rétro-compatibilité)
const defaultQuickLinks: HomepageQuickLink[] = [
  { label: 'Démarches', url: '/demarches', icon: 'document' },
  { label: 'État civil', url: '/demarches#etat-civil', icon: 'identity' },
  { label: 'Documents', url: '/documents', icon: 'folder' },
  { label: 'Contact', url: '/contact', icon: 'mail' },
  { label: 'Urgences', url: '/contact', icon: 'alert' },
  { label: 'Horaires', url: '/contact', icon: 'clock' },
];

// Déterminer les données à afficher
const showQuickLinks = hp?.show_quick_links ?? true;
const showMayorWord = hp?.show_mayor_word ?? false;
const showArticles = hp?.show_articles ?? true;
const showEvents = hp?.show_events ?? true;
const showKeyFigures = hp?.show_key_figures ?? false;
const showAssociations = hp?.show_associations ?? false;
const showPartners = hp?.show_partners ?? false;

const quickLinks = (hp?.quick_links && hp.quick_links.length > 0) ? hp.quick_links : defaultQuickLinks;

// Hero data
const heroTitle = hp?.hero_title || 'Bienvenue sur le site de votre mairie';
const heroSubtitle = hp?.hero_subtitle || '';
const heroImage = hp?.hero_image || null;
const heroPrimaryLabel = hp?.hero_cta_primary_label || '';
const heroPrimaryUrl = hp?.hero_cta_primary_url || '';
const heroSecondaryLabel = hp?.hero_cta_secondary_label || '';
const heroSecondaryUrl = hp?.hero_cta_secondary_url || '';
---

<Layout
  title={hp?.hero_title || siteConfig.name}
  description={hp?.meta_description}
  image={hp?.hero_image?.url}
>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <main id="main-content" data-pagefind-body>
    <!-- Hero Section -->
    <Hero
      title={heroTitle}
      subtitle={heroSubtitle}
      image={heroImage}
      centered={false}
    >
      {(heroPrimaryLabel || heroSecondaryLabel) && (
        <div class="flex flex-wrap gap-4">
          {heroPrimaryLabel && heroPrimaryUrl && (
            <a
              href={heroPrimaryUrl}
              class:list={[
                "inline-flex items-center px-6 py-3 font-medium rounded-lg transition-colors",
                heroImage
                  ? "bg-white text-gray-900 hover:bg-white/90"
                  : "bg-on-primary text-primary hover:bg-on-primary/90"
              ]}
            >
              {heroPrimaryLabel}
            </a>
          )}
          {heroSecondaryLabel && heroSecondaryUrl && (
            <a
              href={heroSecondaryUrl}
              class:list={[
                "inline-flex items-center px-6 py-3 border-2 font-medium rounded-lg transition-colors",
                heroImage
                  ? "border-white text-white hover:bg-white/10"
                  : "border-on-primary text-on-primary hover:bg-on-primary/10"
              ]}
            >
              {heroSecondaryLabel}
            </a>
          )}
        </div>
      )}
    </Hero>

    <!-- Accès rapides -->
    {showQuickLinks && (
      <section class="relative -mt-8 z-20 pb-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
            {quickLinks.map((link) => (
              <a
                href={link.url}
                class="flex flex-col items-center gap-2 bg-white rounded-xl border border-gray-100 p-4 shadow-sm hover:shadow-md hover:border-primary/30 hover:-translate-y-0.5 transition-all text-center group"
              >
                <div class="w-10 h-10 rounded-lg bg-primary-text/10 flex items-center justify-center group-hover:bg-primary-text/20 transition-colors">
                  <svg class="w-5 h-5 text-primary-text" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d={ICON_PATHS[link.icon || 'document'] || ICON_PATHS.document} />
                  </svg>
                </div>
                <span class="text-sm font-medium text-gray-700 group-hover:text-primary-text transition-colors">{link.label}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Contenu éditorial -->
    {hp?.content && (
      <section class="py-12">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="prose prose-lg max-w-none" set:html={hp.content} />
        </div>
      </section>
    )}

    <!-- Mot du Maire -->
    {showMayorWord && hp?.mayor_word_content && (
      <Section title={hp.mayor_word_title || 'Le mot du Maire'}>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
          {mayor?.photo && (
            <div class="md:col-span-1">
              <div class="rounded-xl overflow-hidden shadow-md">
                <StrapiImage
                  image={mayor.photo}
                  alt={`${mayor.first_name} ${mayor.last_name}`}
                  width={400}
                  height={500}
                  widths={[200, 400]}
                  sizes="(max-width: 768px) 100vw, 33vw"
                  class="w-full h-auto object-cover"
                />
              </div>
              <p class="mt-3 text-center text-sm font-medium text-gray-700">
                {mayor.first_name} {mayor.last_name}
              </p>
              {mayor.delegation && (
                <p class="text-center text-sm text-gray-500">{mayor.delegation}</p>
              )}
            </div>
          )}
          <div class={mayor?.photo ? 'md:col-span-2' : 'md:col-span-3'}>
            <div class="prose prose-lg max-w-none text-gray-700" set:html={hp.mayor_word_content} />
          </div>
        </div>
      </Section>
    )}

    <!-- Articles mis en avant -->
    {showArticles && featuredArticles.length > 0 && (
      <Section title="Actualités" subtitle="Restez informés des dernières actualités et annonces de votre mairie.">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
          {featuredArticles.map((article) => (
            <article class="bg-white rounded-xl border border-gray-100 overflow-hidden hover:border-primary/30 hover:shadow-lg hover:-translate-y-0.5 transition-all">
              {article.image && (
                <div class="relative aspect-[16/9] overflow-hidden">
                  <StrapiImage
                    image={article.image}
                    alt={article.title}
                    width={400}
                    height={225}
                    widths={[320, 400, 640]}
                    sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
                    class="w-full h-full object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent" />
                  <span class={`absolute top-3 left-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                    article.category === 'emergency' ? 'bg-red-100 text-red-800' :
                    article.category === 'news' ? 'bg-blue-100 text-blue-800' :
                    article.category === 'event' ? 'bg-green-100 text-green-800' :
                    'bg-gray-100 text-gray-800'
                  }`}>
                    {article.category === 'emergency' ? 'Urgence' :
                     article.category === 'news' ? 'Actualité' :
                     article.category === 'event' ? 'Événement' :
                     'Information'}
                  </span>
                </div>
              )}

              <div class="p-5">
                <h3 class="text-lg font-bold text-gray-900 mb-2">
                  <a href={`/articles/${article.slug}`} class="hover:text-primary-text transition-colors">
                    {article.title}
                  </a>
                </h3>

                {article.publication_date && (
                  <time class="text-sm text-gray-400 block mb-3" datetime={article.publication_date}>
                    {formatDate(article.publication_date)}
                  </time>
                )}

                {article.summary && (
                  <p class="text-gray-600 text-sm line-clamp-3 mb-4">
                    {article.summary}
                  </p>
                )}

                <a
                  href={`/articles/${article.slug}`}
                  class="inline-flex items-center text-primary-text hover:text-primary-text/80 font-medium text-sm group/link"
                >
                  Lire la suite
                  <svg class="ml-1 w-4 h-4 transition-transform group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>

        <div class="text-center">
          <a
            href="/articles"
            class="inline-flex items-center px-6 py-3 text-base font-medium rounded-lg text-on-primary bg-primary hover:bg-primary/90 transition-colors"
          >
            Voir toutes les actualités
          </a>
        </div>
      </Section>
    )}

    <!-- Événements à venir -->
    {showEvents && upcomingEvents.length > 0 && (
      <Section title="Événements à venir" subtitle="Découvrez les prochains événements organisés par votre mairie." bg="gray">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
          {upcomingEvents.map((event) => {
            const eventDate = new Date(event.start_date);
            const day = eventDate.getDate();
            const month = eventDate.toLocaleDateString('fr-FR', { month: 'short' }).toUpperCase();
            return (
              <article class="bg-white rounded-xl border border-gray-100 overflow-hidden hover:border-primary/30 hover:shadow-lg hover:-translate-y-0.5 transition-all">
                <div class="flex">
                  {/* Bloc date calendrier */}
                  <div class="flex-shrink-0 w-20 bg-primary-text/5 flex flex-col items-center justify-center p-3 border-r border-gray-100">
                    <span class="text-2xl font-bold text-primary-text leading-none">{day}</span>
                    <span class="text-xs font-medium text-primary-text/70 uppercase mt-1">{month}</span>
                  </div>
                  <div class="flex-1 p-5">
                    <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium mb-2 ${
                      event.category === 'cultural' ? 'bg-purple-100 text-purple-800' :
                      event.category === 'sport' ? 'bg-green-100 text-green-800' :
                      event.category === 'meeting' ? 'bg-blue-100 text-blue-800' :
                      event.category === 'celebration' ? 'bg-yellow-100 text-yellow-800' :
                      'bg-gray-100 text-gray-800'
                    }`}>
                      {event.category === 'cultural' ? 'Culturel' :
                       event.category === 'sport' ? 'Sport' :
                       event.category === 'meeting' ? 'Réunion' :
                       event.category === 'celebration' ? 'Fête' :
                       'Atelier'}
                    </span>

                    <h3 class="text-lg font-bold text-gray-900 mb-2">
                      <a href={`/evenements/${event.slug}`} class="hover:text-primary-text transition-colors">
                        {event.title}
                      </a>
                    </h3>

                    {event.location && (
                      <div class="flex items-center gap-1.5 text-sm text-gray-500 mb-2">
                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                        </svg>
                        {event.location}
                      </div>
                    )}

                    <a
                      href={`/evenements/${event.slug}`}
                      class="inline-flex items-center text-primary-text hover:text-primary-text/80 font-medium text-sm group/link"
                    >
                      En savoir plus
                      <svg class="ml-1 w-4 h-4 transition-transform group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <div class="text-center">
          <a
            href="/evenements"
            class="inline-flex items-center px-6 py-3 text-base font-medium rounded-lg text-on-primary bg-primary hover:bg-primary/90 transition-colors"
          >
            Voir tous les événements
          </a>
        </div>
      </Section>
    )}

    <!-- Chiffres clés -->
    {showKeyFigures && hp?.key_figures && hp.key_figures.length > 0 && (
      <section class="py-12 bg-primary text-on-primary">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class={`grid grid-cols-2 md:grid-cols-${Math.min(hp.key_figures.length, 4)} gap-8 text-center`}>
            {hp.key_figures.map((figure) => (
              <div class="flex flex-col items-center gap-2">
                <svg class="w-8 h-8 text-on-primary/70" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={ICON_PATHS[figure.icon || 'users'] || ICON_PATHS.users} />
                </svg>
                <span class="text-3xl sm:text-4xl font-bold">{figure.value}</span>
                <span class="text-sm sm:text-base text-on-primary/80">{figure.label}</span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Associations -->
    {showAssociations && associations.length > 0 && (
      <Section title="Vie associative" subtitle="Découvrez les associations de votre commune." bg="gray">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
          {associations.map((asso) => (
            <div class="bg-white rounded-xl border border-gray-100 p-5 hover:shadow-md hover:border-primary/30 transition-all">
              <div class="flex items-start gap-4">
                {asso.logo && (
                  <div class="flex-shrink-0 w-12 h-12 rounded-lg overflow-hidden bg-gray-50">
                    <StrapiImage
                      image={asso.logo}
                      alt={asso.name}
                      width={48}
                      height={48}
                      class="w-full h-full object-contain"
                    />
                  </div>
                )}
                <div class="flex-1 min-w-0">
                  <h3 class="font-semibold text-gray-900 truncate">{asso.name}</h3>
                  <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium mt-1 ${
                    asso.category === 'sport' ? 'bg-green-100 text-green-800' :
                    asso.category === 'culture' ? 'bg-purple-100 text-purple-800' :
                    asso.category === 'social' ? 'bg-blue-100 text-blue-800' :
                    asso.category === 'environnement' ? 'bg-emerald-100 text-emerald-800' :
                    asso.category === 'education' ? 'bg-yellow-100 text-yellow-800' :
                    'bg-gray-100 text-gray-800'
                  }`}>
                    {asso.category === 'sport' ? 'Sport' :
                     asso.category === 'culture' ? 'Culture' :
                     asso.category === 'social' ? 'Social' :
                     asso.category === 'environnement' ? 'Environnement' :
                     asso.category === 'education' ? 'Éducation' :
                     'Autre'}
                  </span>
                  {asso.description && (
                    <p class="text-sm text-gray-600 mt-2 line-clamp-2">{asso.description}</p>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="text-center">
          <a
            href="/associations"
            class="inline-flex items-center px-6 py-3 text-base font-medium rounded-lg text-on-primary bg-primary hover:bg-primary/90 transition-colors"
          >
            Voir toutes les associations
          </a>
        </div>
      </Section>
    )}

    <!-- Partenaires -->
    {showPartners && hp?.partners && hp.partners.length > 0 && (
      <section class="py-10 bg-gray-50 border-t border-gray-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-lg font-semibold text-gray-500 text-center mb-8">Nos partenaires</h2>
          <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
            {hp.partners.map((partner) => {
              const content = partner.logo ? (
                <StrapiImage
                  image={partner.logo}
                  alt={partner.name}
                  width={160}
                  height={48}
                  class="h-12 max-w-[160px] object-contain grayscale hover:grayscale-0 transition-all opacity-60 hover:opacity-100"
                />
              ) : (
                <span class="text-sm font-medium text-gray-500 hover:text-primary-text transition-colors">{partner.name}</span>
              );
              return partner.url ? (
                <a href={partner.url} target="_blank" rel="noopener noreferrer" title={partner.name}>
                  {content}
                </a>
              ) : (
                <div title={partner.name}>
                  {content}
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- Section d'absence de contenu -->
    {featuredArticles.length === 0 && upcomingEvents.length === 0 && !hp && (
      <section class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h1 class="text-4xl font-bold text-gray-900 mb-4">
            Bienvenue sur le site de votre mairie
          </h1>
          <p class="text-xl text-gray-600 mb-8">
            Le contenu est en cours de préparation. Revenez bientôt pour découvrir toutes les actualités et services de votre commune.
          </p>
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 max-w-2xl mx-auto">
            <p class="text-blue-800">
              <strong>Information :</strong> Si vous êtes administrateur, configurez la page d'accueil dans l'onglet "Page d'accueil" de la configuration du site.
            </p>
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>
