---
/**
 * Navigation principale (`#menu`). Sur ordinateur : barre latérale sombre et collante de 280 px
 * (identité, recherche, rubriques, infos pratiques). Sur mobile : panneau plein écran ouvert par le
 * bouton « Menu » de la barre d'onglets (script partagé : Échap, focus rendu au bouton).
 * Sans JavaScript, le menu reste affiché dans la page. Les rubriques à sous-menu se déplient sur place.
 */
import type { PageContext } from '@communeo/theme-contract';
import OpeningStatus from '@communeo/ui-a11y/OpeningStatus.astro';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Search from '@lucide/astro/icons/search';
import NavIcon from './NavIcon.astro';

interface Props {
  ctx: PageContext;
}

const { site, nav, path } = Astro.props.ctx;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
const accessibility = nav.legal.find((link) => link.href === '/accessibilite');
---
<nav id="menu" class="jo-sidebar jo-on-dark" aria-label="Menu principal" tabindex="-1" data-cn-menu>
  <a href="/" class="jo-brand">
    {site.logo && (
      <img src={site.logo.src} alt="" width={site.logo.width ?? undefined} height={site.logo.height ?? undefined} class="jo-brand-logo" />
    )}
    <span class="jo-brand-name">{site.name}<span class="cn-sr-only"> – accueil</span></span>
  </a>

  <form role="search" action="/recherche" class="jo-sidebar-search">
    <label for="jo-search-q" class="cn-sr-only">Rechercher sur le site</label>
    <input id="jo-search-q" name="q" type="search" placeholder="Rechercher…" />
    <button type="submit"><Search size={18} aria-hidden="true" /><span class="cn-sr-only">Lancer la recherche</span></button>
  </form>

  <ul class="jo-nav-list">
    <li><a href="/" class="jo-nav-link" aria-current={path === '/' ? 'page' : undefined}><NavIcon href="/" />Accueil</a></li>
    {nav.main.map((item) =>
      item.kind === 'link' ? (
        <li><a href={item.href} class="jo-nav-link" aria-current={isCurrent(item.href) ? 'page' : undefined}><NavIcon href={item.href} />{item.label}</a></li>
      ) : (
        <li>
          <details class="jo-nav-group" data-cn-menu-group open={item.children.some((child) => isCurrent(child.href))}>
            <summary class:list={['jo-nav-link', { 'jo-nav-current': item.children.some((child) => isCurrent(child.href)) }]}>
              <NavIcon group={item.label} />{item.label}<ChevronDown size={18} aria-hidden="true" class="jo-nav-chevron" />
            </summary>
            <ul class="jo-subnav">
              {item.children.map((child) => <li><a href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>{child.label}</a></li>)}
            </ul>
          </details>
        </li>
      ),
    )}
  </ul>

  <div class="jo-sidebar-info">
    <OpeningStatus hours={site.contact.hours} class="jo-status" />
    {site.contact.address && <p>{site.contact.address}</p>}
    {site.contact.phone && <p><a href={site.contact.phone.href} class="jo-sidebar-phone">{site.contact.phone.label}</a></p>}
    {accessibility && <p><a href={accessibility.href} class="jo-sidebar-muted">{accessibility.label}</a></p>}
    <p class="jo-menu-hint cn-js-only">Touche Échap pour fermer le menu</p>
  </div>
</nav>
