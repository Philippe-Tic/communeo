---
/**
 * Documents officiels : un tableau dont chaque ligne est une carte (date, type en pastille, titre,
 * référence, téléchargement), filtrable dans le navigateur (recherche, type, année).
 * Sans JavaScript, tous les documents restent affichés et le formulaire est masqué.
 */
import type { DocumentVM, KeyLabel } from '@communeo/core';
import type { PageContext } from '@communeo/theme-contract';
import Download from '@lucide/astro/icons/download';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; documents: DocumentVM[]; types: KeyLabel[]; years: number[] }
const { ctx, documents, types, years } = Astro.props;
---
<Layout ctx={ctx}>
  <p class="bo-lead bo-list-intro">
    Procès-verbaux, délibérations, arrêtés et documents budgétaires publiés par la commune,
    conformément à ses obligations légales.
  </p>

  {documents.length > 0 && (
    <form class="bo-filter-form cn-js-only" data-bo-doc-filters>
      <p>
        <label for="bo-doc-q">Rechercher un document</label>
        <input id="bo-doc-q" type="search" name="q" placeholder="Mot-clé, référence…" data-bo-doc-search />
      </p>
      <p>
        <label for="bo-doc-type">Type</label>
        <select id="bo-doc-type" name="type" data-bo-doc-type>
          <option value="">Tous les types</option>
          {types.map((type) => <option value={type.key}>{type.label}</option>)}
        </select>
      </p>
      <p>
        <label for="bo-doc-year">Année</label>
        <select id="bo-doc-year" name="year" data-bo-doc-year>
          <option value="">Toutes</option>
          {years.map((year) => <option value={year}>{year}</option>)}
        </select>
      </p>
    </form>
  )}

  <p class="bo-count" role="status" data-bo-doc-count>
    {documents.length} document{documents.length > 1 ? 's' : ''} · du plus récent au plus ancien
  </p>

  {documents.length ? (
    <div class="bo-table-wrapper">
      <table class="bo-table">
        <caption class="cn-sr-only">Liste des documents officiels, du plus récent au plus ancien</caption>
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Type</th>
            <th scope="col">Titre</th>
            <th scope="col">Référence</th>
            <th scope="col">Fichier</th>
          </tr>
        </thead>
        <tbody>
          {documents.map((document) => (
            <tr data-bo-doc data-type={document.type.key} data-year={document.year} data-search={`${document.title} ${document.reference ?? ''} ${document.type.label}`.toLowerCase()}>
              <td data-label="Date">
                <time datetime={document.date.iso}>{document.date.label}</time>
                {document.sessionDate && <><br /><span class="bo-muted">séance du {document.sessionDate.label}</span></>}
              </td>
              <td data-label="Type"><span class={`bo-pill bo-pill-doc-${document.type.key}`}>{document.type.label}</span></td>
              <th scope="row"><a href={document.href}>{document.title}</a></th>
              <td data-label="Référence" class="bo-doc-reference">{document.reference}</td>
              <td data-label="Fichier">
                {document.file && (
                  <a href={document.file.href} class="bo-doc-download" download>
                    <Download size={18} aria-hidden="true" />{document.file.label}
                    <span class="cn-sr-only"> – {document.title}</span>
                  </a>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="bo-empty-inline">Aucun document publié pour le moment.</p>
  )}

  <p class="bo-empty-inline" hidden data-bo-doc-empty role="status">Aucun document ne correspond à votre recherche.</p>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-bo-doc-filters]');
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('[data-bo-doc]')];
  const count = document.querySelector<HTMLElement>('[data-bo-doc-count]');
  const empty = document.querySelector<HTMLElement>('[data-bo-doc-empty]');
  if (form && rows.length) {
    const search = form.querySelector<HTMLInputElement>('[data-bo-doc-search]')!;
    const type = form.querySelector<HTMLSelectElement>('[data-bo-doc-type]')!;
    const year = form.querySelector<HTMLSelectElement>('[data-bo-doc-year]')!;

    const apply = () => {
      const words = search.value.trim().toLowerCase();
      let visible = 0;
      for (const row of rows) {
        const match =
          (!words || (row.dataset.search ?? '').includes(words)) &&
          (!type.value || row.dataset.type === type.value) &&
          (!year.value || row.dataset.year === year.value);
        row.hidden = !match;
        if (match) visible += 1;
      }
      if (count) count.textContent = `${visible} document${visible > 1 ? 's' : ''} · du plus récent au plus ancien`;
      if (empty) empty.hidden = visible > 0;
    };

    form.addEventListener('submit', (event) => event.preventDefault());
    form.addEventListener('input', apply);
    form.addEventListener('change', apply);
  }
</script>
