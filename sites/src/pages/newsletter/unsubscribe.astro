---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getSiteConfig } from '../../utils/strapi';

const siteConfig = await getSiteConfig();
const strapiUrl = import.meta.env.STRAPI_PUBLIC_URL;
---

<Layout title="Désinscription newsletter" description="Désinscription de la newsletter">
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <main id="main-content">
    <div class="min-h-[60vh] flex items-center justify-center py-16">
      <div class="max-w-md mx-auto px-4 text-center">
        <!-- Loading state -->
        <div id="unsubscribe-loading">
          <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
            <svg class="h-8 w-8 text-gray-400 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-gray-900 mb-3">Désinscription en cours...</h1>
        </div>

        <!-- Success state -->
        <div id="unsubscribe-success" class="hidden">
          <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-green-100">
            <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-gray-900 mb-3">Désinscription confirmée</h1>
          <p class="text-gray-600 mb-6">
            Vous avez été désinscrit de la newsletter. Vous ne recevrez plus d'emails de notre part.
          </p>
          <a
            href="/"
            class="inline-flex items-center px-6 py-3 text-sm font-medium rounded-lg text-on-primary bg-primary hover:bg-primary/90 transition-colors"
          >
            Retour à l'accueil
          </a>
        </div>

        <!-- Error state -->
        <div id="unsubscribe-error" class="hidden">
          <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-red-100">
            <svg class="h-8 w-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-gray-900 mb-3">Erreur</h1>
          <p id="unsubscribe-error-message" class="text-gray-600 mb-6"></p>
          <a
            href="/"
            class="inline-flex items-center px-6 py-3 text-sm font-medium rounded-lg text-on-primary bg-primary hover:bg-primary/90 transition-colors"
          >
            Retour à l'accueil
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script define:vars={{ strapiUrl }}>
  (function() {
    const loadingDiv = document.getElementById('unsubscribe-loading');
    const successDiv = document.getElementById('unsubscribe-success');
    const errorDiv = document.getElementById('unsubscribe-error');
    const errorMessage = document.getElementById('unsubscribe-error-message');

    const params = new URLSearchParams(window.location.search);
    const token = params.get('token');

    function showError(msg) {
      loadingDiv.classList.add('hidden');
      errorMessage.textContent = msg;
      errorDiv.classList.remove('hidden');
    }

    if (!token) {
      showError('Lien de désinscription invalide.');
      return;
    }

    fetch(`${strapiUrl}/api/newsletter-subscribers/unsubscribe?token=${encodeURIComponent(token)}`)
      .then(function(response) {
        loadingDiv.classList.add('hidden');
        if (response.ok) {
          successDiv.classList.remove('hidden');
        } else {
          showError('Ce lien de désinscription est invalide ou a déjà été utilisé.');
        }
      })
      .catch(function() {
        showError('Une erreur est survenue. Veuillez réessayer plus tard.');
      });
  })();
</script>
