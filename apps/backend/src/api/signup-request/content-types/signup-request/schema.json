{
  "kind": "collectionType",
  "collectionName": "signup_requests",
  "info": {
    "singularName": "signup-request",
    "pluralName": "signup-requests",
    "displayName": "Demande d'inscription",
    "description": "Inscription d'une mairie en libre-service : adresse du demandeur à vérifier, puis approbation par la mairie depuis son adresse officielle ou par l'équipe"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": { "visible": false },
    "content-type-builder": { "visible": false }
  },
  "attributes": {
    "code_insee": { "type": "string", "required": true, "regex": "^[0-9][0-9AB][0-9]{3}$" },
    "commune_name": { "type": "string", "required": true },
    "first_name": { "type": "string", "required": true },
    "last_name": { "type": "string", "required": true },
    "email": { "type": "email", "required": true, "private": true },
    "official_email": { "type": "email", "private": true },
    "status": {
      "type": "enumeration",
      "enum": ["pending_email", "pending_townhall", "awaiting_review", "confirmed", "rejected", "pending_confirmation"],
      "required": true,
      "default": "pending_email"
    },
    "token": { "type": "string", "private": true },
    "approval_token": { "type": "string", "private": true },
    "approval_sent_at": { "type": "datetime" },
    "approval": { "type": "enumeration", "enum": ["same_email", "same_domain", "townhall", "team"] },
    "terms_accepted_at": { "type": "datetime", "required": true },
    "email_confirmed_at": { "type": "datetime" },
    "confirmed_at": { "type": "datetime" },
    "reviewed_at": { "type": "datetime" },
    "reviewed_by": { "type": "string" },
    "rejection_reason": { "type": "text", "private": true },
    "site": { "type": "relation", "relation": "oneToOne", "target": "api::site.site" }
  }
}
