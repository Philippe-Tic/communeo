---
/** Perturbations : une fiche par perturbation, sévérité portée par le libellé et le disque (i, !, !!). */
import type { AlertVM } from '@communeo/core';
import type { PageContext } from '@communeo/theme-contract';
import Empty from '../parts/Empty.astro';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; alerts: AlertVM[] }
const { ctx, alerts } = Astro.props;
const signs = { info: 'i', warning: '!', critical: '!!' } as const;
---
<Layout ctx={ctx}>
  {alerts.length ? (
    <ul class="mo-disruptions mo-disruptions-page">
      {alerts.map((alert) => (
        <li class={`mo-disruption mo-disruption-${alert.severity.key}`}>
          <span class="mo-disruption-sign" aria-hidden="true">{signs[alert.severity.key]}</span>
          <div>
            <p class="mo-disruption-kind">{alert.severity.label}{alert.type && <> · {alert.type.label}</>}</p>
            <h2 class="mo-disruption-heading">{alert.title}</h2>
            <p>{alert.message}</p>
            {(alert.period || alert.area || alert.location) && (
              <p class="mo-disruption-meta">
                {alert.period}
                {(alert.area || alert.location) && <>{alert.period && ' · '}Secteur : {alert.area ?? alert.location}</>}
              </p>
            )}
            {alert.link && (
              <p>
                <a href={alert.link.href} target={alert.link.external ? '_blank' : undefined} rel={alert.link.external ? 'noopener noreferrer' : undefined}>
                  {alert.link.label}{alert.link.external && <span class="cn-sr-only"> (nouvelle fenêtre)</span>}
                </a>
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <Empty title="Aucune perturbation en cours">Bonne nouvelle : tout est calme sur la commune.</Empty>
  )}
</Layout>
