---
/**
 * Document HTML commun à tous les thèmes : métadonnées, SEO, données structurées, lien d'évitement
 * et bandeau de consentement. Le thème rend le contenu du <body>.
 */
import type { PageContext } from '@communeo/theme-contract';
import { toSchemaOrgOpeningHours } from '@communeo/core';
import CookieBanner from '@communeo/ui-a11y/CookieBanner.astro';
import SkipLinks from '@communeo/ui-a11y/SkipLinks.astro';

interface Props {
  ctx: PageContext;
}

const { ctx } = Astro.props;
const { site, seo } = ctx;
const title = ctx.path === '/' ? site.name : `${seo.title} – ${site.name}`;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentOrganization',
  name: `Mairie de ${site.name}`,
  url: site.url,
  email: site.contact.email.label,
  ...(site.contact.phone ? { telephone: site.contact.phone.label } : {}),
  ...(site.contact.address ? { address: site.contact.address } : {}),
  ...(site.logo ? { logo: site.logo.src } : {}),
  ...(site.contact.hours ? { openingHoursSpecification: toSchemaOrgOpeningHours(site.contact.hours) } : {}),
  ...(site.social.length ? { sameAs: site.social.map((link) => link.href) } : {}),
};
const jsonLd = [organization, ...seo.jsonLd];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {seo.description && <meta name="description" content={seo.description} />}
    <link rel="canonical" href={seo.canonical} />
    {seo.noindex && <meta name="robots" content="noindex" />}
    {site.favicon ? <link rel="icon" href={site.favicon.src} /> : site.logo && <link rel="icon" href={site.logo.src} />}
    <meta property="og:type" content={ctx.path === '/' ? 'website' : 'article'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:locale" content="fr_FR" />
    {seo.description && <meta property="og:description" content={seo.description} />}
    {seo.image && <meta property="og:image" content={seo.image.src} />}
    <meta name="twitter:card" content={seo.image ? 'summary_large_image' : 'summary'} />
    <link rel="alternate" type="application/rss+xml" title={`Actualités – ${site.name}`} href="/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <script is:inline>document.documentElement.classList.add('cn-js');</script>
    <SkipLinks />
    <slot />
    <CookieBanner />
  </body>
</html>
