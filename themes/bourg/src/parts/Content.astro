---
/** Blocs d'un contenu, précédés du sommaire en pastilles quand la page est longue. */
import type { BlockVM, TocEntryVM } from '@communeo/core';
import Blocks from '@communeo/ui-a11y/Blocks.astro';
import { blocks as components } from '../blocks/index';
import Toc from './Toc.astro';

interface Props {
  blocks: BlockVM[];
  toc?: TocEntryVM[];
}

const { blocks, toc = [] } = Astro.props;
---
{toc.length >= 3 && <Toc entries={toc} />}
<div class="bo-blocks"><Blocks blocks={blocks} components={components} /></div>
