---
import theme from 'virtual:communeo/theme';
import Document from '../../../layouts/Document.astro';
import { getSource, simplePage } from '../../../lib/content';
import { upcomingEvents } from '../../../lib/events';
import { categoryFilters } from '../../../lib/lists';

export async function getStaticPaths() {
  const keys = new Set(upcomingEvents(await getSource().events()).map((e) => e.category.key));
  return [...keys].map((category) => ({ params: { category } }));
}

const source = getSource();
const upcoming = upcomingEvents(await source.events());
const filtered = upcoming.filter((e) => e.category.key === Astro.params.category);
if (!filtered.length) return Astro.rewrite('/404');
const label = filtered[0]!.category.label;
const path = `/agenda/categorie/${Astro.params.category}`;
const ctx = await simplePage(source, { path, title: `Agenda : ${label}`, trail: [{ label: 'Agenda', href: '/agenda' }, { label, href: path }] });
const { EventList } = theme.templates;
---
<Document ctx={ctx}><EventList ctx={ctx} upcoming={filtered} categories={categoryFilters(upcoming, '/agenda', Astro.params.category ?? null)} /></Document>
