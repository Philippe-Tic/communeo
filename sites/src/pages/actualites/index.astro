---
import type { Article } from '../../types/strapi';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import StrapiImage from '../../components/StrapiImage.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getArticles, formatDate } from '../../utils/strapi';

// Récupération de tous les articles
let articles: Article[] = [];

try {
  articles = await getArticles();
} catch (error) {
  console.error('Erreur lors de la récupération des articles:', error);
}

// Catégories disponibles pour le filtrage
const categories = [
  { key: 'all', label: 'Toutes les actualités' },
  { key: 'news', label: 'Actualités' },
  { key: 'information', label: 'Informations' },
  { key: 'event', label: 'Événements' },
  { key: 'emergency', label: 'Urgences' }
];

// JSON-LD BreadcrumbList
const siteOrigin = Astro.site?.toString()?.replace(/\/$/, '') || Astro.url.origin;
const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": siteOrigin },
    { "@type": "ListItem", "position": 2, "name": "Actualités" }
  ]
});

// Grouper les articles par catégorie
const articlesByCategory = articles.reduce((acc, article) => {
  const category = article.category;
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(article);
  return acc;
}, {} as Record<string, Article[]>);
---

<Layout
  title="Actualités"
  description="Toutes les actualités de votre mairie : informations municipales, événements et annonces importantes."
>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <script type="application/ld+json" set:html={breadcrumbJsonLd} />

  <main id="main-content" data-pagefind-body>
    <Breadcrumb items={[
      { label: 'Actualités' }
    ]} />

    <Hero title="Actualités" subtitle="Restez informés des dernières actualités et annonces de votre mairie" />

    <!-- Filtres de catégories -->
    <section class="py-5 bg-white border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap gap-2 justify-center">
          {categories.map((category) => (
            <button
              type="button"
              class="filter-btn px-4 py-2 rounded-lg text-sm font-medium transition-colors border border-gray-200 text-gray-600 hover:bg-primary hover:text-on-primary hover:border-primary"
              data-category={category.key}
            >
              {category.label}
              {category.key !== 'all' && articlesByCategory[category.key] && (
                <span class="ml-1 text-xs opacity-70">({articlesByCategory[category.key].length})</span>
              )}
              {category.key === 'all' && (
                <span class="ml-1 text-xs opacity-70">({articles.length})</span>
              )}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Liste des articles -->
    <Section>
        {articles.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {articles.map((article) => (
              <article
                class="relative bg-white rounded-xl border border-gray-100 overflow-hidden hover:border-primary/30 hover:shadow-lg hover:-translate-y-0.5 transition-all article-card"
                data-category={article.category}
              >
                {article.image && (
                  <div class="relative aspect-[16/9] overflow-hidden">
                    <StrapiImage
                      image={article.image}
                      alt={article.title}
                      width={400}
                      height={225}
                      widths={[320, 400, 640, 800]}
                      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                      class="w-full h-full object-cover"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent" />
                    <span class={`absolute top-3 left-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                      article.category === 'emergency' ? 'bg-red-100 text-red-800' :
                      article.category === 'news' ? 'bg-blue-100 text-blue-800' :
                      article.category === 'event' ? 'bg-green-100 text-green-800' :
                      'bg-gray-100 text-gray-800'
                    }`}>
                      {article.category === 'emergency' ? 'Urgence' :
                       article.category === 'news' ? 'Actualité' :
                       article.category === 'event' ? 'Événement' :
                       'Information'}
                    </span>
                    {article.featured && (
                      <span class="absolute top-3 right-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                        À la une
                      </span>
                    )}
                  </div>
                )}

                <div class="p-5">
                  <h2 class="text-lg font-bold text-gray-900 mb-2">
                    <a href={`/actualites/${article.slug}`} class="hover:text-primary-text transition-colors card-link">
                      {article.title}
                    </a>
                  </h2>

                  {article.publication_date && (
                    <time class="text-sm text-gray-400 block mb-3" datetime={article.publication_date}>
                      {formatDate(article.publication_date)}
                    </time>
                  )}

                  {article.summary && (
                    <p class="text-gray-600 text-sm line-clamp-3 mb-4">
                      {article.summary}
                    </p>
                  )}

                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Aucune actualité disponible</h2>
            <p class="text-gray-600">
              Les actualités seront publiées ici dès qu'elles seront disponibles.
            </p>
          </div>
        )}
    </Section>
  </main>

  <Footer />
</Layout>

<style>
  /* Styles pour les filtres actifs */
  .filter-btn.active {
    background-color: rgb(var(--color-primary));
    color: rgb(var(--color-on-primary));
    border-color: rgb(var(--color-primary));
  }

  /* Animation pour les articles filtrés */
  .article-card.hidden {
    display: none;
  }

  .article-card {
    transition: opacity 0.3s ease-in-out;
  }

  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const articleCards = document.querySelectorAll('.article-card');

    // Activer le filtre "Toutes les actualités" par défaut
    const allButton = document.querySelector('[data-category="all"]');
    if (allButton) {
      allButton.classList.add('active');
    }

    filterButtons.forEach(button => {
      button.addEventListener('click', () => {
        const category = button.getAttribute('data-category');

        // Mettre à jour les boutons actifs
        filterButtons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');

        // Filtrer les articles
        articleCards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');

          if (category === 'all' || cardCategory === category) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  });
</script>
