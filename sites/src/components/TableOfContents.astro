---
import type { TocItem } from '../utils/toc'

interface Props {
  items: TocItem[]
  title?: string
}

const { items, title = 'Sommaire' } = Astro.props

// Only show if there are 2+ headings
const show = items.length >= 2
---

{show && (
  <nav class="toc not-prose mb-8 rounded-lg border bg-gray-50 p-4" aria-label={title}>
    <p class="mb-3 text-sm font-semibold text-gray-900">{title}</p>
    <ul class="space-y-1.5 text-sm">
      {items.map((item) => (
        <li
          class:list={[
            'leading-snug',
            item.level === 3 && 'ml-4',
            item.level === 4 && 'ml-8',
          ]}
        >
          <a
            href={`#${item.id}`}
            class="text-gray-600 hover:text-gray-900 transition-colors no-underline"
          >
            {item.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
