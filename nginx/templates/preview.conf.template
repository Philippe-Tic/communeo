# Preview des brouillons (serveur SSR du renderer) : ${PREVIEW_DOMAIN}
# Certificat à créer une fois : certbot certonly --webroot -w /var/www/certbot -d ${PREVIEW_DOMAIN}
server {
    listen 443 ssl;
    http2 on;
    server_name ${PREVIEW_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${PREVIEW_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${PREVIEW_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    # Jamais indexée ni mise en cache (le serveur envoie aussi ces en-têtes)
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location / {
        proxy_pass http://preview:4321;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_no_cache 1;
        proxy_cache_bypass 1;
    }
}
