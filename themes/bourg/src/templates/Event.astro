---
/**
 * Événement : pavé de date lavande à côté du titre, catégorie en pastille, photo, contenu. Les
 * informations pratiques sont en tête de la colonne de droite sur ordinateur, sous le titre sur mobile.
 */
import type { EventVM } from '@communeo/core';
import type { PageContext } from '@communeo/theme-contract';
import Content from '../parts/Content.astro';
import EventFacts from '../parts/EventFacts.astro';
import Layout from '../parts/Layout.astro';
import { dateBadge } from '../lib/date';

interface Props { ctx: PageContext; event: EventVM }
const { ctx, event } = Astro.props;
const badge = dateBadge(event.start.iso, event.multiDay ? event.end?.iso : null);
---
<Layout ctx={ctx} heading={false}>
  <header class="bo-event-header">
    <p class="bo-date bo-date-large" aria-hidden="true">
      <span class="bo-date-day">{badge.day}</span>
      <span class="bo-date-month">{badge.month}</span>
    </p>
    <div>
      <p><span class={`bo-pill bo-pill-event`}>{event.category.label}</span></p>
      <h1>{event.title}</h1>
      <p class="bo-lead bo-event-when"><time datetime={event.start.iso}>{event.period}</time>{event.location && <> · {event.location}</>}</p>
    </div>
  </header>
  <EventFacts event={event} id="bo-facts-inline" class="bo-facts-inline" />
  {event.image && (
    <figure class="bo-cover">
      <img src={event.image.src} srcset={event.image.srcset ?? undefined} alt={event.image.alt} width={event.image.width ?? undefined} height={event.image.height ?? undefined} />
      {event.image.caption && <figcaption>{event.image.caption}</figcaption>}
    </figure>
  )}
  <Content blocks={event.blocks} />
  <EventFacts slot="aside" event={event} id="bo-facts-side" />
</Layout>
