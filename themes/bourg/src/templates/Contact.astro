---
/**
 * Contact : le formulaire dans une carte blanche (erreurs récapitulées et répétées sous les champs),
 * puis la carte OpenStreetMap après consentement et les numéros d'urgence. Les coordonnées et les
 * horaires de la mairie sont dans le panneau « Pratique ».
 */
import type { FormConfig, PageContext } from '@communeo/theme-contract';
import ConsentEmbed from '@communeo/ui-a11y/ConsentEmbed.astro';
import ApiForm from '../parts/ApiForm.astro';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; form: FormConfig }
const { ctx, form } = Astro.props;
const { contact } = ctx.site;
const where = contact.coordinates;
const mapUrl = where
  ? `https://www.openstreetmap.org/export/embed.html?bbox=${where.lng - 0.01},${where.lat - 0.006},${where.lng + 0.01},${where.lat + 0.006}&layer=mapnik&marker=${where.lat},${where.lng}`
  : null;
const osmUrl = where ? `https://www.openstreetmap.org/?mlat=${where.lat}&mlon=${where.lng}#map=16/${where.lat}/${where.lng}` : null;
---
<Layout ctx={ctx} heading={false}>
  <header class="bo-page-header">
    <h1>{ctx.title}</h1>
    <p class="bo-lead">{contact.formIntro ?? 'Une question, une démarche ? Écrivez à la mairie : un accusé de réception vous est envoyé par e-mail.'}</p>
  </header>

  <div class="bo-contact-layout">
    <section class="bo-form-card" aria-labelledby="bo-contact-form">
      <h2 id="bo-contact-form" class="bo-form-card-title">Votre demande</h2>
      <ApiForm
        form={form}
        submitLabel="Envoyer la demande"
        success="Votre message a bien été envoyé. Un accusé de réception vous sera adressé par e-mail."
        hint="Accusé de réception par e-mail."
      >
        <div class="bo-field-row">
          <p><label for="ct-first">Prénom</label><input id="ct-first" name="first_name" required autocomplete="given-name" /></p>
          <p><label for="ct-last">Nom</label><input id="ct-last" name="last_name" required autocomplete="family-name" /></p>
        </div>
        <div class="bo-field-row">
          <p><label for="ct-email">E-mail</label><input id="ct-email" name="email" type="email" required autocomplete="email" /></p>
          <p>
            <label for="ct-phone">Téléphone <span class="bo-optional">(facultatif)</span></label>
            <input id="ct-phone" name="phone" type="tel" autocomplete="tel" aria-describedby="ct-phone-aide" />
            <span id="ct-phone-aide" class="bo-field-help">Format : 02 41 00 00 00</span>
          </p>
        </div>
        <div class="bo-field-row">
          <p>
            <label for="ct-category">Catégorie</label>
            <select id="ct-category" name="category" required>
              {(form.options ?? []).map((option) => <option value={option.key}>{option.label}</option>)}
            </select>
          </p>
          <p><label for="ct-subject">Objet</label><input id="ct-subject" name="subject" required /></p>
        </div>
        <p>
          <label for="ct-message">Message</label>
          <textarea id="ct-message" name="message" rows="6" required maxlength="2000" aria-describedby="ct-message-aide"></textarea>
          <span id="ct-message-aide" class="bo-field-help">2 000 caractères maximum.</span>
        </p>
        <p>
          <input id="ct-consent" name="consent" type="checkbox" required data-bo-label="Utilisation de mes données" />
          <label for="ct-consent">
            J'accepte que mes données soient utilisées pour traiter ma demande. Elles sont conservées 12 mois.
            <a href="/donnees-personnelles">Politique de données personnelles</a>
          </label>
        </p>
      </ApiForm>
    </section>

    <div class="bo-contact-more">
      {mapUrl && osmUrl && (
        <ConsentEmbed title={`Carte : mairie de ${ctx.site.name}`} src={mapUrl} provider="OpenStreetMap" href={osmUrl} kind="map" class="bo-contact-map" />
      )}
      <section class="bo-card bo-card-peach" aria-labelledby="bo-contact-urgences">
        <h2 id="bo-contact-urgences" class="bo-home-card-title">Urgences</h2>
        <ul class="bo-emergency">
          <li>Samu <a href="tel:15">15</a></li>
          <li>Police secours <a href="tel:17">17</a></li>
          <li>Pompiers <a href="tel:18">18</a></li>
          <li>Urgence européen <a href="tel:112">112</a></li>
        </ul>
      </section>
    </div>
  </div>
</Layout>
