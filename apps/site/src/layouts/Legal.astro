---
/** Pages d'informations légales : bandeau, sommaire des cinq pages, texte */
import BandeauPage from '../components/BandeauPage.astro';
import { LEGAL } from '../lib/site';
import Base from './Base.astro';

interface Props {
  titre: string;
  description: string;
}

const { titre, description } = Astro.props;
const courant = Astro.url.pathname.replace(/\.html$/, '');
---

<Base titre={`${titre} · Communeo`} description={description}>
  <BandeauPage surtitre="Informations légales" titre={titre} seed={0.2} />
  <div class="section corps">
    <div class="disposition">
      <nav class="sommaire" aria-label="Informations légales">
        {
          LEGAL.map((item) => (
            <a href={item.href} aria-current={item.href === courant ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="texte-legal">
        <slot />
      </div>
    </div>
  </div>
</Base>

<style>
  .corps {
    padding-block: clamp(48px, 6vw, 88px);
  }

  .disposition {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(32px, 5vw, 72px);
    align-items: flex-start;
  }

  .sommaire {
    flex: 1 1 240px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  @media (min-width: 56.25em) {
    .sommaire {
      position: sticky;
      top: 24px;
      max-width: 300px;
    }
  }

  .sommaire a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 14px;
    border-radius: 10px;
    font-size: 1.0625rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .sommaire a:hover {
    background: var(--sauge);
  }

  .sommaire a[aria-current='page'] {
    background: var(--sauge);
    text-decoration: underline;
  }

  .texte-legal {
    flex: 3 1 560px;
    min-width: 0;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .texte-legal :global(h2) {
    margin: 24px 0 0;
    font: 400 clamp(1.5rem, 1.3rem + 0.8vw, 2rem) / 1.15 var(--serif);
    color: var(--sapin);
  }

  .texte-legal :global(h2:first-child) {
    margin-top: 0;
  }

  .texte-legal :global(p),
  .texte-legal :global(ul) {
    margin: 0;
  }

  .texte-legal :global(h3) {
    margin: 8px 0 0;
    font-size: 1.25rem;
    font-weight: 600;
  }

  /* Tableaux des annexes : défilement horizontal dans leur cadre plutôt que dans la page */
  .texte-legal :global(.tableau) {
    max-width: 100%;
    overflow-x: auto;
    border-radius: 4px;
  }

  .texte-legal :global(table) {
    border-collapse: collapse;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .texte-legal :global(th),
  .texte-legal :global(td) {
    padding: 10px 12px;
    border: 1px solid var(--grege);
    text-align: left;
    vertical-align: top;
    min-width: 12em;
  }

  .texte-legal :global(th) {
    background: var(--papier-clair);
  }

  .texte-legal :global(blockquote) {
    margin: 0;
    padding: 12px 18px;
    border-left: 3px solid var(--grege);
  }

  .texte-legal :global(ol),
  .texte-legal :global(ul) {
    margin: 0;
  }

  .texte-legal :global(ul) {
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
</style>
