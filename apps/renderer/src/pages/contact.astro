---
import theme from 'virtual:communeo/theme';
import Document from '../layouts/Document.astro';
import { getSource, simplePage } from '../lib/content';
import { contactForm } from '../lib/forms';

const source = getSource();
const site = await source.site();
const ctx = await simplePage(source, { path: '/contact', title: 'Contacter la mairie', description: `Coordonnées, horaires et formulaire de contact de la mairie de ${site.name}` });
const { Contact } = theme.templates;
---
<Document ctx={ctx}><Contact ctx={ctx} form={contactForm(site.id)} /></Document>
