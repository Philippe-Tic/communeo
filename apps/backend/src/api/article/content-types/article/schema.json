{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "News articles and posts"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "slug": {
      "type": "string",
      "required": true,
      "maxLength": 100,
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ],
      "required": false
    },
    "publication_date": {
      "type": "datetime",
      "default": null
    },
    "summary": {
      "type": "text",
      "maxLength": 300,
      "required": false
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.text",
        "blocks.image",
        "blocks.buttons",
        "blocks.callout",
        "blocks.documents",
        "blocks.gallery",
        "blocks.faq",
        "blocks.contact",
        "blocks.video"
      ]
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "news",
        "event",
        "information",
        "emergency"
      ],
      "default": "news",
      "required": true
    },
    "author": {
      "type": "string",
      "maxLength": 100,
      "required": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "meta_description": {
      "type": "string",
      "maxLength": 160,
      "required": false
    },
    "scheduled_at": {
      "type": "datetime"
    },
    "view_count": {
      "type": "integer",
      "default": 0
    },
    "site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site",
      "inversedBy": "articles",
      "required": true
    }
  }
}
