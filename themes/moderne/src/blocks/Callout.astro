---
/** Encadré : le type est porté par le libellé et le disque (« i », « ! », « !! », « ★ »), jamais par la seule couleur. */
import type { BlockOf } from '@communeo/core';
import RichText from '@communeo/ui-a11y/RichText.astro';

interface Props { block: BlockOf<'callout'> }
const { block } = Astro.props;
const signs: Record<string, string> = { info: 'i', warning: '!', important: '!!', tip: '★' };
---
<aside class:list={['mo-callout', `mo-callout-${block.variant}`, { 'mo-on-dark': block.variant === 'tip' }]} aria-label={block.title ?? block.variantLabel}>
  <span class="mo-callout-sign" aria-hidden="true">{signs[block.variant] ?? 'i'}</span>
  <div>
    <p class="mo-callout-label">{block.variantLabel}{block.title && block.title !== block.variantLabel && <> – {block.title}</>}</p>
    <RichText doc={block.body} class="mo-prose" />
  </div>
</aside>
