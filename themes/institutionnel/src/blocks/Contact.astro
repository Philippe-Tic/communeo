---
/** Contact ou lieu : coordonnées et, si une carte est demandée, un aperçu chargé après consentement. */
import type { BlockOf } from '@communeo/core';
import ConsentEmbed from '@communeo/ui-a11y/ConsentEmbed.astro';
import MapPin from '@lucide/astro/icons/map-pin';

interface Props { block: BlockOf<'contact'> }
const { block } = Astro.props;
const query = block.map ? encodeURIComponent(block.map.query) : null;
const mapUrl = query ? `https://www.openstreetmap.org/export/embed.html?bbox=&layer=mapnik&query=${query}` : null;
const osmUrl = query ? `https://www.openstreetmap.org/search?query=${query}` : null;
---
<section class:list={['in-contact-block', { 'in-contact-with-map': block.map }]} aria-label={block.name}>
  <div class="in-contact-info">
    <MapPin size={24} aria-hidden="true" class="in-contact-icon" />
    <div>
      <h2>{block.name}</h2>
      <address>
        {block.address && <span class="in-address">{block.address}</span>}
        {block.phone && <a href={block.phone.href}>{block.phone.label}</a>}
        {block.email && <a href={block.email.href}>{block.email.label}</a>}
      </address>
      {block.hours && <p class="in-meta">{block.hours}</p>}
      {osmUrl && (
        <p><a href={osmUrl} target="_blank" rel="noopener noreferrer">Voir sur OpenStreetMap<span class="cn-sr-only"> (nouvelle fenêtre)</span></a></p>
      )}
    </div>
  </div>
  {mapUrl && osmUrl && (
    <ConsentEmbed title={`Carte : ${block.name}`} src={mapUrl} provider="OpenStreetMap" href={osmUrl} class="in-contact-map" />
  )}
</section>
