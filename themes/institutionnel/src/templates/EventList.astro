---
/** Agenda : filtres, événements à venir groupés par mois, abonnement .ics. */
import { TIME_ZONE, type EventCardVM } from '@communeo/core';
import type { FilterOption, PageContext } from '@communeo/theme-contract';
import EventCard from '../parts/EventCard.astro';
import Filters from '../parts/Filters.astro';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; upcoming: EventCardVM[]; categories: FilterOption[] }
const { ctx, upcoming, categories } = Astro.props;

const monthLabel = (iso: string) => new Intl.DateTimeFormat('fr-FR', { timeZone: TIME_ZONE, month: 'long', year: 'numeric' }).format(new Date(iso));
const months: Array<{ label: string; events: EventCardVM[] }> = [];
for (const event of upcoming) {
  const label = monthLabel(event.start.iso);
  const last = months.at(-1);
  if (last?.label === label) last.events.push(event);
  else months.push({ label, events: [event] });
}
---
<Layout ctx={ctx}>
  <div class="in-list-head">
    <Filters label="Filtrer par catégorie" options={categories} allHref="/agenda" />
    <p class="in-meta in-count" role="status">{upcoming.length} événement{upcoming.length > 1 ? 's' : ''} à venir</p>
  </div>

  {months.map((month) => (
    <section class="in-month" aria-labelledby={`in-month-${month.label.replace(/\s/g, '-')}`}>
      <h2 id={`in-month-${month.label.replace(/\s/g, '-')}`} class="in-month-title">{month.label}</h2>
      <div class="in-stack">{month.events.map((event) => <EventCard event={event} level={3} />)}</div>
    </section>
  ))}

  {upcoming.length === 0 && <p class="in-empty">Aucun événement à venir pour le moment.</p>}
</Layout>
