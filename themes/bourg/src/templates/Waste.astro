---
/** Collecte des déchets : un encart teinté par collecte (sigle, prochaine date en grand), puis le calendrier. */
import type { WasteCollectionVM } from '@communeo/core';
import type { PageContext } from '@communeo/theme-contract';
import NextCollections from '@communeo/ui-a11y/NextCollections.astro';
import Empty from '../parts/Empty.astro';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; collections: WasteCollectionVM[]; notes: string | null }
const { ctx, collections, notes } = Astro.props;
---
<Layout ctx={ctx}>
  {notes && <p class="bo-lead bo-list-intro">{notes}</p>}
  {collections.length ? (
    <>
      <section class="bo-waste-section" aria-labelledby="bo-waste-next">
        <h2 id="bo-waste-next" class="bo-home-title">Prochaines collectes</h2>
        <ul class="bo-waste-cards">
          {collections.map((collection) => (
            <li class={`bo-waste-card bo-bin-${collection.key}`}>
              <span class="bo-waste-badge" aria-hidden="true">{collection.abbreviation}</span>
              <h3>{collection.label}</h3>
              {collection.upcoming.length > 0 ? (
                <p class="bo-waste-date"><NextCollections collection={collection} /></p>
              ) : (
                <p class="bo-waste-date">{collection.day ? 'Hors saison' : collection.frequency.label}</p>
              )}
              {collection.day
                ? <p class="bo-waste-rule">{collection.frequency.label}, le {collection.day.label}</p>
                : collection.notes && <p class="bo-waste-rule">{collection.notes}</p>}
            </li>
          ))}
        </ul>
      </section>

      <section class="bo-waste-section" aria-labelledby="bo-waste-calendar">
        <h2 id="bo-waste-calendar" class="bo-home-title">Calendrier par type</h2>
        <div class="bo-prose bo-waste-table">
          <table>
            <caption class="cn-sr-only">Jours, fréquences et zones de collecte</caption>
            <thead>
              <tr><th scope="col">Type</th><th scope="col">Jour</th><th scope="col">Fréquence</th><th scope="col">Zone</th><th scope="col">À savoir</th></tr>
            </thead>
            <tbody>
              {collections.map((collection) => (
                <tr>
                  <th scope="row">
                    <span class="bo-waste-row">
                      <span class={`bo-dot bo-bin-${collection.key}`} aria-hidden="true"></span>
                      {collection.label}
                    </span>
                  </th>
                  <td data-label="Jour">{collection.day?.label ?? '—'}</td>
                  <td data-label="Fréquence">{collection.frequency.label}</td>
                  <td data-label="Zone">{collection.zone ?? 'Toute la commune'}</td>
                  <td data-label="À savoir">{collection.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
  ) : (
    <Empty title="Calendrier bientôt publié">Le calendrier de collecte sera bientôt publié.</Empty>
  )}
</Layout>
