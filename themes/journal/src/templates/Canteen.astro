---
/**
 * Cantine : sur ordinateur, un tableau par semaine (plats en lignes, jours en colonnes, le jour même
 * sur fond bleu pâle) ; sur mobile, un jour après l'autre. Les labels (Bio, Local…) sont écrits en
 * toutes lettres. En mode fichier, l'image et le téléchargement du menu.
 */
import type { CanteenDayVM, CanteenWeekVM } from '@communeo/core';
import type { PageContext } from '@communeo/theme-contract';
import Download from '@lucide/astro/icons/download';
import Empty from '../parts/Empty.astro';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; weeks: CanteenWeekVM[] }
const { ctx, weeks } = Astro.props;
type CourseKey = CanteenDayVM['courses'][number]['key'];
const ORDER: CourseKey[] = ['starter', 'main', 'side', 'dairy', 'dessert', 'snack'];
const badges = [...new Set(weeks.flatMap((week) => week.days.flatMap((day) => day.courses.flatMap((course) => course.badges))))];
const badgeClass = (badge: string) =>
  `jo-badge-${badge.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z]+/g, '-')}`;
/** Lignes du tableau : les plats présents au moins un jour de la semaine, dans l'ordre du repas */
const rows = (week: CanteenWeekVM) =>
  ORDER.flatMap((key) => {
    const label = week.days.flatMap((day) => day.courses).find((course) => course.key === key)?.label;
    return label ? [{ key, label }] : [];
  });
const dayOf = (iso: string) => iso.slice(0, 10);
---
<Layout ctx={ctx}>
  {weeks.length === 0 && <Empty title="Menus bientôt publiés">Le menu de la cantine sera bientôt publié.</Empty>}

  {badges.length > 0 && (
    <p class="jo-legend">
      <span class="jo-legend-label">Légende</span>
      {badges.map((badge) => <span class={`jo-badge ${badgeClass(badge)}`}>{badge}</span>)}
    </p>
  )}

  {weeks.map((week) => (
    <section class="jo-week" aria-labelledby={`jo-week-${week.id}`}>
      <div class="jo-section-head">
        <h2 id={`jo-week-${week.id}`}>{week.label}</h2>
        {week.school && <span class="jo-week-school">{week.school}</span>}
      </div>

      {week.mode === 'detailed' ? (
        <>
          <div class="jo-table-wrapper jo-menu-table">
            <table class="jo-table">
              <caption class="cn-sr-only">Menu, {week.label.toLowerCase()}</caption>
              <thead>
                <tr>
                  <td></td>
                  {week.days.map((day) => (
                    <th scope="col" data-cn-day={dayOf(day.date.iso)}>
                      {day.day.label} {day.date.iso.slice(8, 10).replace(/^0/, '')}<span class="jo-today-label"> · aujourd'hui</span>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {rows(week).map((row) => (
                  <tr>
                    <th scope="row">{row.label}</th>
                    {week.days.map((day) => {
                      const course = day.courses.find((entry) => entry.key === row.key);
                      return (
                        <td data-cn-day={dayOf(day.date.iso)} class={row.key === 'main' ? 'jo-menu-main' : undefined}>
                          {course ? (
                            <>
                              {course.dish}
                              {course.badges.map((badge) => <span class={`jo-badge ${badgeClass(badge)}`}>{badge}</span>)}
                            </>
                          ) : day.closed && row.key === rows(week)[0]?.key ? 'Pas de cantine' : <span class="jo-muted">—</span>}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="jo-menu-days">
            {week.days.map((day) => (
              <article class="jo-menu-day" data-cn-day={dayOf(day.date.iso)}>
                <h3 class="jo-capitalize">{day.day.label} <time datetime={day.date.iso}>{day.date.label}</time></h3>
                {day.closed ? (
                  <p class="jo-muted">Pas de cantine ce jour.</p>
                ) : (
                  <dl class="jo-menu">
                    {day.courses.map((course) => (
                      <div>
                        <dt>{course.label}</dt>
                        <dd class={course.key === 'main' ? 'jo-menu-main' : undefined}>
                          {course.dish}{course.badges.map((badge) => <> <span class={`jo-badge ${badgeClass(badge)}`}>{badge}</span></>)}
                        </dd>
                      </div>
                    ))}
                  </dl>
                )}
              </article>
            ))}
          </div>
        </>
      ) : (
        <div class="jo-menu-file">
          {week.image && (
            <img src={week.image.src} alt={week.image.alt} width={week.image.width ?? undefined} height={week.image.height ?? undefined} loading="lazy" />
          )}
          {week.file && (
            <a href={week.file.href} class="jo-button" download>
              <Download size={20} aria-hidden="true" />Télécharger le menu ({week.file.label})
            </a>
          )}
        </div>
      )}
    </section>
  ))}
</Layout>

<script>
  import '@communeo/ui-a11y/scripts/today';
</script>
