---
/** Pagination : boutons arrondis, page courante en sarcelle, « Page 2 sur 12 ». */
import type { PaginationLinks } from '@communeo/theme-contract';

interface Props { pagination: PaginationLinks }
const { pagination } = Astro.props;
const current = pagination.pages.find((page) => page.current)?.page;
---
{pagination.pageCount > 1 && (
  <nav class="bo-pagination" aria-label="Pagination">
    <ul>
      {pagination.previous && <li><a href={pagination.previous} rel="prev" class="bo-pagination-step"><span aria-hidden="true">←</span> Précédent<span class="cn-sr-only"> : page précédente</span></a></li>}
      {pagination.pages.map((page) => (
        <li><a href={page.href} class="bo-pagination-page" aria-current={page.current ? 'page' : undefined}><span class="cn-sr-only">Page </span>{page.page}</a></li>
      ))}
      {pagination.next && <li><a href={pagination.next} rel="next" class="bo-pagination-step">Suivant <span aria-hidden="true">→</span><span class="cn-sr-only"> : page suivante</span></a></li>}
    </ul>
    {current && <p class="bo-pagination-status">Page {current} sur {pagination.pageCount}</p>}
  </nav>
)}
