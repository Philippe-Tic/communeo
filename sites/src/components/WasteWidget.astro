---
import type { WasteSchedule } from '../types/strapi';
import { getNextCollections, formatCollectionDate, WASTE_TYPE_CONFIG } from '../utils/waste-schedule';

interface Props {
  schedules: WasteSchedule[];
}

const { schedules } = Astro.props;
const nextCollections = getNextCollections(schedules, 3);
---

{nextCollections.length > 0 ? (
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    {nextCollections.map((collection) => (
      <div class={`rounded-xl border p-4 ${collection.typeInfo.color} transition-shadow hover:shadow-md`}>
        <div class="flex items-start gap-3">
          <span class="text-2xl" aria-hidden="true">{collection.typeInfo.emoji}</span>
          <div class="min-w-0 flex-1">
            <p class="font-semibold text-sm">{collection.typeInfo.label}</p>
            <p class="text-sm mt-1 capitalize">{formatCollectionDate(collection.date)}</p>
            {collection.zone && (
              <p class="text-xs mt-1 opacity-75">Zone : {collection.zone}</p>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="mt-4 text-center">
    <a
      href="/collecte-dechets"
      class="inline-flex items-center text-primary-text hover:text-primary-text/80 font-medium text-sm group/link"
    >
      Voir le planning complet
      <svg class="ml-1 w-4 h-4 transition-transform group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>
) : (
  <p class="text-gray-500 text-center py-4">Aucune collecte programmee.</p>
)}
