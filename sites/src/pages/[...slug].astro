---
import type { Page } from '../types/strapi';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import StrapiImage from '../components/StrapiImage.astro';
import { getPages, getPageBySlug, getPagePath, buildBreadcrumbs } from '../utils/strapi';
import { addHeadingIds } from '../utils/toc';
import TableOfContents from '../components/TableOfContents.astro';

export async function getStaticPaths() {
  try {
    const pages = await getPages();

    return pages
      .map(page => ({
        params: { slug: getPagePath(page, pages) },
        props: { page, allPages: pages }
      }));
  } catch (error) {
    console.error('Erreur lors de la récupération des pages:', error);
    return [];
  }
};

// Récupération de la page depuis les props ou fallback
let page: Page | null = null;
let allPages: Page[] = Astro.props.allPages ?? [];

if (Astro.props.page) {
  page = Astro.props.page;
} else {
  // Fallback pour le mode développement
  try {
    const slugParam = Astro.params.slug as string;
    const lastSegment = slugParam.split('/').pop() || slugParam;
    page = await getPageBySlug(lastSegment);
    if (page) {
      allPages = await getPages();
    }
  } catch (error) {
    console.error('Erreur lors de la récupération de la page:', error);
  }
}

// Si aucune page n'est trouvée, rediriger vers 404
if (!page) {
  return Astro.redirect('/404');
}

const attributes = page;
const { html: processedContent, toc } = addHeadingIds(attributes.content || '');
const breadcrumbs = buildBreadcrumbs(page, allPages);
const breadcrumbItems = breadcrumbs.map((crumb, i) => ({
  label: crumb.title,
  ...(i < breadcrumbs.length - 1 ? { href: crumb.path } : {})
}));
const siteOrigin = Astro.site?.toString()?.replace(/\/$/, '') || Astro.url.origin;

// JSON-LD BreadcrumbList
const breadcrumbJsonLd = breadcrumbs.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": siteOrigin },
    ...breadcrumbs.map((crumb, i) => ({
      "@type": "ListItem",
      "position": i + 2,
      "name": crumb.title,
      ...(i < breadcrumbs.length - 1 ? { "item": `${siteOrigin}${crumb.path}` } : {})
    }))
  ]
}) : null;
---

<Layout
  title={attributes.title}
  description={attributes.meta_description || `${attributes.title} - Page officielle`}
  image={attributes.featured_image?.url}
>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  {breadcrumbJsonLd && <script type="application/ld+json" set:html={breadcrumbJsonLd} />}

  <Navigation />

  <main id="main-content" data-pagefind-body>
    {breadcrumbItems.length > 0 && (
      <Breadcrumb items={breadcrumbItems} />
    )}

    <Hero title={attributes.title} subtitle={attributes.meta_description} />

    <!-- Contenu principal -->
    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto">
            {attributes.featured_image && (
              <div class="mb-8">
                <StrapiImage
                  image={attributes.featured_image}
                  alt={attributes.title}
                  width={attributes.featured_image.width || 800}
                  height={attributes.featured_image.height || 384}
                  widths={[640, 1024, 1440, 1920]}
                  sizes="100vw"
                  class="w-full h-64 md:h-96 object-cover rounded-lg shadow-lg"
                  priority
                />
              </div>
            )}

            <TableOfContents items={toc} />

            <div
              class="prose prose-lg max-w-none"
              set:html={processedContent}
            >
            </div>

            {attributes.template === 'services' && (
              <div class="mt-12 bg-blue-50 border border-blue-200 rounded-lg p-6">
                <h2 class="text-2xl font-bold text-blue-900 mb-4">Besoin d'aide ?</h2>
                <p class="text-blue-800 mb-4">
                  Nos équipes sont à votre disposition pour vous accompagner dans vos démarches.
                </p>
                <a
                  href="/contact"
                  class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 transition-colors"
                >
                  Nous contacter
                </a>
              </div>
            )}

            {attributes.template === 'about' && (
              <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-gray-50 rounded-lg p-6 text-center">
                  <div class="text-3xl font-bold text-primary-text mb-2">1234</div>
                  <div class="text-gray-600">Habitants</div>
                </div>
                <div class="bg-gray-50 rounded-lg p-6 text-center">
                  <div class="text-3xl font-bold text-primary-text mb-2">15</div>
                  <div class="text-gray-600">Services publics</div>
                </div>
                <div class="bg-gray-50 rounded-lg p-6 text-center">
                  <div class="text-3xl font-bold text-primary-text mb-2">50+</div>
                  <div class="text-gray-600">Événements par an</div>
                </div>
              </div>
            )}
          </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<!-- Prose styles imported globally via Layout -->
