---
import theme from 'virtual:communeo/theme';
import Document from '../../layouts/Document.astro';
import { getSource, simplePage } from '../../lib/content';
import { associationForm } from '../../lib/forms';

const source = getSource();
const site = await source.site();
const ctx = await simplePage(source, {
  path: '/associations/proposer',
  title: 'Proposer une association',
  trail: [{ label: 'Associations', href: '/associations' }, { label: 'Proposer une association', href: '/associations/proposer' }],
});
const { AssociationProposal } = theme.templates;
---
<Document ctx={ctx}><AssociationProposal ctx={ctx} form={associationForm(site.id)} /></Document>
