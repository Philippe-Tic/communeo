---
import type { Association } from '../../types/strapi';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import StrapiImage from '../../components/StrapiImage.astro';
import { getAssociations } from '../../utils/strapi';
import { slugifyUnique } from '../../utils/slugify';

let associations: Association[] = [];

try {
  associations = await getAssociations();
} catch (error) {
  console.error('Erreur lors de la récupération des associations:', error);
}

const CATEGORY_LABELS: Record<string, string> = {
  sport: 'Sport',
  culture: 'Culture',
  social: 'Social',
  environnement: 'Environnement',
  education: 'Éducation',
  autre: 'Autre',
};

const CATEGORY_COLORS: Record<string, string> = {
  sport: 'bg-blue-100 text-blue-800',
  culture: 'bg-purple-100 text-purple-800',
  social: 'bg-pink-100 text-pink-800',
  environnement: 'bg-green-100 text-green-800',
  education: 'bg-yellow-100 text-yellow-800',
  autre: 'bg-gray-100 text-gray-800',
};

// Générer les slugs (même ordre que getStaticPaths de [slug].astro)
const slugsByDocumentId = new Map<string, string>();
const usedSlugs = new Set<string>();
for (const a of associations) {
  slugsByDocumentId.set(a.documentId, slugifyUnique(a.name, usedSlugs));
}

// Extraire les catégories présentes
const categories = [...new Set(associations.map(a => a.category))].sort();
---

<Layout
  title="Annuaire des associations"
  description="Découvrez les associations de votre commune : sport, culture, social, environnement et plus encore."
>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <main id="main-content" data-pagefind-body>
    <Breadcrumb items={[{ label: 'Associations' }]} />

    <!-- Header -->
    <header class="bg-gradient-to-br from-primary to-primary/80 text-on-primary py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4">
            Annuaire des associations
          </h1>
          <p class="text-lg sm:text-xl text-on-primary/80 max-w-3xl mx-auto mb-6">
            Découvrez les associations qui animent la vie de votre commune
          </p>
          <a
            href="/associations/proposer"
            class="inline-flex items-center justify-center rounded-lg bg-white text-primary-text px-6 py-3 text-sm font-medium hover:bg-white/90 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-primary transition-colors"
          >
            Proposer une association
          </a>
        </div>
      </div>
    </header>

    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {associations.length > 0 ? (
          <>
            {/* Filtres par catégorie */}
            {categories.length > 1 && (
              <div class="mb-8 flex flex-wrap gap-2 justify-center">
                <button
                  data-filter="all"
                  class="filter-btn active rounded-full px-4 py-2 text-sm font-medium transition-colors bg-primary text-on-primary"
                >
                  Toutes
                </button>
                {categories.map((cat) => (
                  <button
                    data-filter={cat}
                    class="filter-btn rounded-full px-4 py-2 text-sm font-medium transition-colors bg-gray-100 text-gray-700 hover:bg-gray-200"
                  >
                    {CATEGORY_LABELS[cat] || cat}
                  </button>
                ))}
              </div>
            )}

            {/* Grille des associations */}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="associations-grid">
              {associations.map((association) => (
                <article
                  class="association-card bg-white rounded-xl border border-gray-100 overflow-hidden hover:border-primary/30 hover:shadow-lg transition-all"
                  data-category={association.category}
                >
                  {association.logo && (
                    <div class="h-40 bg-gray-50 flex items-center justify-center p-4">
                      <StrapiImage
                        image={association.logo}
                        alt={`Logo ${association.name}`}
                        width={200}
                        height={150}
                        widths={[200, 300]}
                        sizes="(max-width: 640px) 50vw, 200px"
                        class="max-h-full max-w-full object-contain"
                      />
                    </div>
                  )}

                  <div class="p-6">
                    <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium mb-3 ${
                      CATEGORY_COLORS[association.category] || 'bg-gray-100 text-gray-800'
                    }`}>
                      {CATEGORY_LABELS[association.category] || association.category}
                    </span>

                    <h2 class="text-xl font-semibold text-gray-900 mb-2">
                      <a href={`/associations/${slugsByDocumentId.get(association.documentId)}`} class="hover:text-primary-text transition-colors">
                        {association.name}
                      </a>
                    </h2>

                    {association.description && (
                      <p class="text-gray-600 text-sm leading-relaxed mb-4 line-clamp-3">
                        {association.description}
                      </p>
                    )}

                    <div class="space-y-2 text-sm text-gray-500">
                      {association.contact_name && (
                        <p class="flex items-center gap-2">
                          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                          </svg>
                          {association.contact_name}
                        </p>
                      )}
                      {association.contact_email && (
                        <p class="flex items-center gap-2">
                          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                          </svg>
                          <a href={`mailto:${association.contact_email}`} class="text-primary-text hover:underline truncate">
                            {association.contact_email}
                          </a>
                        </p>
                      )}
                      {association.contact_phone && (
                        <p class="flex items-center gap-2">
                          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                          </svg>
                          <a href={`tel:${association.contact_phone.replace(/\s/g, '')}`} class="hover:text-primary-text transition-colors">
                            {association.contact_phone}
                          </a>
                        </p>
                      )}
                      {association.website && (
                        <p class="flex items-center gap-2">
                          <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                          </svg>
                          <a href={association.website} target="_blank" rel="noopener noreferrer" class="text-primary-text hover:underline truncate">
                            {association.website.replace(/^https?:\/\//, '')}
                          </a>
                        </p>
                      )}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </>
        ) : (
          <div class="text-center py-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Aucune association référencée</h2>
            <p class="text-gray-600 mb-6">
              L'annuaire des associations sera alimenté prochainement.
            </p>
            <a
              href="/associations/proposer"
              class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-sm font-medium text-on-primary hover:bg-primary/90 transition-colors"
            >
              Proposer une association
            </a>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.association-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active button
        filterButtons.forEach(b => {
          b.classList.remove('active', 'bg-primary', 'text-on-primary');
          b.classList.add('bg-gray-100', 'text-gray-700');
        });
        btn.classList.add('active', 'bg-primary', 'text-on-primary');
        btn.classList.remove('bg-gray-100', 'text-gray-700');

        // Filter cards
        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            (card as HTMLElement).style.display = '';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  });
</script>
