---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getSiteConfig } from '../utils/strapi';
import { getOpeningHoursEntries } from '../utils/opening-hours';

const siteConfig = await getSiteConfig();
const strapiUrl = import.meta.env.STRAPI_PUBLIC_URL;
const siteDocumentId = import.meta.env.SITE_DOCUMENT_ID;

const openingHours = getOpeningHoursEntries(siteConfig.infos_pratiques?.opening_hours);
const introText = siteConfig.infos_pratiques?.contact_form_intro || 'Vous pouvez nous contacter en utilisant le formulaire ci-dessous. Nous nous engageons à traiter votre demande dans les meilleurs délais.';
---

<Layout title="Contact" description={`Contactez la ${siteConfig.name}`}>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <main id="main-content">
    <Breadcrumb items={[{ label: 'Contact' }]} />

    <header class="bg-gradient-to-br from-primary to-primary/80 text-on-primary py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4">Contact</h1>
          <p class="text-lg sm:text-xl text-on-primary/80 max-w-3xl mx-auto">
            {introText}
          </p>
        </div>
      </div>
    </header>

    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Formulaire de contact SVE -->
          <div>
            <div id="contact-form-container">
              <form id="contact-form" class="space-y-5" novalidate>
                <!-- Honeypot anti-spam -->
                <div class="absolute -left-[9999px]" aria-hidden="true">
                  <label for="website">Ne pas remplir</label>
                  <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
                </div>

                <input type="hidden" name="site" value={siteDocumentId} />

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="first_name" class="block text-sm font-medium text-gray-700 mb-1">Prénom <span class="text-red-500">*</span></label>
                    <input type="text" id="first_name" name="first_name" required maxlength="100"
                      class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                  </div>
                  <div>
                    <label for="last_name" class="block text-sm font-medium text-gray-700 mb-1">Nom <span class="text-red-500">*</span></label>
                    <input type="text" id="last_name" name="last_name" required maxlength="100"
                      class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email <span class="text-red-500">*</span></label>
                    <input type="email" id="email" name="email" required
                      class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                  </div>
                  <div>
                    <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Téléphone</label>
                    <input type="tel" id="phone" name="phone" maxlength="20"
                      class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                  </div>
                </div>

                <div>
                  <label for="category" class="block text-sm font-medium text-gray-700 mb-1">Catégorie <span class="text-red-500">*</span></label>
                  <select id="category" name="category" required
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
                    <option value="general">Demande générale</option>
                    <option value="urbanisme">Urbanisme</option>
                    <option value="etat-civil">État civil</option>
                    <option value="voirie">Voirie</option>
                    <option value="associations">Associations</option>
                    <option value="rgpd">RGPD</option>
                    <option value="autre">Autre</option>
                  </select>
                </div>

                <div>
                  <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Objet <span class="text-red-500">*</span></label>
                  <input type="text" id="subject" name="subject" required maxlength="200"
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                </div>

                <div>
                  <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message <span class="text-red-500">*</span></label>
                  <textarea id="message" name="message" required rows="6"
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"></textarea>
                </div>

                <div class="flex items-start gap-2">
                  <input type="checkbox" id="rgpd_consent" name="rgpd_consent" required
                    class="mt-1 h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary" />
                  <label for="rgpd_consent" class="text-sm text-gray-600">
                    J'accepte que mes données soient traitées conformément à la <a href="/politique-confidentialite" class="text-primary-text underline hover:text-primary-text/80">politique de confidentialité</a>. <span class="text-red-500">*</span>
                  </label>
                </div>

                <div id="form-error" class="hidden rounded-md bg-red-50 border border-red-200 p-4 text-sm text-red-700"></div>

                <button type="submit" id="submit-btn"
                  class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-sm font-medium text-on-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                  Envoyer ma demande
                </button>
              </form>
            </div>

            <!-- Message de confirmation (caché par défaut) -->
            <div id="contact-success" class="hidden rounded-md bg-green-50 border border-green-200 p-6">
              <div class="flex items-start gap-3">
                <svg class="h-6 w-6 text-green-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <h3 class="text-lg font-semibold text-green-800">Demande enregistrée</h3>
                  <p class="mt-1 text-green-700">
                    Votre demande a bien été enregistrée sous la référence <strong id="reference-number"></strong>.
                  </p>
                  <p class="mt-2 text-sm text-green-600">
                    Conformément à la réglementation SVE, nous nous engageons à accuser réception de votre demande et à la traiter dans les meilleurs délais.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Coordonnées de la mairie -->
          <div class="bg-gray-50 rounded-xl border border-gray-100 p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Nos coordonnées</h2>

            <div class="space-y-4">
              {(siteConfig.name || siteConfig.address) && (
                <div class="flex items-start space-x-3">
                  <svg class="w-6 h-6 text-primary-text mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <div>
                    <h3 class="font-semibold text-gray-900">Adresse</h3>
                    <p class="text-gray-600">
                      {siteConfig.name && <>{siteConfig.name}<br /></>}
                      {siteConfig.address}
                    </p>
                  </div>
                </div>
              )}

              {siteConfig.contact_phone && (
                <div class="flex items-start space-x-3">
                  <svg class="w-6 h-6 text-primary-text mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                  </svg>
                  <div>
                    <h3 class="font-semibold text-gray-900">Téléphone</h3>
                    <p class="text-gray-600">
                      <a href={`tel:${siteConfig.contact_phone.replace(/\s/g, '')}`} class="hover:text-primary-text transition-colors">
                        {siteConfig.contact_phone}
                      </a>
                    </p>
                  </div>
                </div>
              )}

              {siteConfig.contact_mail && (
                <div class="flex items-start space-x-3">
                  <svg class="w-6 h-6 text-primary-text mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                  </svg>
                  <div>
                    <h3 class="font-semibold text-gray-900">Email</h3>
                    <p class="text-gray-600">
                      <a href={`mailto:${siteConfig.contact_mail}`} class="hover:text-primary-text transition-colors">
                        {siteConfig.contact_mail}
                      </a>
                    </p>
                  </div>
                </div>
              )}

              {openingHours.length > 0 && (
                <div class="flex items-start space-x-3">
                  <svg class="w-6 h-6 text-primary-text mt-1 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  <div>
                    <h3 class="font-semibold text-gray-900">Horaires d'ouverture</h3>
                    <div class="text-gray-600">
                      {openingHours.map((entry) => (
                        <p>{entry.day} : {entry.hours}</p>
                      ))}
                    </div>
                  </div>
                </div>
              )}
            </div>

            <div class="mt-8 pt-6 border-t border-gray-200">
              <p class="text-sm text-gray-500">
                Conformément au <strong>Code des relations entre le public et l'administration (CRPA)</strong>,
                cette mairie met à votre disposition ce formulaire de saisine par voie électronique (SVE).
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .prose h2 {
    color: rgb(var(--color-primary));
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .prose h2:first-child {
    margin-top: 0;
  }

  .prose a {
    color: rgb(var(--color-primary-text));
    text-decoration: underline;
  }

  .prose a:hover {
    color: rgb(var(--color-primary-text));
  }

  .prose p {
    margin-bottom: 1em;
    line-height: 1.7;
  }
</style>

<script define:vars={{ strapiUrl }}>
  (function() {
    const form = document.getElementById('contact-form');
    if (!form) return;

    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      const errorDiv = document.getElementById('form-error');
      const submitBtn = document.getElementById('submit-btn');
      const successDiv = document.getElementById('contact-success');
      const formContainer = document.getElementById('contact-form-container');

      // Honeypot check
      const honeypot = document.getElementById('website');
      if (honeypot && honeypot.value) {
        formContainer.classList.add('hidden');
        successDiv.classList.remove('hidden');
        document.getElementById('reference-number').textContent = 'SVE-0000-0000';
        return;
      }

      // Validate RGPD consent
      const rgpdConsent = document.getElementById('rgpd_consent');
      if (!rgpdConsent.checked) {
        errorDiv.textContent = 'Vous devez accepter la politique de confidentialité pour envoyer votre demande.';
        errorDiv.classList.remove('hidden');
        return;
      }

      // Collect form data
      const formData = new FormData(form);
      const data = {
        first_name: formData.get('first_name'),
        last_name: formData.get('last_name'),
        email: formData.get('email'),
        phone: formData.get('phone') || undefined,
        category: formData.get('category'),
        subject: formData.get('subject'),
        message: formData.get('message'),
        site: formData.get('site'),
      };

      // Client-side validation
      if (!data.first_name || !data.last_name || !data.email || !data.subject || !data.message) {
        errorDiv.textContent = 'Veuillez remplir tous les champs obligatoires.';
        errorDiv.classList.remove('hidden');
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(data.email)) {
        errorDiv.textContent = 'Veuillez saisir une adresse email valide.';
        errorDiv.classList.remove('hidden');
        return;
      }

      // Submit
      errorDiv.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi en cours...';

      try {
        const response = await fetch(`${strapiUrl}/api/contact-submissions/public`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ data }),
        });

        if (!response.ok) {
          const err = await response.json().catch(() => null);
          throw new Error(err?.error?.message || 'Une erreur est survenue lors de l\'envoi.');
        }

        const result = await response.json();

        // Show success
        formContainer.classList.add('hidden');
        successDiv.classList.remove('hidden');
        document.getElementById('reference-number').textContent = result.data.reference_number;
      } catch (err) {
        errorDiv.textContent = err.message || 'Une erreur est survenue. Veuillez réessayer.';
        errorDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Envoyer ma demande';
      }
    });
  })();
</script>
