---
import type { TeamMember } from '../../types/strapi';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import StrapiImage from '../../components/StrapiImage.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getTeamMembers, getStrapiImageUrl } from '../../utils/strapi';
import { slugifyUnique } from '../../utils/slugify';

const ROLE_LABELS: Record<string, string> = {
  maire: 'Maire',
  adjoint: 'Adjoint(e)',
  conseiller: 'Conseiller(e) municipal(e)',
  dgs: 'Directeur Général des Services',
  agent: 'Agent municipal',
};

const ROLE_COLORS: Record<string, string> = {
  maire: 'bg-purple-100 text-purple-800',
  adjoint: 'bg-blue-100 text-blue-800',
  conseiller: 'bg-green-100 text-green-800',
  dgs: 'bg-orange-100 text-orange-800',
  agent: 'bg-gray-100 text-gray-800',
};

export async function getStaticPaths() {
  try {
    const members = await getTeamMembers();
    const usedSlugs = new Set<string>();

    return members.map(member => ({
      params: { slug: slugifyUnique(`${member.first_name} ${member.last_name}`, usedSlugs) },
      props: { member }
    }));
  } catch (error) {
    console.error('Erreur lors de la récupération des membres:', error);
    return [];
  }
}

// Récupération depuis les props ou fallback dev
let member: TeamMember | null = null;

if (Astro.props.member) {
  member = Astro.props.member;
} else {
  // Fallback pour le mode développement
  try {
    const slug = Astro.params.slug as string;
    const all = await getTeamMembers();
    const devSlugs = new Set<string>();
    const slugMap = new Map<string, TeamMember>();
    for (const m of all) {
      slugMap.set(slugifyUnique(`${m.first_name} ${m.last_name}`, devSlugs), m);
    }
    member = slugMap.get(slug) ?? null;
  } catch (error) {
    console.error('Erreur lors de la récupération du membre:', error);
  }
}

if (!member) {
  return Astro.redirect('/404');
}

const fullName = `${member.first_name} ${member.last_name}`;
const siteOrigin = Astro.site?.toString()?.replace(/\/$/, '') || Astro.url.origin;

// JSON-LD BreadcrumbList
const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": siteOrigin },
    { "@type": "ListItem", "position": 2, "name": "Équipe municipale", "item": `${siteOrigin}/equipe-municipale` },
    { "@type": "ListItem", "position": 3, "name": fullName }
  ]
});

// JSON-LD Person
const personJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": fullName,
  "jobTitle": ROLE_LABELS[member.role] || member.role,
  ...(member.photo ? { "image": getStrapiImageUrl(member.photo.url) } : {})
});
---

<Layout
  title={`${fullName} - Équipe municipale`}
  description={member.delegation || `${fullName}, ${ROLE_LABELS[member.role] || member.role} de votre commune`}
  image={member.photo?.url}
>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={breadcrumbJsonLd} />
  <script type="application/ld+json" set:html={personJsonLd} />

  <main id="main-content" data-pagefind-body>
    <Breadcrumb items={[
      { label: 'Équipe municipale', href: '/equipe-municipale' },
      { label: fullName }
    ]} />

    <article class="py-12">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row items-start gap-8">
          <!-- Photo -->
          {member.photo && (
            <div class="w-48 sm:w-56 shrink-0">
              <div class="aspect-[3/4] rounded-xl overflow-hidden border border-gray-100">
                <StrapiImage
                  image={member.photo}
                  alt={fullName}
                  width={400}
                  height={533}
                  widths={[200, 400]}
                  sizes="(max-width: 640px) 192px, 224px"
                  class="w-full h-full object-cover"
                  priority
                />
              </div>
            </div>
          )}

          <!-- Infos -->
          <div class="flex-1">
            <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium mb-3 ${
              ROLE_COLORS[member.role] || 'bg-gray-100 text-gray-800'
            }`}>
              {ROLE_LABELS[member.role] || member.role}
            </span>

            <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-2">
              {fullName}
            </h1>

            {member.delegation && (
              <p class="text-lg text-primary-text font-medium mb-6">
                {member.delegation}
              </p>
            )}

            {member.bio && (
              <div class="prose prose-lg max-w-none">
                <p>{member.bio}</p>
              </div>
            )}
          </div>
        </div>

        <!-- Lien retour -->
        <div class="mt-10">
          <a
            href="/equipe-municipale"
            class="inline-flex items-center gap-2 text-sm font-medium text-primary-text hover:underline"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Retour à l'équipe municipale
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
