# Exemple de configuration pour un site municipal
# Copiez ce fichier vers .env et ajustez les valeurs

# Document ID du site dans Strapi (UUID obtenu depuis l'admin ou l'API)
SITE_DOCUMENT_ID=s3at6egkmkikx4jd6w6smoar

# Slug utilisé pour l'URL du site (ex: lyon.monservice.fr)
SITE_SLUG=rouen

# URL de votre instance Strapi
STRAPI_URL=http://localhost:1337

# Token d'authentification Strapi (optionnel en développement)
# STRAPI_TOKEN=your-strapi-token-here

# Pour obtenir le SITE_DOCUMENT_ID :
# 1. Connectez-vous à l'admin Strapi (http://localhost:1337/admin)
# 2. Allez dans "Sites" et éditez un site
# 3. L'URL contient le documentId : /admin/content-manager/collection-types/api::site.site/{documentId}
# 4. Ou utilisez l'API : curl "http://localhost:1337/api/sites"
