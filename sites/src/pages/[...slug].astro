---
import type { Page } from '../types/strapi';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getPages, getPageBySlug, getStrapiImageUrl, getPagePath, buildBreadcrumbs } from '../utils/strapi';

export async function getStaticPaths() {
  try {
    const pages = await getPages();

    return pages
      .filter(page => !page.is_homepage) // Exclure la page d'accueil
      .map(page => ({
        params: { slug: getPagePath(page, pages) },
        props: { page, allPages: pages }
      }));
  } catch (error) {
    console.error('Erreur lors de la récupération des pages:', error);
    return [];
  }
};

// Récupération de la page depuis les props ou fallback
let page: Page | null = null;
let allPages: Page[] = Astro.props.allPages ?? [];

if (Astro.props.page) {
  page = Astro.props.page;
} else {
  // Fallback pour le mode développement
  try {
    const slugParam = Astro.params.slug as string;
    const lastSegment = slugParam.split('/').pop() || slugParam;
    page = await getPageBySlug(lastSegment);
    if (page) {
      allPages = await getPages();
    }
  } catch (error) {
    console.error('Erreur lors de la récupération de la page:', error);
  }
}

// Si aucune page n'est trouvée, rediriger vers 404
if (!page) {
  return Astro.redirect('/404');
}

const attributes = page;
const breadcrumbs = buildBreadcrumbs(page, allPages);
---

<Layout
  title={attributes.title}
  description={attributes.meta_description || `${attributes.title} - Page officielle`}
  image={attributes.featured_image?.data?.url}
>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <main id="main-content">
    {breadcrumbs.length > 0 && (
      <nav aria-label="Fil d'Ariane" class="bg-gray-50 border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
          <ol class="flex items-center gap-2 text-sm text-gray-600">
            <li><a href="/" class="hover:text-primary transition-colors">Accueil</a></li>
            {breadcrumbs.map((crumb, i) => (
              <>
                <li aria-hidden="true">/</li>
                {i < breadcrumbs.length - 1
                  ? <li><a href={crumb.path} class="hover:text-primary transition-colors">{crumb.title}</a></li>
                  : <li aria-current="page" class="font-medium text-gray-900">{crumb.title}</li>
                }
              </>
            ))}
          </ol>
        </div>
      </nav>
    )}

    <!-- Header de la page -->
    <header class="bg-gradient-to-br from-primary/10 to-secondary/10 py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl font-bold text-gray-900 mb-4">
            {attributes.title}
          </h1>

          {attributes.meta_description && (
            <p class="text-xl text-gray-600 max-w-3xl mx-auto">
              {attributes.meta_description}
            </p>
          )}
        </div>
      </div>
    </header>

    <!-- Contenu principal -->
    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto">
            {attributes.featured_image?.data && (
              <div class="mb-8">
                <img
                  src={getStrapiImageUrl(attributes.featured_image.data.url)}
                  alt={attributes.featured_image.data.alternativeText || attributes.title}
                  class="w-full h-64 md:h-96 object-cover rounded-lg shadow-lg"
                  fetchpriority="high"
                  decoding="async"
                  width={attributes.featured_image.data.width || 800}
                  height={attributes.featured_image.data.height || 384}
                />
              </div>
            )}

            <div
              class="prose prose-lg max-w-none"
              set:html={attributes.content}
            >
            </div>

            {attributes.template === 'services' && (
              <div class="mt-12 bg-blue-50 border border-blue-200 rounded-lg p-6">
                <h2 class="text-2xl font-bold text-blue-900 mb-4">Besoin d'aide ?</h2>
                <p class="text-blue-800 mb-4">
                  Nos équipes sont à votre disposition pour vous accompagner dans vos démarches.
                </p>
                <a
                  href="/contact"
                  class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 transition-colors"
                >
                  Nous contacter
                </a>
              </div>
            )}

            {attributes.template === 'about' && (
              <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-gray-50 rounded-lg p-6 text-center">
                  <div class="text-3xl font-bold text-primary mb-2">1234</div>
                  <div class="text-gray-600">Habitants</div>
                </div>
                <div class="bg-gray-50 rounded-lg p-6 text-center">
                  <div class="text-3xl font-bold text-primary mb-2">15</div>
                  <div class="text-gray-600">Services publics</div>
                </div>
                <div class="bg-gray-50 rounded-lg p-6 text-center">
                  <div class="text-3xl font-bold text-primary mb-2">50+</div>
                  <div class="text-gray-600">Événements par an</div>
                </div>
              </div>
            )}
          </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Styles pour le contenu riche */
  .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
    color: rgb(var(--color-primary));
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .prose h1:first-child,
  .prose h2:first-child,
  .prose h3:first-child {
    margin-top: 0;
  }

  .prose a {
    color: rgb(var(--color-secondary));
    text-decoration: underline;
  }

  .prose a:hover {
    color: rgb(var(--color-primary));
  }

  .prose p {
    margin-bottom: 1em;
    line-height: 1.7;
  }

  .prose ul, .prose ol {
    margin: 1em 0;
    padding-left: 1.5em;
  }

  .prose li {
    margin-bottom: 0.5em;
  }

  .prose blockquote {
    border-left: 4px solid rgb(var(--color-secondary));
    padding-left: 1em;
    margin: 1.5em 0;
    font-style: italic;
    color: #6b7280;
  }

  .prose img {
    border-radius: 0.5rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    margin: 1.5em auto;
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
  }

  .prose th,
  .prose td {
    border: 1px solid #e5e7eb;
    padding: 0.75em;
    text-align: left;
  }

  .prose th {
    background-color: #f9fafb;
    font-weight: bold;
  }
</style>
