---
import type { Association } from '../../types/strapi';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import StrapiImage from '../../components/StrapiImage.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getAssociations, getStrapiImageUrl } from '../../utils/strapi';
import { slugifyUnique } from '../../utils/slugify';

const CATEGORY_LABELS: Record<string, string> = {
  sport: 'Sport',
  culture: 'Culture',
  social: 'Social',
  environnement: 'Environnement',
  education: 'Éducation',
  autre: 'Autre',
};

const CATEGORY_COLORS: Record<string, string> = {
  sport: 'bg-blue-100 text-blue-800',
  culture: 'bg-purple-100 text-purple-800',
  social: 'bg-pink-100 text-pink-800',
  environnement: 'bg-green-100 text-green-800',
  education: 'bg-yellow-100 text-yellow-800',
  autre: 'bg-gray-100 text-gray-800',
};

export async function getStaticPaths() {
  try {
    const associations = await getAssociations();
    const usedSlugs = new Set<string>();

    return associations.map(association => ({
      params: { slug: slugifyUnique(association.name, usedSlugs) },
      props: { association }
    }));
  } catch (error) {
    console.error('Erreur lors de la récupération des associations:', error);
    return [];
  }
}

// Récupération depuis les props ou fallback dev
let association: Association | null = null;

if (Astro.props.association) {
  association = Astro.props.association;
} else {
  // Fallback pour le mode développement
  try {
    const slug = Astro.params.slug as string;
    const all = await getAssociations();
    const devSlugs = new Set<string>();
    const slugMap = new Map<string, Association>();
    for (const a of all) {
      slugMap.set(slugifyUnique(a.name, devSlugs), a);
    }
    association = slugMap.get(slug) ?? null;
  } catch (error) {
    console.error('Erreur lors de la récupération de l\'association:', error);
  }
}

if (!association) {
  return Astro.redirect('/404');
}

const siteOrigin = Astro.site?.toString()?.replace(/\/$/, '') || Astro.url.origin;

// JSON-LD BreadcrumbList
const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": siteOrigin },
    { "@type": "ListItem", "position": 2, "name": "Associations", "item": `${siteOrigin}/associations` },
    { "@type": "ListItem", "position": 3, "name": association.name }
  ]
});

// JSON-LD Organization
const organizationJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": association.name,
  ...(association.description ? { "description": association.description } : {}),
  ...(association.contact_email ? { "email": association.contact_email } : {}),
  ...(association.contact_phone ? { "telephone": association.contact_phone } : {}),
  ...(association.website ? { "url": association.website } : {}),
  ...(association.address ? { "address": { "@type": "PostalAddress", "streetAddress": association.address } } : {}),
  ...(association.logo ? { "logo": getStrapiImageUrl(association.logo.url) } : {})
});
---

<Layout
  title={association.name}
  description={association.description || `${association.name} - Association de votre commune`}
  image={association.logo?.url}
>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={breadcrumbJsonLd} />
  <script type="application/ld+json" set:html={organizationJsonLd} />

  <main id="main-content" data-pagefind-body>
    <Breadcrumb items={[
      { label: 'Associations', href: '/associations' },
      { label: association.name }
    ]} />

    <article class="py-12">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header -->
        <header class="mb-10">
          <div class="flex flex-col sm:flex-row items-start gap-6">
            {association.logo && (
              <div class="w-32 h-32 bg-gray-50 rounded-xl flex items-center justify-center p-3 border border-gray-100 shrink-0">
                <StrapiImage
                  image={association.logo}
                  alt={`Logo ${association.name}`}
                  width={300}
                  height={300}
                  widths={[150, 300]}
                  sizes="128px"
                  class="max-h-full max-w-full object-contain"
                />
              </div>
            )}

            <div>
              <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium mb-3 ${
                CATEGORY_COLORS[association.category] || 'bg-gray-100 text-gray-800'
              }`}>
                {CATEGORY_LABELS[association.category] || association.category}
              </span>

              <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">
                {association.name}
              </h1>
            </div>
          </div>
        </header>

        <!-- Description -->
        {association.description && (
          <div class="prose prose-lg max-w-none mb-10">
            <p>{association.description}</p>
          </div>
        )}

        <!-- Carte contact -->
        <div class="bg-gray-50 rounded-xl border border-gray-100 p-6 sm:p-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Coordonnées</h2>

          <div class="space-y-3 text-sm text-gray-600">
            {association.contact_name && (
              <p class="flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <span>{association.contact_name}</span>
              </p>
            )}
            {association.contact_email && (
              <p class="flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <a href={`mailto:${association.contact_email}`} class="text-primary-text hover:underline">
                  {association.contact_email}
                </a>
              </p>
            )}
            {association.contact_phone && (
              <p class="flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <a href={`tel:${association.contact_phone.replace(/\s/g, '')}`} class="hover:text-primary-text transition-colors">
                  {association.contact_phone}
                </a>
              </p>
            )}
            {association.website && (
              <p class="flex items-center gap-3">
                <svg class="w-5 h-5 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                </svg>
                <a href={association.website} target="_blank" rel="noopener noreferrer" class="text-primary-text hover:underline">
                  {association.website.replace(/^https?:\/\//, '')}
                </a>
              </p>
            )}
            {association.address && (
              <p class="flex items-start gap-3">
                <svg class="w-5 h-5 shrink-0 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>{association.address}</span>
              </p>
            )}

            {!association.contact_name && !association.contact_email && !association.contact_phone && !association.website && !association.address && (
              <p class="text-gray-400 italic">Aucune coordonnée renseignée pour le moment.</p>
            )}
          </div>
        </div>

        <!-- Lien retour -->
        <div class="mt-10">
          <a
            href="/associations"
            class="inline-flex items-center gap-2 text-sm font-medium text-primary-text hover:underline"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
            Retour à l'annuaire des associations
          </a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>
