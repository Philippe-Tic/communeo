---
import type { Event } from '../../types/strapi';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import { getEvents, getEventBySlug, getStrapiImageUrl, formatDate } from '../../utils/strapi';

export async function getStaticPaths() {
  try {
    const events = await getEvents();

    return events.map(event => ({
      params: { slug: event.slug },
      props: { event }
    }));
  } catch (error) {
    console.error('Erreur lors de la récupération des événements:', error);
    return [];
  }
}

// Récupération de l'événement depuis les props ou fallback
let event: Event | null = null;

if (Astro.props.event) {
  event = Astro.props.event;
} else {
  // Fallback pour le mode développement
  try {
    const slug = Astro.params.slug as string;
    event = await getEventBySlug(slug);
  } catch (error) {
    console.error('Erreur lors de la récupération de l\'événement:', error);
  }
}

// Si aucun événement n'est trouvé, rediriger vers 404
if (!event) {
  return Astro.redirect('/404');
}

const attributes = event;
---

<Layout
  title={attributes.title}
  description={attributes.description || `${attributes.title} - Événement de votre mairie`}
  image={attributes.image?.data?.url}
>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <main id="main-content">
    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-200 py-4" aria-label="Fil d'ariane">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ol class="flex items-center space-x-2 text-sm">
          <li>
            <a href="/" class="text-gray-500 hover:text-primary transition-colors">Accueil</a>
          </li>
          <li class="text-gray-500">/</li>
          <li>
            <a href="/evenements" class="text-gray-500 hover:text-primary transition-colors">Événements</a>
          </li>
          <li class="text-gray-500">/</li>
          <li class="text-gray-900 font-medium" aria-current="page">
            {attributes.title}
          </li>
        </ol>
      </div>
    </nav>

    <!-- Événement principal -->
    <article class="py-12">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header de l'événement -->
        <header class="mb-8">
          <div class="flex items-center space-x-3 mb-4">
            <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${
              attributes.category === 'cultural' ? 'bg-purple-100 text-purple-800' :
              attributes.category === 'sport' ? 'bg-green-100 text-green-800' :
              attributes.category === 'meeting' ? 'bg-blue-100 text-blue-800' :
              attributes.category === 'celebration' ? 'bg-yellow-100 text-yellow-800' :
              'bg-gray-100 text-gray-800'
            }`}>
              {attributes.category === 'cultural' ? 'Culturel' :
               attributes.category === 'sport' ? 'Sport' :
               attributes.category === 'meeting' ? 'Réunion' :
               attributes.category === 'celebration' ? 'Fête' :
               'Atelier'}
            </span>

            <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${
              attributes.status === 'published' ? 'bg-blue-100 text-blue-800' :
              attributes.status === 'draft' ? 'bg-green-100 text-green-800' :
              attributes.status === 'archived' ? 'bg-gray-100 text-gray-800' :
              'bg-red-100 text-red-800'
            }`}>
              {attributes.status === 'published' ? 'Publié' :
               attributes.status === 'draft' ? 'Brouillon' :
               'Annulé'}
            </span>
          </div>

          <h1 class="text-4xl font-bold text-gray-900 mb-6">
            {attributes.title}
          </h1>

          <!-- Informations pratiques -->
          <div class="bg-gray-50 rounded-lg p-6 mb-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Informations pratiques</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <div>
                  <p class="font-medium text-gray-900">Date</p>
                  <time datetime={attributes.start_date}>
                    {formatDate(attributes.start_date)}
                  </time>
                  {attributes.end_date && attributes.end_date !== attributes.start_date && (
                    <span> - {formatDate(attributes.end_date)}</span>
                  )}
                </div>
              </div>

              {attributes.location && (
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <div>
                    <p class="font-medium text-gray-900">Lieu</p>
                    <p>{attributes.location}</p>
                  </div>
                </div>
              )}

              {attributes.price && (
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                  </svg>
                  <div>
                    <p class="font-medium text-gray-900">Tarif</p>
                    <p>{attributes.price}</p>
                  </div>
                </div>
              )}

              {attributes.registration_required && (
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  <div>
                    <p class="font-medium text-gray-900">Inscription</p>
                    <p>Inscription obligatoire</p>
                  </div>
                </div>
              )}
            </div>
          </div>
        </header>

        <!-- Image principale -->
        {attributes.image?.data && (
          <div class="mb-8">
            <img
              src={getStrapiImageUrl(attributes.image.data.url)}
              alt={attributes.image.data.alternativeText || attributes.title}
              class="w-full h-64 md:h-96 object-cover rounded-lg shadow-lg"
            />
          </div>
        )}

        <!-- Description de l'événement -->
        <div
          class="prose prose-lg max-w-none"
          set:html={attributes.description}
        >
        </div>
      </div>
    </article>
  </main>

  <!-- Footer simple -->
  <footer class="bg-gray-900 text-white py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <p class="text-gray-400">
          © 2025 Site officiel de votre mairie. Tous droits réservés.
        </p>
      </div>
    </div>
  </footer>
</Layout>

<style>
  /* Styles pour le contenu riche */
  .prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
    color: rgb(var(--color-primary));
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .prose h1:first-child,
  .prose h2:first-child,
  .prose h3:first-child {
    margin-top: 0;
  }

  .prose a {
    color: rgb(var(--color-secondary));
    text-decoration: underline;
  }

  .prose a:hover {
    color: rgb(var(--color-primary));
  }

  .prose p {
    margin-bottom: 1em;
    line-height: 1.7;
  }

  .prose ul, .prose ol {
    margin: 1em 0;
    padding-left: 1.5em;
  }

  .prose li {
    margin-bottom: 0.5em;
  }

  .prose blockquote {
    border-left: 4px solid rgb(var(--color-secondary));
    padding-left: 1em;
    margin: 1.5em 0;
    font-style: italic;
    color: #6b7280;
  }

  .prose img {
    border-radius: 0.5rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    margin: 1.5em auto;
  }
</style>
