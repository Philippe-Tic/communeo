---
import type { Page, Site, NavigationItem, SectionKey } from '../types/strapi';
import { getMenuPages, getSiteConfig, getPagePath } from '../utils/strapi';
import { SECTION_MAP } from '../utils/navigation';
import StrapiImage from './StrapiImage.astro';

// Récupération des pages du menu et de la configuration du site
let menuPages: Page[] = [];
let siteConfig: Site | null = null;

try {
  [menuPages, siteConfig] = await Promise.all([
    getMenuPages(),
    getSiteConfig()
  ]);
} catch (error) {
  console.error('Erreur lors de la récupération des données de navigation:', error);
}

// URL actuelle pour la navigation active
const currentPath = Astro.url.pathname;

// Un lien est actif si le path courant correspond ou est un sous-path
const isActive = (pagePath: string) =>
  currentPath === pagePath || currentPath.startsWith(pagePath + '/');

// --- Types pour le menu unifié ---
interface NavMenuLink {
  href: string;
  label: string;
  children?: NavMenuLink[];
}

// --- Build menu links from navigation_config or fallback ---
const navConfig = siteConfig?.navigation_config;

function buildConfiguredMenu(config: NavigationItem[]): NavMenuLink[] {
  const links: NavMenuLink[] = [];

  for (const item of config) {
    if (!item.enabled) continue;

    if (item.type === 'section' && item.key) {
      const meta = SECTION_MAP[item.key];
      if (!meta) continue;
      // Skip open-data if not enabled and no custom label override
      if (item.key === 'open-data' && !siteConfig?.open_data_enabled && !item.label) continue;
      links.push({
        href: meta.url,
        label: item.label || meta.defaultLabel,
      });
    } else if (item.type === 'page' && item.pageDocumentId) {
      const page = menuPages.find(p => p.documentId === item.pageDocumentId);
      if (!page) continue; // Page supprimée ou non publiée → ignorer
      const pagePath = '/' + getPagePath(page, menuPages);
      const children = menuPages
        .filter(p => p.parent_page?.documentId === page.documentId)
        .map(child => ({
          href: '/' + getPagePath(child, menuPages),
          label: child.title,
        }));
      links.push({
        href: pagePath,
        label: item.label || page.title,
        children: children.length > 0 ? children : undefined,
      });
    }
  }

  return links;
}

function buildFallbackMenu(): NavMenuLink[] {
  const links: NavMenuLink[] = [];

  // Pages dynamiques (show_in_menu + menu_order)
  const rootPages = menuPages.filter(p => !p.parent_page);
  for (const page of rootPages) {
    const pagePath = '/' + getPagePath(page, menuPages);
    const children = menuPages
      .filter(p => p.parent_page?.documentId === page.documentId)
      .map(child => ({
        href: '/' + getPagePath(child, menuPages),
        label: child.title,
      }));
    links.push({
      href: pagePath,
      label: page.title,
      children: children.length > 0 ? children : undefined,
    });
  }

  // Sections hardcodées
  links.push({ href: '/articles', label: 'Actualités' });
  links.push({ href: '/evenements', label: 'Événements' });
  links.push({ href: '/documents', label: 'Documents' });
  links.push({ href: '/equipe-municipale', label: 'Équipe' });
  links.push({ href: '/associations', label: 'Associations' });
  links.push({ href: '/demarches', label: 'Démarches' });

  if (siteConfig?.open_data_enabled) {
    links.push({ href: '/open-data', label: 'Open Data' });
  }

  return links;
}

const menuLinks: NavMenuLink[] =
  navConfig && navConfig.length > 0
    ? buildConfiguredMenu(navConfig)
    : buildFallbackMenu();
---

<!-- TopBar -->
<div class="hidden md:block bg-primary text-white text-xs" role="complementary" aria-label="Informations de contact">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-1.5">
      <div class="flex items-center gap-6">
        {siteConfig?.contact_phone && (
          <a href={`tel:${siteConfig.contact_phone.replace(/\s/g, '')}`} class="flex items-center gap-1.5 hover:text-white/80 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {siteConfig.contact_phone}
          </a>
        )}
        {siteConfig?.contact_mail && (
          <a href={`mailto:${siteConfig.contact_mail}`} class="flex items-center gap-1.5 hover:text-white/80 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {siteConfig.contact_mail}
          </a>
        )}
      </div>
      <div class="flex items-center gap-6">
        {siteConfig?.infos_pratiques?.opening_hours && (
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Horaires d'ouverture
          </span>
        )}
        <a href="/contact" class="hover:text-white/80 transition-colors">Contact</a>
      </div>
    </div>
  </div>
</div>

<!-- NavBar principale -->
<nav class="nav-main sticky top-0 z-50 bg-white/80 backdrop-blur-lg border-b border-gray-200/50 transition-shadow duration-300" role="navigation" aria-label="Navigation principale">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo et nom de la mairie -->
      <div class="flex items-center">
        <a href="/" class="flex items-center space-x-3 text-gray-900 hover:text-primary transition-colors">
          {siteConfig?.logo && (
            <StrapiImage
              image={siteConfig.logo}
              alt={`Logo ${siteConfig.name}`}
              width={40}
              height={40}
              class="h-10 w-auto"
              priority
            />
          )}
          <span class="font-bold text-lg">{siteConfig?.name}</span>
        </a>
      </div>

      <!-- Navigation desktop -->
      <div class="hidden lg:block">
        <div class="flex items-center space-x-1">
          <a
            href="/"
            class={`px-3 py-2 text-sm font-medium transition-colors border-b-2 ${
              currentPath === '/'
                ? 'border-primary text-primary'
                : 'border-transparent text-gray-700 hover:text-primary hover:border-primary/30'
            }`}
            aria-current={currentPath === '/' ? 'page' : undefined}
          >
            Accueil
          </a>

          {menuLinks.map((link) => {
            const active = isActive(link.href);
            return link.children && link.children.length > 0 ? (
              <div class="relative group">
                <a
                  href={link.href}
                  class={`inline-flex items-center gap-1 px-3 py-2 text-sm font-medium transition-colors border-b-2 ${
                    active
                      ? 'border-primary text-primary'
                      : 'border-transparent text-gray-700 hover:text-primary hover:border-primary/30'
                  }`}
                  aria-current={active ? 'page' : undefined}
                >
                  {link.label}
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>
                <div class="absolute left-0 top-full hidden group-hover:block group-focus-within:block min-w-48 z-50 pt-1">
                  <div class="bg-white/95 backdrop-blur-md rounded-lg shadow-xl border border-gray-100 p-2">
                    {link.children.map((child) => {
                      const childActive = currentPath === child.href;
                      return (
                        <a
                          href={child.href}
                          class={`block px-3 py-2 text-sm rounded-md transition-colors ${
                            childActive
                              ? 'bg-primary/10 text-primary font-medium'
                              : 'text-gray-700 hover:bg-gray-50 hover:text-primary'
                          }`}
                          aria-current={childActive ? 'page' : undefined}
                        >
                          {child.label}
                        </a>
                      );
                    })}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={link.href}
                class={`px-3 py-2 text-sm font-medium transition-colors border-b-2 ${
                  active
                    ? 'border-primary text-primary'
                    : 'border-transparent text-gray-700 hover:text-primary hover:border-primary/30'
                }`}
                aria-current={active ? 'page' : undefined}
              >
                {link.label}
              </a>
            );
          })}

          <a
            href="/recherche"
            class={`px-2 py-2 text-sm font-medium transition-colors border-b-2 ${
              currentPath.startsWith('/recherche')
                ? 'border-primary text-primary'
                : 'border-transparent text-gray-700 hover:text-primary hover:border-primary/30'
            }`}
            aria-label="Rechercher"
            aria-current={currentPath.startsWith('/recherche') ? 'page' : undefined}
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Bouton hamburger pour mobile -->
      <div class="lg:hidden">
        <button
          type="button"
          class="inline-flex items-center justify-center p-2 rounded-lg text-gray-600 hover:text-primary hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-primary transition-colors"
          aria-controls="mobile-menu"
          aria-expanded="false"
          id="mobile-menu-button"
        >
          <span class="sr-only">Ouvrir le menu principal</span>
          <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menu mobile -->
  <div class="lg:hidden hidden" id="mobile-menu" role="menu" aria-orientation="vertical" aria-labelledby="mobile-menu-button">
    <div class="px-4 pt-2 pb-4 space-y-1 bg-white border-t border-gray-100">
      {/* Contact info mobile */}
      <div class="flex flex-wrap gap-3 text-xs text-gray-500 pb-3 mb-2 border-b border-gray-100">
        {siteConfig?.contact_phone && (
          <a href={`tel:${siteConfig.contact_phone.replace(/\s/g, '')}`} class="flex items-center gap-1 hover:text-primary">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {siteConfig.contact_phone}
          </a>
        )}
        {siteConfig?.contact_mail && (
          <a href={`mailto:${siteConfig.contact_mail}`} class="flex items-center gap-1 hover:text-primary">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {siteConfig.contact_mail}
          </a>
        )}
      </div>

      <a
        href="/"
        class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
          currentPath === '/'
            ? 'bg-primary/10 text-primary'
            : 'text-gray-900 hover:bg-gray-50 hover:text-primary'
        }`}
        role="menuitem"
      >
        Accueil
      </a>

      {menuLinks.map((link) => {
        const active = isActive(link.href);
        const hasChildren = link.children && link.children.length > 0;
        const childActive = hasChildren && link.children!.some(child => currentPath === child.href);
        return hasChildren ? (
          <div class="mobile-submenu-group">
            <div class="flex items-center">
              <a
                href={link.href}
                class={`flex-1 block px-3 py-2.5 rounded-l-lg text-base font-medium transition-colors ${
                  active || childActive
                    ? 'bg-primary/10 text-primary'
                    : 'text-gray-900 hover:bg-gray-50 hover:text-primary'
                }`}
                role="menuitem"
              >
                {link.label}
              </a>
              <button
                type="button"
                class={`mobile-submenu-toggle px-3 py-2.5 rounded-r-lg text-base transition-colors ${
                  active || childActive
                    ? 'bg-primary/10 text-primary'
                    : 'text-gray-500 hover:bg-gray-50 hover:text-primary'
                }`}
                aria-expanded={childActive ? 'true' : 'false'}
                aria-label={`Sous-pages de ${link.label}`}
              >
                <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            </div>
            <div class={`mobile-submenu pl-4 space-y-0.5 overflow-hidden transition-all ${childActive ? '' : 'hidden'}`}>
              {link.children!.map((child) => {
                const isChildActive = currentPath === child.href;
                return (
                  <a
                    href={child.href}
                    class={`block pl-4 pr-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                      isChildActive
                        ? 'bg-primary/10 text-primary'
                        : 'text-gray-600 hover:bg-gray-50 hover:text-primary'
                    }`}
                    role="menuitem"
                  >
                    {child.label}
                  </a>
                );
              })}
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
              active
                ? 'bg-primary/10 text-primary'
                : 'text-gray-900 hover:bg-gray-50 hover:text-primary'
            }`}
            role="menuitem"
          >
            {link.label}
          </a>
        );
      })}

      <a
        href="/recherche"
        class={`flex items-center gap-2 px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
          currentPath.startsWith('/recherche')
            ? 'bg-primary/10 text-primary'
            : 'text-gray-900 hover:bg-gray-50 hover:text-primary'
        }`}
        role="menuitem"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Rechercher
      </a>
    </div>
  </div>
</nav>

<!-- Script pour le menu mobile + scroll shadow -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Scroll shadow effect on navbar
    const navMain = document.querySelector('.nav-main');
    if (navMain) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 10) {
          navMain.classList.add('shadow-sm');
        } else {
          navMain.classList.remove('shadow-sm');
        }
      }, { passive: true });
    }

    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', () => {
        const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';

        // Toggle du menu
        mobileMenu.classList.toggle('hidden');
        mobileMenuButton.setAttribute('aria-expanded', (!isExpanded).toString());

        // Changement de l'icône (hamburger <-> X)
        const icon = mobileMenuButton.querySelector('svg');
        if (icon) {
          if (isExpanded) {
            // Icône hamburger
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
          } else {
            // Icône X
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />';
          }
        }
      });

      // Fermer le menu quand on clique sur un lien (mobile)
      const mobileLinks = mobileMenu.querySelectorAll('a');
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          mobileMenuButton.setAttribute('aria-expanded', 'false');
          const icon = mobileMenuButton.querySelector('svg');
          if (icon) {
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
          }
        });
      });
    }

    // Mobile sub-menu toggles
    const toggleButtons = document.querySelectorAll('.mobile-submenu-toggle');
    toggleButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const group = btn.closest('.mobile-submenu-group');
        if (!group) return;
        const submenu = group.querySelector('.mobile-submenu');
        const chevron = btn.querySelector('svg');
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        if (submenu) {
          submenu.classList.toggle('hidden');
        }
        if (chevron) {
          chevron.style.transform = isExpanded ? '' : 'rotate(180deg)';
        }
        btn.setAttribute('aria-expanded', (!isExpanded).toString());
      });
    });
  });
</script>
