{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    // Les types de Remotion importent « react » sans en dépendre : sans ce chemin, ils prennent les types
    // remontés par pnpm, React 18 (Strapi) ou 19 selon l'installation. Toujours ceux de ce paquet.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    }
  },
  "include": ["src", "scripts", "remotion.config.ts"]
}
