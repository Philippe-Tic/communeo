{
  "kind": "collectionType",
  "collectionName": "pending_changes",
  "info": {
    "singularName": "pending-change",
    "pluralName": "pending-changes",
    "displayName": "Modification en attente",
    "description": "Modifications visibles sur le site public, en attente de la prochaine mise en ligne réussie"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": { "visible": false },
    "content-type-builder": { "visible": false }
  },
  "attributes": {
    "site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site",
      "required": true
    },
    "content_type": {
      "type": "string",
      "required": true
    },
    "content_document_id": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string"
    },
    "action": {
      "type": "enumeration",
      "enum": ["publish", "unpublish", "delete", "create", "update"],
      "required": true
    },
    "source": {
      "type": "enumeration",
      "enum": ["person", "scheduled"],
      "default": "person",
      "required": true
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "occurred_at": {
      "type": "datetime",
      "required": true
    }
  }
}
