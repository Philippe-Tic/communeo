---
import type { Event } from '../../types/strapi';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import StrapiImage from '../../components/StrapiImage.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getEvents, getEventBySlug, getStrapiImageUrl, getSiteConfig, formatDate } from '../../utils/strapi';

export async function getStaticPaths() {
  try {
    const events = await getEvents();

    return events.map(event => ({
      params: { slug: event.slug },
      props: { event }
    }));
  } catch (error) {
    console.error('Erreur lors de la récupération des événements:', error);
    return [];
  }
}

// Récupération de l'événement depuis les props ou fallback
let event: Event | null = null;

if (Astro.props.event) {
  event = Astro.props.event;
} else {
  // Fallback pour le mode développement
  try {
    const slug = Astro.params.slug as string;
    event = await getEventBySlug(slug);
  } catch (error) {
    console.error('Erreur lors de la récupération de l\'événement:', error);
  }
}

// Si aucun événement n'est trouvé, rediriger vers 404
if (!event) {
  return Astro.redirect('/404');
}

const attributes = event;

// Récupération de la config site pour JSON-LD organizer
let siteConfig: import('../../types/strapi').Site | null = null;
try {
  siteConfig = await getSiteConfig();
} catch (error) {
  console.error('Erreur lors de la récupération de la configuration du site:', error);
}

const siteOrigin = Astro.site?.toString()?.replace(/\/$/, '') || Astro.url.origin;

// JSON-LD BreadcrumbList
const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": siteOrigin },
    { "@type": "ListItem", "position": 2, "name": "Événements", "item": `${siteOrigin}/evenements` },
    { "@type": "ListItem", "position": 3, "name": attributes.title }
  ]
});

// JSON-LD Event
const eventJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Event",
  "name": attributes.title,
  "startDate": attributes.start_date,
  ...(attributes.end_date ? { "endDate": attributes.end_date } : {}),
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  ...(attributes.description ? { "description": attributes.description.substring(0, 300) } : {}),
  ...(attributes.image ? { "image": getStrapiImageUrl(attributes.image.url) } : {}),
  ...(attributes.location ? { "location": { "@type": "Place", "name": attributes.location, ...(attributes.address ? { "address": attributes.address } : {}) } } : {}),
  ...(siteConfig ? { "organizer": { "@type": "Organization", "name": siteConfig.name, ...(siteConfig.contact_mail ? { "email": siteConfig.contact_mail } : {}) } } : {})
});
---

<Layout
  title={attributes.title}
  description={attributes.description || `${attributes.title} - Événement de votre mairie`}
  image={attributes.image?.url}
>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <!-- JSON-LD Breadcrumb + Event -->
  <script type="application/ld+json" set:html={breadcrumbJsonLd} />
  <script type="application/ld+json" set:html={eventJsonLd} />

  <main id="main-content" data-pagefind-body>
    <Breadcrumb items={[
      { label: 'Événements', href: '/evenements' },
      { label: attributes.title }
    ]} />

    <!-- Événement principal -->
    <article class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Header de l'événement -->
        <header class="mb-8">
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${
              attributes.category === 'cultural' ? 'bg-purple-100 text-purple-800' :
              attributes.category === 'sport' ? 'bg-green-100 text-green-800' :
              attributes.category === 'meeting' ? 'bg-blue-100 text-blue-800' :
              attributes.category === 'celebration' ? 'bg-yellow-100 text-yellow-800' :
              'bg-gray-100 text-gray-800'
            }`}>
              {attributes.category === 'cultural' ? 'Culturel' :
               attributes.category === 'sport' ? 'Sport' :
               attributes.category === 'meeting' ? 'Réunion' :
               attributes.category === 'celebration' ? 'Fête' :
               'Atelier'}
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">
            {attributes.title}
          </h1>

          <!-- Informations pratiques -->
          <div class="bg-gray-50 rounded-xl border border-gray-100 p-6 mb-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Informations pratiques</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-primary-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
                <div>
                  <p class="font-medium text-gray-900">Date</p>
                  <time datetime={attributes.start_date}>
                    {formatDate(attributes.start_date)}
                  </time>
                  {attributes.end_date && attributes.end_date !== attributes.start_date && (
                    <span> - {formatDate(attributes.end_date)}</span>
                  )}
                </div>
              </div>

              {attributes.location && (
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-primary-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <div>
                    <p class="font-medium text-gray-900">Lieu</p>
                    <p>{attributes.location}</p>
                  </div>
                </div>
              )}

              {attributes.price && (
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-primary-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
                  </svg>
                  <div>
                    <p class="font-medium text-gray-900">Tarif</p>
                    <p>{attributes.price}</p>
                  </div>
                </div>
              )}

              {attributes.registration_required && (
                <div class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-primary-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                  <div>
                    <p class="font-medium text-gray-900">Inscription</p>
                    <p>Inscription obligatoire</p>
                  </div>
                </div>
              )}
            </div>
          </div>
        </header>

        <!-- Image principale -->
        {attributes.image && (
          <div class="mb-8">
            <StrapiImage
              image={attributes.image}
              alt={attributes.title}
              width={attributes.image.width || 800}
              height={attributes.image.height || 384}
              widths={[640, 1024, 1440, 1920]}
              sizes="100vw"
              class="w-full h-64 md:h-96 object-cover rounded-lg shadow-lg"
              priority
            />
          </div>
        )}

        <!-- Description de l'événement -->
        <div
          class="prose prose-lg max-w-none"
          set:html={attributes.description}
        >
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<!-- Prose styles imported globally via Layout -->
