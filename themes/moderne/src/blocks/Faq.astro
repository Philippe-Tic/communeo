---
import type { BlockOf } from '@communeo/core';
import RichText from '@communeo/ui-a11y/RichText.astro';

interface Props { block: BlockOf<'faq'> }
const { block } = Astro.props;
---
<section class="st-faq" aria-label={block.title ?? 'Questions fréquentes'}>
  {block.title && <h2>{block.title}</h2>}
  {block.items.map((item) => (
    <details id={item.id}>
      <summary>{item.question}</summary>
      <RichText doc={item.answer} />
    </details>
  ))}
</section>
