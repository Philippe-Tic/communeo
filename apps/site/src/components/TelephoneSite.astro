---
/**
 * Le site de démonstration de Saint-Aubin-sur-Loire sur un téléphone : de vraies captures du site
 * (thème Institutionnel, 390 px de large, vraies photos, mairie « Ouverte » un mardi à 10 h), prises par
 * `pnpm --filter @communeo/site captures:themes` dans src/assets/telephone/.
 *
 * `vue` : `accueil` (haut de l'accueil, une alerte), `mairie` (horaires, météo, collectes) ou `alerte`
 * (l'accueil sans alerte, puis avec : le bandeau apparaît quand un parent prend la classe
 * `alerte-visible`).
 */
import { Image } from 'astro:assets';
import accueil from '../assets/telephone/accueil.png';
import mairie from '../assets/telephone/mairie.png';
import sansAlerte from '../assets/telephone/sans-alerte.png';

interface Props {
  vue: 'accueil' | 'mairie' | 'alerte';
  /** Ce que montre l'écran (le téléphone est une image pour les lecteurs d'écran) */
  alt: string;
  class?: string;
}

const { vue, alt, class: classe } = Astro.props;
const image = { widths: [262, 524], sizes: '262px', format: 'webp' as const, quality: 82 };
---

<div class:list={['appareil', classe]} role="img" aria-label={alt}>
  <div class="ecran">
    <div class="statut" aria-hidden="true">
      <span>9:41</span>
      <span class="ilot"></span>
      <span class="reseau"><span></span><span></span><span></span></span>
    </div>
    <div class="contenu">
      {
        vue === 'alerte' ? (
          <>
            <Image src={sansAlerte} alt="" class="vue" {...image} />
            <Image src={accueil} alt="" class="vue apres" {...image} />
          </>
        ) : (
          <Image src={vue === 'mairie' ? mairie : accueil} alt="" class="vue" loading="eager" {...image} />
        )
      }
    </div>
  </div>
</div>

<style>
  .appareil {
    width: 280px;
    height: 580px;
    padding: 9px;
    border-radius: 42px;
    background: var(--encre);
    box-shadow:
      0 30px 60px -30px rgba(14, 64, 51, 0.45),
      0 2px 6px rgba(28, 27, 24, 0.18);
  }

  .ecran {
    width: 100%;
    height: 100%;
    border-radius: 33px;
    background: var(--blanc);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .statut {
    flex: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 22px 6px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--encre);
  }

  .ilot {
    width: 74px;
    height: 20px;
    border-radius: 12px;
    background: var(--encre);
  }

  .reseau {
    display: flex;
    gap: 3px;
    align-items: flex-end;
  }

  .reseau span {
    width: 3px;
    border-radius: 1px;
    background: var(--encre);
  }

  .reseau span:nth-child(1) {
    height: 5px;
  }

  .reseau span:nth-child(2) {
    height: 7px;
  }

  .reseau span:nth-child(3) {
    height: 9px;
  }

  .contenu {
    position: relative;
    flex: 1;
    overflow: hidden;
  }

  .vue {
    display: block;
    width: 100%;
    height: auto;
  }

  /* L'alerte arrive : la page avec le bandeau remplace la page sans, comme au rechargement */
  .apres {
    position: absolute;
    inset: 0 0 auto;
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease);
  }

  /* Sans JavaScript (pas d'animation), directement la page avec l'alerte */
  :global(html:not(.js)) .apres,
  :global(.alerte-visible) .apres {
    opacity: 1;
    transform: none;
  }
</style>
