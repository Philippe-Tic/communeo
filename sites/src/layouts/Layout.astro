---
import type { Site } from '../types/strapi';
import { getImage } from 'astro:assets';
import { getSiteConfig, getStrapiImageUrl, strapiBaseUrl } from '../utils/strapi';
import { computeOnPrimary, computePrimaryText, computeFooterBg } from '../utils/color';
import AlertBanner from '../components/AlertBanner.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/fonts.css';
import '../styles/prose.css';

const strapiUrl = strapiBaseUrl;

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  ogType?: 'website' | 'article';
  ogArticleMeta?: {
    publishedTime?: string;
    modifiedTime?: string;
  };
}

// Récupération de la configuration du site
let siteConfig: Site | null = null;
try {
  siteConfig = await getSiteConfig();
} catch (error) {
  console.error('Erreur lors de la récupération de la configuration du site:', error);
}

// Résoudre l'image source : favicon > logo > null
const faviconSrc = siteConfig?.favicon?.url
  ? getStrapiImageUrl(siteConfig.favicon.url)
  : siteConfig?.logo?.url
    ? getStrapiImageUrl(siteConfig.logo.url)
    : null;

// Traiter les favicons aux tailles nécessaires (Astro cache entre les pages)
let favicon32: Awaited<ReturnType<typeof getImage>> | undefined;
let favicon16: Awaited<ReturnType<typeof getImage>> | undefined;
let appleTouchIcon: Awaited<ReturnType<typeof getImage>> | undefined;

if (faviconSrc) {
  [favicon32, favicon16, appleTouchIcon] = await Promise.all([
    getImage({ src: faviconSrc, width: 32, height: 32, format: 'png' }),
    getImage({ src: faviconSrc, width: 16, height: 16, format: 'png' }),
    getImage({ src: faviconSrc, width: 180, height: 180, format: 'png' }),
  ]);
}

const {
  title = siteConfig?.name || 'Site de la mairie',
  description: rawDescription,
  image,
  noIndex = false,
  ogType = 'website',
  ogArticleMeta,
} = Astro.props;

const description = rawDescription || `Site officiel de la ${siteConfig?.name || 'mairie'}`;

// Construction de l'URL complète pour le titre
const fullTitle = title === siteConfig?.name ? title : `${title} - ${siteConfig?.name}`;

const siteUrl = Astro.site?.toString() || Astro.url.origin;

// URL de l'image pour les réseaux sociaux (fallback: logo du site, puis image OG par défaut)
const socialImage = image ? getStrapiImageUrl(image) :
  (siteConfig?.logo ? getStrapiImageUrl(siteConfig.logo.url) : new URL('/og-default.png', siteUrl).toString());

// JSON-LD Organization + CivicStructure
const organizationJsonLd = siteConfig ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": ["GovernmentOrganization", "CivicStructure"],
  "name": siteConfig.name,
  "url": siteUrl,
  ...(siteConfig.address && { "address": { "@type": "PostalAddress", "streetAddress": siteConfig.address } }),
  ...(siteConfig.contact_phone && { "telephone": siteConfig.contact_phone }),
  ...(siteConfig.contact_mail && { "email": siteConfig.contact_mail }),
  ...(siteConfig.logo && { "logo": getStrapiImageUrl(siteConfig.logo.url) }),
  ...(siteConfig.infos_pratiques?.opening_hours && { "openingHours": siteConfig.infos_pratiques.opening_hours }),
}) : null;

// JSON-LD WebSite + SearchAction
const websiteJsonLd = siteConfig ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteConfig.name,
  "url": siteUrl,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}/recherche?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
}) : null;

---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {favicon32 ? (
      <>
        <link rel="icon" type="image/png" sizes="32x32" href={favicon32.src} />
        <link rel="icon" type="image/png" sizes="16x16" href={favicon16!.src} />
        <link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon!.src} />
      </>
    ) : (
      <>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      </>
    )}
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={`rgb(${siteConfig?.colors?.primaryRgb || '59 130 246'})`} />

    <!-- Preload critical fonts -->
    <link rel="preload" href="/fonts/Marianne-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Marianne-Bold.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Preconnect to Strapi for faster image loading -->
    <link rel="preconnect" href={strapiUrl} crossorigin />
    <link rel="dns-prefetch" href={strapiUrl} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig?.name || 'Mairie'} - Actualités`} href={new URL('/rss.xml', siteUrl).toString()} />

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    {siteConfig?.name && <meta property="og:site_name" content={siteConfig.name} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {ogArticleMeta?.publishedTime && <meta property="article:published_time" content={ogArticleMeta.publishedTime} />}
    {ogArticleMeta?.modifiedTime && <meta property="article:modified_time" content={ogArticleMeta.modifiedTime} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    {socialImage && <meta property="twitter:image" content={socialImage} />}

    <!-- JSON-LD Organization -->
    {organizationJsonLd && (
      <script type="application/ld+json" set:html={organizationJsonLd} />
    )}

    <!-- JSON-LD WebSite -->
    {websiteJsonLd && (
      <script type="application/ld+json" set:html={websiteJsonLd} />
    )}

    <!-- Couleurs du thème en CSS custom properties -->
    <style define:vars={{
      'color-primary': siteConfig?.colors?.primaryRgb || '59 130 246',
      'color-on-primary': computeOnPrimary(siteConfig?.colors?.primary || '#3b82f6'),
      'color-primary-text': computePrimaryText(siteConfig?.colors?.primary || '#3b82f6'),
      'color-footer-bg': computeFooterBg(siteConfig?.colors?.primary || '#3b82f6'),
    }}>
      :root {
        --color-primary: var(--color-primary);
        --color-on-primary: var(--color-on-primary);
        --color-primary-text: var(--color-primary-text);
        --color-footer-bg: var(--color-footer-bg);
      }
    </style>
  </head>
  <body class="font-sans min-h-screen bg-gray-50 flex flex-col">
    <AlertBanner />
    <slot />

    <!-- Styles pour l'accessibilité -->
    <style is:global>
      /* Sticky footer — main prend l'espace restant */
      main {
        flex: 1 0 auto;
      }

      /* Focus visible — outline natif pour navigation clavier uniquement */
      *:focus {
        outline: none;
      }

      *:focus-visible {
        outline: 2px solid rgb(var(--color-primary-text));
        outline-offset: 2px;
      }

      /* Skip link pour l'accessibilité */
      .skip-link {
        position: absolute;
        top: -40px;
        left: 6px;
        background: rgb(var(--color-primary));
        color: rgb(var(--color-on-primary));
        padding: 8px;
        text-decoration: none;
        transition: top 0.3s;
      }

      .skip-link:focus-visible {
        top: 6px;
      }
    </style>

    <CookieBanner />
  </body>
</html>
