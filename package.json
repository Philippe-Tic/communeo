{
  "name": "communeo",
  "private": true,
  "description": "Communeo — CMS multi-communes (monorepo V2)",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,md}\" \"themes/**/*.{ts,tsx,astro,json,md}\" \"*.{json,md,yaml}\"",
    "gen:types": "pnpm --filter @communeo/core gen:types",
    "create-theme": "node scripts/create-theme.mjs",
    "theme:dev": "node scripts/theme-dev.mjs",
    "theme:thumbnail": "node scripts/theme-thumbnail.mjs",
    "docs:captures": "E2E_THEMES=institutionnel pnpm --filter @communeo/renderer exec node e2e/build.mjs && pnpm --filter @communeo/admin exec vite build && DOCS_CAPTURES=1 pnpm --filter @communeo/admin exec playwright test docs-captures --project laptop-1366"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
