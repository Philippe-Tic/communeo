---
/** Proposer une association : formulaire envoyé à la mairie, qui publie après vérification. */
import type { FormConfig, PageContext } from '@communeo/theme-contract';
import ApiForm from '../parts/ApiForm.astro';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; form: FormConfig }
const { ctx, form } = Astro.props;
---
<Layout ctx={ctx}>
  <div class="bo-form-page">
    <p class="bo-lead">Votre association n'est pas encore référencée ? Proposez-la : la mairie la publiera après vérification.</p>
    <ApiForm form={form} submitLabel="Proposer l'association" success="Merci ! Votre proposition sera examinée par la mairie.">
      <p><label for="as-name">Nom de l'association</label><input id="as-name" name="name" required autocomplete="organization" /></p>
      <p>
        <label for="as-category">Catégorie</label>
        <select id="as-category" name="category" required>{(form.options ?? []).map((o) => <option value={o.key}>{o.label}</option>)}</select>
      </p>
      <p><label for="as-description">Présentation <span class="bo-optional">(facultatif)</span></label><textarea id="as-description" name="description" rows="5"></textarea></p>
      <p><label for="as-submitter">Votre nom</label><input id="as-submitter" name="submitted_by_name" required autocomplete="name" /></p>
      <p><label for="as-email">Votre e-mail</label><input id="as-email" name="submitted_by_email" type="email" required autocomplete="email" /></p>
      <p class="bo-muted">Vos coordonnées servent uniquement à traiter cette proposition. <a href="/donnees-personnelles">En savoir plus</a></p>
    </ApiForm>
  </div>
</Layout>
