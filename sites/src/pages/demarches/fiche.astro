---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FicheViewer from '../../components/comarquage/FicheViewer.tsx';
---

<Layout title="Fiche pratique" description="Fiche pratique service-public.fr" noIndex={true}>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>
  <Navigation />
  <main id="main-content">
    <Breadcrumb items={[{ label: 'Démarches', href: '/demarches' }, { label: 'Fiche pratique' }]} />
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <FicheViewer client:load />
    </div>
  </main>
  <Footer />
</Layout>
