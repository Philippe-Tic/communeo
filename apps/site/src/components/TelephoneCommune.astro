---
/**
 * Le site de Saint-Aubin-sur-Loire sur un téléphone. `anime` : nom, horaires, adresse et population
 * remplacent un à un leurs squelettes (« le site se remplit » avec les données publiques), joué une fois
 * à l'affichage ; directement l'état final si les animations sont réduites.
 */
interface Props {
  anime?: boolean;
}

const { anime = false } = Astro.props;
---

<div class="telephone-commune" data-telephone={anime ? 'anime' : undefined} data-etape={anime ? '0' : '5'}>
  <div
    class="appareil"
    role="img"
    aria-label="Le site de Saint-Aubin-sur-Loire sur un téléphone : nom de la commune, horaires, adresse et population se remplissent avec les données publiques."
  >
    <div class="ecran">
      <div class="statut">
        <span>9:41</span>
        <span class="ilot"></span>
        <span class="reseau"><span></span><span></span><span></span></span>
      </div>
      <div class="tete">
        <div class="blason">SA</div>
        <div class="champ nom">
          <div class="squelette"><span style="width:80%;height:9px"></span><span style="width:45%;height:7px"></span></div>
          <div class="valeur" data-pas="1"><span class="mairie-de">Mairie de</span><span class="commune">Saint-Aubin-sur-Loire</span></div>
        </div>
        <div class="burger"><span></span><span></span><span></span></div>
      </div>
      <div class="photo"></div>
      <div class="corps">
        <div class="titre-mairie">
          <span>La mairie</span>
          <span class="donnees">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>Données
            publiques
          </span>
        </div>
        <div class="carte">
          <div class="champ" style="height:34px">
            <div class="squelette"><span style="width:40%;height:8px"></span><span style="width:70%;height:8px"></span></div>
            <div class="valeur" data-pas="2">
              <div class="ouvert"><span></span>Ouvert maintenant</div>
              <div class="horaires">Du lundi au vendredi, 9 h-12 h et 14 h-17 h</div>
            </div>
          </div>
          <div class="filet"></div>
          <div class="champ" style="height:18px">
            <div class="squelette ligne"><span style="width:60%;height:8px"></span></div>
            <span class="valeur texte" data-pas="3">1 place de la Mairie, 45 190 Saint-Aubin</span>
          </div>
          <div class="filet"></div>
          <div class="champ" style="height:18px">
            <div class="squelette ligne"><span style="width:35%;height:8px"></span></div>
            <span class="valeur texte" data-pas="4"><b>1 240</b> habitants <span class="insee">· INSEE</span></span>
          </div>
        </div>
        <div class="tuiles"><div>Démarches</div><div>Actualités</div><div>Agenda</div><div>Cantine</div></div>
      </div>
    </div>
  </div>
</div>

<script>
  for (const phone of document.querySelectorAll<HTMLElement>('[data-telephone="anime"]')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) phone.dataset.etape = '5';
    else [1, 2, 3, 4, 5].forEach((step) => setTimeout(() => (phone.dataset.etape = String(step)), 500 + step * 650));
  }
</script>

<style>
  .telephone-commune {
    width: 280px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Sans JavaScript, l'état final */
  :global(html:not(.js)) .telephone-commune .valeur,
  :global(html:not(.js)) .telephone-commune .donnees {
    opacity: 1;
    transform: none;
  }

  :global(html:not(.js)) .telephone-commune .squelette {
    opacity: 0;
  }

  .appareil {
    width: 280px;
    height: 580px;
    padding: 9px;
    border-radius: 42px;
    background: var(--encre);
    box-shadow:
      0 30px 60px -30px rgba(14, 64, 51, 0.45),
      0 2px 6px rgba(28, 27, 24, 0.18);
  }

  .ecran {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 33px;
    background: var(--blanc);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .statut {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 22px 6px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--encre);
  }

  .ilot {
    width: 74px;
    height: 20px;
    border-radius: 12px;
    background: var(--encre);
  }

  .reseau {
    display: flex;
    gap: 3px;
    align-items: flex-end;
  }

  .reseau span {
    width: 3px;
    border-radius: 1px;
    background: var(--encre);
  }

  .reseau span:nth-child(1) {
    height: 5px;
  }

  .reseau span:nth-child(2) {
    height: 7px;
  }

  .reseau span:nth-child(3) {
    height: 9px;
  }

  .tete {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px 12px;
    border-bottom: 1px solid var(--grege);
  }

  .blason {
    width: 34px;
    height: 40px;
    flex: none;
    border-radius: 4px 4px 17px 17px;
    background: var(--sauge);
    border: 1.5px solid var(--sapin);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--sapin);
  }

  .champ {
    position: relative;
  }

  .nom {
    flex: 1;
    height: 36px;
  }

  .squelette,
  .valeur {
    position: absolute;
    inset: 0;
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease);
  }

  .squelette {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
  }

  .squelette span {
    display: block;
    border-radius: 5px;
    background: #eceae3;
  }

  .squelette.ligne {
    justify-content: flex-start;
    padding-top: 5px;
  }

  .valeur {
    opacity: 0;
    transform: translateY(6px);
  }

  .nom .valeur {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .mairie-de {
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--encre-douce);
  }

  .commune {
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--sapin);
  }

  .burger {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .burger span {
    width: 16px;
    height: 2px;
    background: var(--encre);
  }

  .photo {
    height: 120px;
    flex: none;
    background: repeating-linear-gradient(135deg, #e1e9e4 0 8px, #d5e0d9 8px 16px);
  }

  .corps {
    padding: 14px 14px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .titre-mairie {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--encre);
  }

  .donnees {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border-radius: 20px;
    background: var(--sauge);
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--sapin);
    opacity: 0;
    transition: opacity 0.5s;
  }

  .carte {
    border: 1px solid var(--grege);
    border-radius: 10px;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .ouvert {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--succes);
  }

  .ouvert span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--succes);
  }

  .horaires {
    margin-top: 2px;
    font-size: 0.75rem;
    color: var(--encre-douce);
  }

  .texte {
    font-size: 0.75rem;
    color: var(--encre);
  }

  .insee {
    color: var(--encre-douce);
  }

  .filet {
    height: 1px;
    background: #edebe4;
  }

  .tuiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .tuiles div {
    border-radius: 8px;
    background: var(--papier-clair);
    padding: 10px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sapin);
  }

  /* Étapes : 1 nom, 2 horaires, 3 adresse, 4 population, 5 pastille « Données publiques » */
  [data-etape='1'] [data-pas='1'],
  [data-etape='2'] :is([data-pas='1'], [data-pas='2']),
  [data-etape='3'] :is([data-pas='1'], [data-pas='2'], [data-pas='3']),
  [data-etape='4'] .valeur,
  [data-etape='5'] .valeur {
    opacity: 1;
    transform: none;
  }

  [data-etape='1'] .nom .squelette,
  [data-etape='2'] .champ:has([data-pas='1'], [data-pas='2']) .squelette,
  [data-etape='3'] .champ:has([data-pas='1'], [data-pas='2'], [data-pas='3']) .squelette,
  [data-etape='4'] .squelette,
  [data-etape='5'] .squelette {
    opacity: 0;
  }

  [data-etape='5'] .donnees {
    opacity: 1;
  }

</style>
