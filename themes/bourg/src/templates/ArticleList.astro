---
/**
 * Actualités : titre et compteur, filtres en pastilles, puis une grille de cartes (l'article à la une
 * sur deux colonnes en première page), pagination, état vide.
 */
import type { ArticleCardVM } from '@communeo/core';
import type { FilterOption, PageContext, PaginationLinks } from '@communeo/theme-contract';
import ArticleCard from '../parts/ArticleCard.astro';
import Empty from '../parts/Empty.astro';
import Filters from '../parts/Filters.astro';
import Layout from '../parts/Layout.astro';
import Pagination from '../parts/Pagination.astro';

interface Props { ctx: PageContext; articles: ArticleCardVM[]; categories: FilterOption[]; pagination: PaginationLinks }
const { ctx, articles, categories, pagination } = Astro.props;
const [first] = articles;
const lead = pagination.page === 1 && first?.featured ? first : null;
const rest = articles.filter((article) => article !== lead);
const filter = categories.find((category) => category.current) ?? null;
---
<Layout ctx={ctx} heading={false}>
  <div class="bo-list-head">
    <h1>{ctx.title}</h1>
    <p class="bo-count" role="status">{pagination.total} actualité{pagination.total > 1 ? 's' : ''}{filter && <> · {filter.label}</>}</p>
  </div>
  <Filters label="Filtrer par catégorie" options={categories} allHref="/actualites" />

  {articles.length > 0 ? (
    <div class="bo-news-grid">
      {lead && <ArticleCard article={lead} level={2} featured />}
      {rest.map((article) => <ArticleCard article={article} level={2} />)}
    </div>
  ) : (
    <Empty title={filter ? `Aucune actualité « ${filter.label} »` : 'Aucune actualité pour le moment'} action={filter ? { label: 'Voir toutes les actualités', href: '/actualites' } : null}>
      {filter ? 'Aucune actualité publiée dans cette catégorie.' : 'Les actualités de la commune seront publiées ici.'}
    </Empty>
  )}

  <Pagination pagination={pagination} />
</Layout>
