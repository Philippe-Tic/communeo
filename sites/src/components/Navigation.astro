---
import type { Page, Site } from '../types/strapi';
import { getMenuPages, getSiteConfig, getPagePath } from '../utils/strapi';
import StrapiImage from './StrapiImage.astro';

// Récupération des pages du menu et de la configuration du site
let menuPages: Page[] = [];
let siteConfig: Site | null = null;

try {
  [menuPages, siteConfig] = await Promise.all([
    getMenuPages(),
    getSiteConfig()
  ]);
} catch (error) {
  console.error('Erreur lors de la récupération des données de navigation:', error);
}

// URL actuelle pour la navigation active
const currentPath = Astro.url.pathname;

// Construire l'arbre du menu : pages racines avec leurs enfants
const rootPages = menuPages.filter(p => !p.parent_page);
const menuTree = rootPages.map(page => ({
  ...page,
  children: menuPages.filter(p => p.parent_page?.documentId === page.documentId)
}));

// Un lien est actif si le path courant correspond ou est un sous-path
const isActive = (pagePath: string) =>
  currentPath === pagePath || currentPath.startsWith(pagePath + '/');
---

<!-- TopBar -->
<div class="hidden md:block bg-primary text-white text-xs" role="complementary" aria-label="Informations de contact">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-1.5">
      <div class="flex items-center gap-6">
        {siteConfig?.contact_phone && (
          <a href={`tel:${siteConfig.contact_phone.replace(/\s/g, '')}`} class="flex items-center gap-1.5 hover:text-white/80 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {siteConfig.contact_phone}
          </a>
        )}
        {siteConfig?.contact_mail && (
          <a href={`mailto:${siteConfig.contact_mail}`} class="flex items-center gap-1.5 hover:text-white/80 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {siteConfig.contact_mail}
          </a>
        )}
      </div>
      <div class="flex items-center gap-6">
        {siteConfig?.infos_pratiques?.opening_hours && (
          <span class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Horaires d'ouverture
          </span>
        )}
        <a href="/contact" class="hover:text-white/80 transition-colors">Contact</a>
      </div>
    </div>
  </div>
</div>

<!-- NavBar principale -->
<nav class="nav-main sticky top-0 z-50 bg-white/80 backdrop-blur-lg border-b border-gray-200/50 transition-shadow duration-300" role="navigation" aria-label="Navigation principale">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo et nom de la mairie -->
      <div class="flex items-center">
        <a href="/" class="flex items-center space-x-3 text-gray-900 hover:text-primary transition-colors">
          {siteConfig?.logo?.data && (
            <StrapiImage
              image={siteConfig.logo.data}
              alt={`Logo ${siteConfig.name}`}
              width={40}
              height={40}
              class="h-10 w-auto"
              priority
            />
          )}
          <span class="font-bold text-lg">{siteConfig?.name}</span>
        </a>
      </div>

      <!-- Navigation desktop -->
      <div class="hidden lg:block">
        <div class="flex items-center space-x-1">
          <a
            href="/"
            class={`px-3 py-2 text-sm font-medium transition-colors border-b-2 ${
              currentPath === '/'
                ? 'border-primary text-primary'
                : 'border-transparent text-gray-700 hover:text-primary hover:border-primary/30'
            }`}
            aria-current={currentPath === '/' ? 'page' : undefined}
          >
            Accueil
          </a>

          {menuTree.map((page) => {
            const pagePath = '/' + getPagePath(page, menuPages);
            const active = isActive(pagePath);
            return page.children.length > 0 ? (
              <div class="relative group">
                <a
                  href={pagePath}
                  class={`inline-flex items-center gap-1 px-3 py-2 text-sm font-medium transition-colors border-b-2 ${
                    active
                      ? 'border-primary text-primary'
                      : 'border-transparent text-gray-700 hover:text-primary hover:border-primary/30'
                  }`}
                  aria-current={active ? 'page' : undefined}
                >
                  {page.title}
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>
                <div class="absolute left-0 top-full hidden group-hover:block group-focus-within:block min-w-48 z-50 pt-1">
                  <div class="bg-white/95 backdrop-blur-md rounded-lg shadow-xl border border-gray-100 p-2">
                    {page.children.map((child) => {
                      const childPath = '/' + getPagePath(child, menuPages);
                      const childActive = currentPath === childPath;
                      return (
                        <a
                          href={childPath}
                          class={`block px-3 py-2 text-sm rounded-md transition-colors ${
                            childActive
                              ? 'bg-primary/10 text-primary font-medium'
                              : 'text-gray-700 hover:bg-gray-50 hover:text-primary'
                          }`}
                          aria-current={childActive ? 'page' : undefined}
                        >
                          {child.title}
                        </a>
                      );
                    })}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={pagePath}
                class={`px-3 py-2 text-sm font-medium transition-colors border-b-2 ${
                  active
                    ? 'border-primary text-primary'
                    : 'border-transparent text-gray-700 hover:text-primary hover:border-primary/30'
                }`}
                aria-current={active ? 'page' : undefined}
              >
                {page.title}
              </a>
            );
          })}

          <a
            href="/articles"
            class={`px-3 py-2 text-sm font-medium transition-colors border-b-2 ${
              currentPath.startsWith('/articles')
                ? 'border-primary text-primary'
                : 'border-transparent text-gray-700 hover:text-primary hover:border-primary/30'
            }`}
            aria-current={currentPath.startsWith('/articles') ? 'page' : undefined}
          >
            Actualités
          </a>

          <a
            href="/evenements"
            class={`px-3 py-2 text-sm font-medium transition-colors border-b-2 ${
              currentPath.startsWith('/evenements')
                ? 'border-primary text-primary'
                : 'border-transparent text-gray-700 hover:text-primary hover:border-primary/30'
            }`}
            aria-current={currentPath.startsWith('/evenements') ? 'page' : undefined}
          >
            Événements
          </a>

          <a
            href="/documents"
            class={`px-3 py-2 text-sm font-medium transition-colors border-b-2 ${
              currentPath.startsWith('/documents')
                ? 'border-primary text-primary'
                : 'border-transparent text-gray-700 hover:text-primary hover:border-primary/30'
            }`}
            aria-current={currentPath.startsWith('/documents') ? 'page' : undefined}
          >
            Documents
          </a>

          <a
            href="/equipe-municipale"
            class={`px-3 py-2 text-sm font-medium transition-colors border-b-2 ${
              currentPath.startsWith('/equipe-municipale')
                ? 'border-primary text-primary'
                : 'border-transparent text-gray-700 hover:text-primary hover:border-primary/30'
            }`}
            aria-current={currentPath.startsWith('/equipe-municipale') ? 'page' : undefined}
          >
            Équipe
          </a>

          <a
            href="/associations"
            class={`px-3 py-2 text-sm font-medium transition-colors border-b-2 ${
              currentPath.startsWith('/associations')
                ? 'border-primary text-primary'
                : 'border-transparent text-gray-700 hover:text-primary hover:border-primary/30'
            }`}
            aria-current={currentPath.startsWith('/associations') ? 'page' : undefined}
          >
            Associations
          </a>

          <a
            href="/demarches"
            class={`px-3 py-2 text-sm font-medium transition-colors border-b-2 ${
              currentPath.startsWith('/demarches')
                ? 'border-primary text-primary'
                : 'border-transparent text-gray-700 hover:text-primary hover:border-primary/30'
            }`}
            aria-current={currentPath.startsWith('/demarches') ? 'page' : undefined}
          >
            Démarches
          </a>

          {siteConfig?.open_data_enabled && (
            <a
              href="/open-data"
              class={`px-3 py-2 text-sm font-medium transition-colors border-b-2 ${
                currentPath.startsWith('/open-data')
                  ? 'border-primary text-primary'
                  : 'border-transparent text-gray-700 hover:text-primary hover:border-primary/30'
              }`}
              aria-current={currentPath.startsWith('/open-data') ? 'page' : undefined}
            >
              Open Data
            </a>
          )}
        </div>
      </div>

      <!-- Bouton hamburger pour mobile -->
      <div class="lg:hidden">
        <button
          type="button"
          class="inline-flex items-center justify-center p-2 rounded-lg text-gray-600 hover:text-primary hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-primary transition-colors"
          aria-controls="mobile-menu"
          aria-expanded="false"
          id="mobile-menu-button"
        >
          <span class="sr-only">Ouvrir le menu principal</span>
          <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menu mobile -->
  <div class="lg:hidden hidden" id="mobile-menu" role="menu" aria-orientation="vertical" aria-labelledby="mobile-menu-button">
    <div class="px-4 pt-2 pb-4 space-y-1 bg-white border-t border-gray-100">
      {/* Contact info mobile */}
      <div class="flex flex-wrap gap-3 text-xs text-gray-500 pb-3 mb-2 border-b border-gray-100">
        {siteConfig?.contact_phone && (
          <a href={`tel:${siteConfig.contact_phone.replace(/\s/g, '')}`} class="flex items-center gap-1 hover:text-primary">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            {siteConfig.contact_phone}
          </a>
        )}
        {siteConfig?.contact_mail && (
          <a href={`mailto:${siteConfig.contact_mail}`} class="flex items-center gap-1 hover:text-primary">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            {siteConfig.contact_mail}
          </a>
        )}
      </div>

      <a
        href="/"
        class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
          currentPath === '/'
            ? 'bg-primary/10 text-primary'
            : 'text-gray-900 hover:bg-gray-50 hover:text-primary'
        }`}
        role="menuitem"
      >
        Accueil
      </a>

      {menuTree.map((page) => {
        const pagePath = '/' + getPagePath(page, menuPages);
        const active = isActive(pagePath);
        const hasChildren = page.children.length > 0;
        const childActive = hasChildren && page.children.some(child => currentPath === '/' + getPagePath(child, menuPages));
        return hasChildren ? (
          <div class="mobile-submenu-group">
            <div class="flex items-center">
              <a
                href={pagePath}
                class={`flex-1 block px-3 py-2.5 rounded-l-lg text-base font-medium transition-colors ${
                  active || childActive
                    ? 'bg-primary/10 text-primary'
                    : 'text-gray-900 hover:bg-gray-50 hover:text-primary'
                }`}
                role="menuitem"
              >
                {page.title}
              </a>
              <button
                type="button"
                class={`mobile-submenu-toggle px-3 py-2.5 rounded-r-lg text-base transition-colors ${
                  active || childActive
                    ? 'bg-primary/10 text-primary'
                    : 'text-gray-500 hover:bg-gray-50 hover:text-primary'
                }`}
                aria-expanded={childActive ? 'true' : 'false'}
                aria-label={`Sous-pages de ${page.title}`}
              >
                <svg class="w-4 h-4 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
            </div>
            <div class={`mobile-submenu pl-4 space-y-0.5 overflow-hidden transition-all ${childActive ? '' : 'hidden'}`}>
              {page.children.map((child) => {
                const childPath = '/' + getPagePath(child, menuPages);
                const isChildActive = currentPath === childPath;
                return (
                  <a
                    href={childPath}
                    class={`block pl-4 pr-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                      isChildActive
                        ? 'bg-primary/10 text-primary'
                        : 'text-gray-600 hover:bg-gray-50 hover:text-primary'
                    }`}
                    role="menuitem"
                  >
                    {child.title}
                  </a>
                );
              })}
            </div>
          </div>
        ) : (
          <a
            href={pagePath}
            class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
              active
                ? 'bg-primary/10 text-primary'
                : 'text-gray-900 hover:bg-gray-50 hover:text-primary'
            }`}
            role="menuitem"
          >
            {page.title}
          </a>
        );
      })}

      <a
        href="/articles"
        class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
          currentPath.startsWith('/articles')
            ? 'bg-primary/10 text-primary'
            : 'text-gray-900 hover:bg-gray-50 hover:text-primary'
        }`}
        role="menuitem"
      >
        Actualités
      </a>

      <a
        href="/evenements"
        class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
          currentPath.startsWith('/evenements')
            ? 'bg-primary/10 text-primary'
            : 'text-gray-900 hover:bg-gray-50 hover:text-primary'
        }`}
        role="menuitem"
      >
        Événements
      </a>

      <a
        href="/documents"
        class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
          currentPath.startsWith('/documents')
            ? 'bg-primary/10 text-primary'
            : 'text-gray-900 hover:bg-gray-50 hover:text-primary'
        }`}
        role="menuitem"
      >
        Documents
      </a>

      <a
        href="/equipe-municipale"
        class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
          currentPath.startsWith('/equipe-municipale')
            ? 'bg-primary/10 text-primary'
            : 'text-gray-900 hover:bg-gray-50 hover:text-primary'
        }`}
        role="menuitem"
      >
        Équipe municipale
      </a>

      <a
        href="/associations"
        class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
          currentPath.startsWith('/associations')
            ? 'bg-primary/10 text-primary'
            : 'text-gray-900 hover:bg-gray-50 hover:text-primary'
        }`}
        role="menuitem"
      >
        Associations
      </a>

      <a
        href="/demarches"
        class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
          currentPath.startsWith('/demarches')
            ? 'bg-primary/10 text-primary'
            : 'text-gray-900 hover:bg-gray-50 hover:text-primary'
        }`}
        role="menuitem"
      >
        Démarches
      </a>

      {siteConfig?.open_data_enabled && (
        <a
          href="/open-data"
          class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
            currentPath.startsWith('/open-data')
              ? 'bg-primary/10 text-primary'
              : 'text-gray-900 hover:bg-gray-50 hover:text-primary'
          }`}
          role="menuitem"
        >
          Open Data
        </a>
      )}
    </div>
  </div>
</nav>

<!-- Script pour le menu mobile + scroll shadow -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Scroll shadow effect on navbar
    const navMain = document.querySelector('.nav-main');
    if (navMain) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 10) {
          navMain.classList.add('shadow-sm');
        } else {
          navMain.classList.remove('shadow-sm');
        }
      }, { passive: true });
    }

    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', () => {
        const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';

        // Toggle du menu
        mobileMenu.classList.toggle('hidden');
        mobileMenuButton.setAttribute('aria-expanded', (!isExpanded).toString());

        // Changement de l'icône (hamburger <-> X)
        const icon = mobileMenuButton.querySelector('svg');
        if (icon) {
          if (isExpanded) {
            // Icône hamburger
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
          } else {
            // Icône X
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />';
          }
        }
      });

      // Fermer le menu quand on clique sur un lien (mobile)
      const mobileLinks = mobileMenu.querySelectorAll('a');
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          mobileMenuButton.setAttribute('aria-expanded', 'false');
          const icon = mobileMenuButton.querySelector('svg');
          if (icon) {
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
          }
        });
      });
    }

    // Mobile sub-menu toggles
    const toggleButtons = document.querySelectorAll('.mobile-submenu-toggle');
    toggleButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const group = btn.closest('.mobile-submenu-group');
        if (!group) return;
        const submenu = group.querySelector('.mobile-submenu');
        const chevron = btn.querySelector('svg');
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        if (submenu) {
          submenu.classList.toggle('hidden');
        }
        if (chevron) {
          chevron.style.transform = isExpanded ? '' : 'rotate(180deg)';
        }
        btn.setAttribute('aria-expanded', (!isExpanded).toString());
      });
    });
  });
</script>
