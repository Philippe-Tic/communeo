---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getSiteConfig } from '../utils/strapi';

const siteConfig = await getSiteConfig();
const strapiUrl = import.meta.env.STRAPI_URL;
const siteDocumentId = import.meta.env.SITE_DOCUMENT_ID;
---

<Layout title="Exercice de vos droits RGPD" description={`Exercer vos droits sur vos données personnelles — ${siteConfig.name}`}>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <main id="main-content">
    <header class="bg-gradient-to-br from-primary/10 to-secondary/10 py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-4xl font-bold text-gray-900 mb-4">Exercice de vos droits RGPD</h1>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Conformément au RGPD, vous disposez de droits sur vos données personnelles
          </p>
        </div>
      </div>
    </header>

    <section class="py-12">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-lg max-w-none mb-12">
          <h2>Vos droits</h2>
          <p>
            Conformément au Règlement Général sur la Protection des Données (RGPD) et à la loi
            Informatique et Libertés, vous disposez des droits suivants concernant vos données personnelles :
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 not-prose mt-6 mb-8">
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
              <h3 class="font-semibold text-blue-900 mb-1">Droit d'accès</h3>
              <p class="text-sm text-blue-800">Obtenir la confirmation que vos données sont traitées et en recevoir une copie.</p>
            </div>
            <div class="bg-green-50 border border-green-200 rounded-lg p-4">
              <h3 class="font-semibold text-green-900 mb-1">Droit de rectification</h3>
              <p class="text-sm text-green-800">Faire corriger vos données personnelles inexactes ou incomplètes.</p>
            </div>
            <div class="bg-red-50 border border-red-200 rounded-lg p-4">
              <h3 class="font-semibold text-red-900 mb-1">Droit d'effacement</h3>
              <p class="text-sm text-red-800">Demander la suppression de vos données dans les cas prévus par la loi.</p>
            </div>
            <div class="bg-orange-50 border border-orange-200 rounded-lg p-4">
              <h3 class="font-semibold text-orange-900 mb-1">Droit d'opposition</h3>
              <p class="text-sm text-orange-800">Vous opposer au traitement de vos données pour des motifs légitimes.</p>
            </div>
            <div class="bg-purple-50 border border-purple-200 rounded-lg p-4">
              <h3 class="font-semibold text-purple-900 mb-1">Droit à la portabilité</h3>
              <p class="text-sm text-purple-800">Recevoir vos données dans un format structuré et lisible par machine.</p>
            </div>
            <div class="bg-teal-50 border border-teal-200 rounded-lg p-4">
              <h3 class="font-semibold text-teal-900 mb-1">Droit à la limitation</h3>
              <p class="text-sm text-teal-800">Demander la suspension temporaire du traitement de vos données.</p>
            </div>
          </div>
        </div>

        <div class="border-t border-gray-200 pt-12">
          <h2 class="text-2xl font-bold text-gray-900 mb-6">Formulaire d'exercice de vos droits</h2>
          <p class="text-gray-600 mb-8">
            Remplissez le formulaire ci-dessous pour exercer l'un de vos droits. Votre demande sera traitée
            dans un délai d'un mois conformément à la réglementation.
          </p>

          <div id="rgpd-form-container">
            <form id="rgpd-form" class="space-y-5" novalidate>
              <!-- Honeypot anti-spam -->
              <div class="absolute -left-[9999px]" aria-hidden="true">
                <label for="rgpd-website">Ne pas remplir</label>
                <input type="text" id="rgpd-website" name="website" tabindex="-1" autocomplete="off" />
              </div>

              <input type="hidden" name="site" value={siteDocumentId} />
              <input type="hidden" name="category" value="rgpd" />

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="rgpd_first_name" class="block text-sm font-medium text-gray-700 mb-1">Prénom <span class="text-red-500">*</span></label>
                  <input type="text" id="rgpd_first_name" name="first_name" required maxlength="100"
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                </div>
                <div>
                  <label for="rgpd_last_name" class="block text-sm font-medium text-gray-700 mb-1">Nom <span class="text-red-500">*</span></label>
                  <input type="text" id="rgpd_last_name" name="last_name" required maxlength="100"
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                </div>
              </div>

              <div>
                <label for="rgpd_email" class="block text-sm font-medium text-gray-700 mb-1">Email <span class="text-red-500">*</span></label>
                <input type="email" id="rgpd_email" name="email" required
                  class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
              </div>

              <div>
                <label for="rgpd_right_type" class="block text-sm font-medium text-gray-700 mb-1">Type de droit <span class="text-red-500">*</span></label>
                <select id="rgpd_right_type" name="right_type" required
                  class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
                  <option value="">Sélectionnez un droit</option>
                  <option value="acces">Droit d'accès</option>
                  <option value="rectification">Droit de rectification</option>
                  <option value="effacement">Droit d'effacement</option>
                  <option value="opposition">Droit d'opposition</option>
                  <option value="portabilite">Droit à la portabilité</option>
                  <option value="limitation">Droit à la limitation</option>
                </select>
              </div>

              <div>
                <label for="rgpd_message" class="block text-sm font-medium text-gray-700 mb-1">Description de votre demande <span class="text-red-500">*</span></label>
                <textarea id="rgpd_message" name="message" required rows="6"
                  placeholder="Décrivez précisément votre demande et les données concernées..."
                  class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"></textarea>
              </div>

              <div class="flex items-start gap-2">
                <input type="checkbox" id="rgpd_form_consent" name="rgpd_consent" required
                  class="mt-1 h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary" />
                <label for="rgpd_form_consent" class="text-sm text-gray-600">
                  Je certifie être la personne concernée par cette demande et j'accepte que mes données soient traitées
                  conformément à la <a href="/politique-confidentialite" class="text-primary underline hover:text-secondary">politique de confidentialité</a>. <span class="text-red-500">*</span>
                </label>
              </div>

              <div id="rgpd-form-error" class="hidden rounded-md bg-red-50 border border-red-200 p-4 text-sm text-red-700"></div>

              <button type="submit" id="rgpd-submit-btn"
                class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-sm font-medium text-white hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                Envoyer ma demande
              </button>
            </form>
          </div>

          <!-- Message de confirmation -->
          <div id="rgpd-success" class="hidden rounded-md bg-green-50 border border-green-200 p-6">
            <div class="flex items-start gap-3">
              <svg class="h-6 w-6 text-green-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <div>
                <h3 class="text-lg font-semibold text-green-800">Demande enregistrée</h3>
                <p class="mt-1 text-green-700">
                  Votre demande d'exercice de droits RGPD a bien été enregistrée sous la référence <strong id="rgpd-reference-number"></strong>.
                </p>
                <p class="mt-2 text-sm text-green-600">
                  Conformément à la réglementation, nous disposons d'un délai d'un mois pour traiter votre demande.
                  Un accusé de réception vous sera adressé.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-12 bg-gray-50 rounded-lg p-6">
          <h3 class="font-semibold text-gray-900 mb-2">Réclamation auprès de la CNIL</h3>
          <p class="text-sm text-gray-600">
            Si vous estimez que le traitement de vos données personnelles constitue une violation
            de la réglementation en vigueur, vous pouvez introduire une réclamation auprès de la
            CNIL : <a href="https://www.cnil.fr" target="_blank" rel="noopener noreferrer" class="text-primary underline hover:text-secondary">www.cnil.fr</a>.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .prose h2 {
    color: rgb(var(--color-primary));
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .prose h2:first-child {
    margin-top: 0;
  }

  .prose a {
    color: rgb(var(--color-secondary));
    text-decoration: underline;
  }

  .prose a:hover {
    color: rgb(var(--color-primary));
  }

  .prose p {
    margin-bottom: 1em;
    line-height: 1.7;
  }
</style>

<script define:vars={{ strapiUrl }}>
  (function() {
    const form = document.getElementById('rgpd-form');
    if (!form) return;

    const RIGHT_LABELS = {
      'acces': "Droit d'accès",
      'rectification': 'Droit de rectification',
      'effacement': "Droit d'effacement",
      'opposition': "Droit d'opposition",
      'portabilite': 'Droit à la portabilité',
      'limitation': 'Droit à la limitation',
    };

    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      const errorDiv = document.getElementById('rgpd-form-error');
      const submitBtn = document.getElementById('rgpd-submit-btn');
      const successDiv = document.getElementById('rgpd-success');
      const formContainer = document.getElementById('rgpd-form-container');

      // Honeypot check
      const honeypot = document.getElementById('rgpd-website');
      if (honeypot && honeypot.value) {
        formContainer.classList.add('hidden');
        successDiv.classList.remove('hidden');
        document.getElementById('rgpd-reference-number').textContent = 'SVE-0000-0000';
        return;
      }

      // Validate consent
      const consent = document.getElementById('rgpd_form_consent');
      if (!consent.checked) {
        errorDiv.textContent = 'Vous devez certifier être la personne concernée pour envoyer votre demande.';
        errorDiv.classList.remove('hidden');
        return;
      }

      const formData = new FormData(form);
      const rightType = formData.get('right_type');

      if (!rightType) {
        errorDiv.textContent = 'Veuillez sélectionner le type de droit que vous souhaitez exercer.';
        errorDiv.classList.remove('hidden');
        return;
      }

      const rightLabel = RIGHT_LABELS[rightType] || rightType;

      const data = {
        first_name: formData.get('first_name'),
        last_name: formData.get('last_name'),
        email: formData.get('email'),
        category: 'rgpd',
        subject: `Exercice du ${rightLabel}`,
        message: formData.get('message'),
        site: formData.get('site'),
      };

      if (!data.first_name || !data.last_name || !data.email || !data.message) {
        errorDiv.textContent = 'Veuillez remplir tous les champs obligatoires.';
        errorDiv.classList.remove('hidden');
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(data.email)) {
        errorDiv.textContent = 'Veuillez saisir une adresse email valide.';
        errorDiv.classList.remove('hidden');
        return;
      }

      errorDiv.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi en cours...';

      try {
        const response = await fetch(`${strapiUrl}/api/contact-submissions/public`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ data }),
        });

        if (!response.ok) {
          const err = await response.json().catch(() => null);
          throw new Error(err?.error?.message || 'Une erreur est survenue.');
        }

        const result = await response.json();

        formContainer.classList.add('hidden');
        successDiv.classList.remove('hidden');
        document.getElementById('rgpd-reference-number').textContent = result.data.reference_number;
      } catch (err) {
        errorDiv.textContent = err.message || 'Une erreur est survenue. Veuillez réessayer.';
        errorDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Envoyer ma demande';
      }
    });
  })();
</script>
