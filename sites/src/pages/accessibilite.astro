---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getSiteConfig } from '../utils/strapi';

const siteConfig = await getSiteConfig();
const acc = siteConfig.accessibilite;

const levelLabels: Record<string, string> = {
  'non-conforme': 'Non conforme',
  'partiellement-conforme': 'Partiellement conforme',
  'conforme': 'Totalement conforme',
};
const level = acc?.accessibility_level || 'non-conforme';
const levelLabel = levelLabels[level] || levelLabels['non-conforme'];
---

<Layout title="Accessibilité" description={`Déclaration d'accessibilité — ${siteConfig.name}`}>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <main id="main-content">
    <header class="bg-gradient-to-br from-primary to-primary/80 text-on-primary py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4">Accessibilité</h1>
          <p class="text-lg sm:text-xl text-on-primary/80 max-w-3xl mx-auto">
            Déclaration d'accessibilité — RGAA
          </p>
        </div>
      </div>
    </header>

    <section class="py-12">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-lg max-w-none">

          <h2>État de conformité</h2>
          <p>
            <strong>{siteConfig.name}</strong> s'engage à rendre son site internet accessible
            conformément à l'article 47 de la loi n°2005-102 du 11 février 2005.
          </p>
          <p>
            Le site est <strong>{levelLabel.toLowerCase()}</strong> avec le Référentiel Général
            d'Amélioration de l'Accessibilité (RGAA) version 4.
          </p>

          {acc?.accessibility_declaration ? (
            <>
              <h2>Déclaration d'accessibilité</h2>
              <Fragment set:html={acc.accessibility_declaration} />
            </>
          ) : (
            <>
              <h2>Résultats des tests</h2>
              <p>
                Aucun audit d'accessibilité n'a encore été réalisé sur ce site.
                Cette déclaration sera mise à jour une fois l'audit effectué.
              </p>
            </>
          )}

          {acc?.accessibility_schema_url && (
            <>
              <h2>Schéma pluriannuel</h2>
              <p>
                Consultez le <a href={acc.accessibility_schema_url} target="_blank" rel="noopener noreferrer">
                  schéma pluriannuel d'accessibilité
                </a>.
              </p>
            </>
          )}

          {acc?.accessibility_action_plan_url && (
            <>
              <h2>Plan d'actions</h2>
              <p>
                Consultez le <a href={acc.accessibility_action_plan_url} target="_blank" rel="noopener noreferrer">
                  plan d'actions pour l'accessibilité
                </a>.
              </p>
            </>
          )}

          <h2>Voie de recours</h2>
          <p>
            Si vous constatez un défaut d'accessibilité vous empêchant d'accéder à un contenu
            ou une fonctionnalité du site, vous pouvez nous contacter à l'adresse
            <a href={`mailto:${siteConfig.contact_mail}`}>{siteConfig.contact_mail}</a>.
          </p>
          <p>
            Si vous n'obtenez pas de réponse rapide, vous êtes en droit de faire parvenir
            vos doléances ou une demande de saisine au Défenseur des droits via :
          </p>
          <ul>
            <li>Le <a href="https://formulaire.defenseurdesdroits.fr" target="_blank" rel="noopener noreferrer">formulaire de contact en ligne</a></li>
            <li>Le numéro de téléphone : 09 69 39 00 00</li>
            <li>L'adresse postale : Défenseur des droits, Libre réponse 71120, 75342 Paris CEDEX 07</li>
          </ul>

        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .prose h2 {
    color: rgb(var(--color-primary));
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .prose h2:first-child {
    margin-top: 0;
  }

  .prose a {
    color: rgb(var(--color-primary-text));
    text-decoration: underline;
  }

  .prose a:hover {
    color: rgb(var(--color-primary-text));
  }

  .prose p {
    margin-bottom: 1em;
    line-height: 1.7;
  }

  .prose ul {
    margin: 1em 0;
    padding-left: 1.5em;
  }

  .prose li {
    margin-bottom: 0.5em;
  }
</style>
