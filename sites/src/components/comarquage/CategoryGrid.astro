---
import type { DilaMenuNode } from '../../utils/comarquage-types'

interface Props {
  themes: DilaMenuNode[]
  audience: string
}

const { themes, audience } = Astro.props
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
  {themes.map((theme) => (
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">
      <div class="flex items-center gap-3 mb-4">
        <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-primary-text/10 flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-text" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 0 0-1.883 2.542l.857 6a2.25 2.25 0 0 0 2.227 1.932H19.05a2.25 2.25 0 0 0 2.227-1.932l.857-6a2.25 2.25 0 0 0-1.883-2.542m-16.5 0V6A2.25 2.25 0 0 1 6 3.75h3.879a1.5 1.5 0 0 1 1.06.44l2.122 2.12a1.5 1.5 0 0 0 1.06.44H18A2.25 2.25 0 0 1 20.25 9v.776" />
          </svg>
        </div>
        {theme.children.length > 0 ? (
          <h3 class="text-base font-semibold text-gray-900">{theme.title}</h3>
        ) : (
          <a
            href={`/demarches/fiche?id=${theme.id}&audience=${audience}`}
            class="text-base font-semibold text-primary-text hover:underline"
          >
            {theme.title}
          </a>
        )}
      </div>

      {theme.children.length > 0 && (
        <ul class="space-y-2">
          {theme.children.map((child) => (
            <li>
              <a
                href={`/demarches/fiche?id=${child.id}&audience=${audience}`}
                class="group flex items-center gap-2 text-sm text-gray-600 hover:text-primary-text transition-colors"
              >
                <svg class="w-4 h-4 text-gray-400 group-hover:text-primary-text flex-shrink-0 transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
                {child.title}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  ))}
</div>
