---
/** Boutons en pilule : le premier plein (émeraude), les suivants en contour ; liens externes signalés. */
import type { BlockOf } from '@communeo/core';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';

interface Props { block: BlockOf<'buttons'> }
const { block } = Astro.props;
---
<p class="mo-buttons">
  {block.buttons.map((button) => (
    <a
      href={button.href}
      class:list={['mo-button', 'mo-button-large', { 'mo-button-primary': button.style === 'primary' }]}
      target={button.external ? '_blank' : undefined}
      rel={button.external ? 'noopener noreferrer' : undefined}
    >
      {button.label}
      {button.external && <><ArrowUpRight size={18} aria-hidden="true" /><span class="cn-sr-only">(nouvelle fenêtre)</span></>}
    </a>
  ))}
</p>
