---
import tableauDeBord from '../assets/captures/tableau-de-bord.png';
import conformite from '../assets/captures/conformite.png';
import Accordeon from '../components/Accordeon.astro';
import AppelFinal from '../components/AppelFinal.astro';
import Icone, { type IconeNom } from '../components/Icone.astro';
import Logo from '../components/Logo.astro';
import Navigateur from '../components/Navigateur.astro';
import SelecteurThemes from '../components/SelecteurThemes.astro';
import Tampon from '../components/Tampon.astro';
import TelephoneCommune from '../components/TelephoneCommune.astro';
import Topo from '../components/Topo.astro';
import Base from '../layouts/Base.astro';
import { TRIAL_URL } from '../lib/site';
import { PRIX_MAX, PRIX_MIN, TRANCHES } from '../lib/tarifs';

const constat = [
  {
    t: 'Le vieux site qu’on ne sait plus mettre à jour',
    p: 'L’agence a disparu, le prestataire coûte trop cher, les identifiants sont perdus. Les horaires affichés ne sont plus les bons.',
    r: 'Vous modifiez votre site vous-même, depuis un navigateur, sans formation.',
  },
  {
    t: 'Le site du bénévole parti',
    p: 'Un élu ou un bénévole l’avait fait. Il s’en va à la fin du mandat, et personne ne sait comment il fonctionne.',
    r: 'Plusieurs personnes travaillent sur le site, chacune avec son rôle. Le site reste à la commune.',
  },
  {
    t: 'Des obligations floues',
    p: 'Accessibilité, RGPD, mentions légales, publication des actes : vous savez qu’il y a des règles, sans savoir lesquelles.',
    r: 'L’écran Conformité vous dit ce que la loi demande, et le site le fait en grande partie pour vous.',
  },
];

const promesses = [
  { n: '01', t: 'Simple', p: 'Vous tenez le site vous-même, pendant la permanence, sans formation préalable. L’éditeur ressemble à un traitement de texte.' },
  {
    n: '02',
    t: 'Prêt tout de suite',
    p: 'À l’inscription, l’assistant de création remplit le site avec les données publiques de la commune : coordonnées, horaires, population. Il peut être en ligne dès le premier jour.',
  },
  {
    n: '03',
    t: 'Conforme',
    p: 'Accessibilité, RGPD, mentions légales, démarches Service-Public : les pages obligatoires sont générées, et les thèmes testés en continu.',
  },
];

const habitants: Array<{ icone: IconeNom; t: string; p: string }> = [
  { icone: 'horloge', t: 'Horaires', p: 'Avec l’indication « ouvert » ou « fermé » en direct' },
  { icone: 'actualites', t: 'Actualités', p: 'Classées par catégories' },
  { icone: 'agenda', t: 'Agenda', p: 'La fête du village, le conseil municipal' },
  { icone: 'demarches', t: 'Démarches', p: 'Plus de 3 000 fiches Service-Public' },
  { icone: 'alerte', t: 'Alertes', p: 'Coupure d’eau, route barrée, vigilance météo' },
  { icone: 'cantine', t: 'Cantine', p: 'Le menu de la semaine' },
  { icone: 'collectes', t: 'Collectes', p: 'Les prochains ramassages, encombrants compris' },
  { icone: 'documents', t: 'Documents du conseil', p: 'Délibérations, procès-verbaux, arrêtés, budgets' },
];

const fonctionsAdmin = [
  { t: 'Éditeur par blocs', p: 'Texte, image, boutons, encadré, documents, galerie, questions-réponses. Enregistrement automatique pendant la saisie.' },
  { t: 'Aperçu avant publication', p: 'Vous voyez le brouillon dans votre thème avant de le publier.' },
  { t: 'Publication programmée', p: 'Vous pouvez par exemple préparer le menu de la cantine et le publier lundi à 7 h.' },
  { t: 'Alertes en direct', p: 'Un bandeau sur tout le site, avec une date de fin.' },
  { t: 'Mise en ligne en un clic', p: 'Environ 30 secondes, ou automatiquement quelques instants après vos changements.' },
];

const etapesPublication = ['Vérification', 'Génération des pages', 'Publication', 'En ligne'];

const quatreTemps = [
  { n: '1', t: 'Inscription', p: 'Deux minutes en ligne. La mairie confirme depuis son adresse officielle.' },
  { n: '2', t: 'Essai de 30 jours', p: 'Toutes les fonctions, sans carte bancaire. L’assistant pré-remplit le site.' },
  { n: '3', t: 'Devis en ligne', p: 'Le prix s’affiche selon la population. Le maire valide le devis en ligne.' },
  { n: '4', t: 'En ligne sur votre domaine', p: 'Le site passe sur l’adresse de la commune, par exemple mairie-saint-aubin.fr.' },
];

const faq = [
  {
    q: 'Faut-il des compétences en informatique ?',
    a: 'Non. L’administration s’utilise comme un traitement de texte, dans un navigateur. Une aide est intégrée à chaque écran et une documentation complète est en ligne.',
  },
  {
    q: 'Combien de temps pour avoir un site en ligne ?',
    a: 'L’assistant de création pré-remplit le site dès l’inscription, et il est en ligne sur son adresse Communeo dès que la mairie a confirmé l’inscription. Comptez une journée pour le compléter et le mettre à votre image.',
  },
  {
    q: 'Combien cela coûte-t-il ?',
    a: `De ${PRIX_MIN} € à ${PRIX_MAX} € HT par an selon la population INSEE, sans frais de mise en service. Les 30 premiers jours sont gratuits.`,
  },
  {
    q: 'Comment se passe la facturation pour une commune ?',
    a: 'Le maire valide un devis en ligne. La facture arrive par Chorus Pro, la plateforme de l’État qui reçoit les factures des collectivités, et se règle par virement sous 30 jours.',
  },
  {
    q: 'Que se passe-t-il à la fin de l’essai ?',
    a: 'Sans abonnement, le site est retiré et l’administration passe en lecture seule. Vos données sont conservées six mois, le temps de changer d’avis, puis supprimées.',
  },
];
---

<Base
  titre="Site internet pour mairie, prêt en une journée · Communeo"
  description="Le site internet de votre commune, prêt en une journée, conforme et facile à tenir à jour, sans prestataire. Essai gratuit 30 jours, sans engagement."
>
  <!-- 1 Accroche -->
  <section class="accroche sombre">
    <Topo viewBox="0 0 1440 900" cx={1120} cy={520} rings={13} gap={58} r0={40} seed={0.4} sx={1.35} />
    <div class="accroche-interieur">
      <div class="accroche-texte">
        <span class="surtitre surtitre--ble">Pour les mairies de toutes tailles</span>
        <h1 id="contenu" tabindex="-1">
          Votre commune a <span class="souligne"
            >sa place<svg aria-hidden="true" viewBox="0 0 200 16" preserveAspectRatio="none"
              ><path d="M3 11 C 50 4, 120 2, 197 8" fill="none" stroke="#E3B55B" stroke-width="5" stroke-linecap="round" vector-effect="non-scaling-stroke"
              ></path></svg
            ></span
          > en ligne.
        </h1>
        <p class="chapo-accroche">Le site internet de votre commune, prêt en une journée, conforme et facile à tenir à jour, sans prestataire.</p>
        <div class="ctas">
          <a class="bouton bouton--grand bouton--papier bouton--fleche" href={TRIAL_URL}>Essayer gratuitement 30 jours<Icone nom="fleche" /></a>
          <a class="bouton bouton--grand bouton--contour" href="/tarifs">Voir les tarifs</a>
        </div>
        <ul class="reassurances">
          <li><Icone nom="coche" taille={16} epaisseur={2.5} couleur="#E3B55B" />Sans engagement</li>
          <li><Icone nom="coche" taille={16} epaisseur={2.5} couleur="#E3B55B" />Sans carte bancaire</li>
          <li><Icone nom="coche" taille={16} epaisseur={2.5} couleur="#E3B55B" />Sans frais de mise en service</li>
        </ul>
      </div>
      <div class="accroche-visuel">
        <div class="etiquette" aria-hidden="true"><span class="point"></span><span class="texte-etiquette">SAINT-AUBIN-SUR-LOIRE · COMMUNE DE DÉMONSTRATION</span></div>
        <div class="telephone-tampon">
          <TelephoneCommune anime />
          <Tampon texte="SANS FRAIS DE MISE EN SERVICE ·" class="tampon" />
        </div>
      </div>
    </div>
  </section>

  <!-- 2 Le constat -->
  <section class="section" aria-labelledby="t-constat">
    <div class="conteneur pile" style="gap:48px">
      <div class="pile titre-bloc">
        <span class="surtitre">Le constat</span>
        <h2 id="t-constat" class="h2">Trois situations que connaissent bien les petites mairies</h2>
      </div>
      <div class="constat">
        {
          constat.map((c) => (
            <article>
              <h3>{c.t}</h3>
              <p class="doux">{c.p}</p>
              <div class="reponse">
                <Logo variante="picto" class="picto-reponse" />
                <p>{c.r}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 3 Trois promesses -->
  <section class="section promesses sombre" aria-labelledby="t-promesses">
    <Topo viewBox="0 0 1440 600" align="xMinYMid" cx={160} cy={300} rings={11} gap={56} r0={30} seed={1.7} sx={1.4} opacite={0.14} />
    <div class="conteneur pile" style="gap:48px;position:relative">
      <h2 id="t-promesses">Ce que Communeo change pour la mairie</h2>
      <div class="promesses-grille">
        {
          promesses.map((p) => (
            <div class="promesse">
              <span class="numero">{p.n}</span>
              <h3>{p.t}</h3>
              <p>{p.p}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4 Le site de votre commune -->
  <section class="section fond-clair" aria-labelledby="t-site">
    <div class="conteneur site-commune">
      <div class="pile site-texte">
        <span class="surtitre">Le site de votre commune</span>
        <h2 id="t-site" class="h2">Ce que vos habitants y trouvent, sur leur téléphone comme sur leur ordinateur</h2>
        <ul class="habitants">
          {
            habitants.map((h) => (
              <li>
                <span class="pastille-icone">
                  <Icone nom={h.icone} taille={20} epaisseur={1.8} />
                </span>
                <span class="pile" style="gap:2px">
                  <b>{h.t}</b>
                  <span class="doux">{h.p}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="site-telephone"><TelephoneCommune /></div>
    </div>
  </section>

  <!-- 5 Quatre thèmes -->
  <section class="section" aria-labelledby="t-themes">
    <div class="conteneur pile" style="gap:36px">
      <div class="entete-section">
        <div class="pile titre-bloc">
          <span class="surtitre">Quatre thèmes</span>
          <h2 id="t-themes" class="h2">Le même contenu, quatre mises en page</h2>
          <p class="texte doux">Choisissez un thème, changez-en quand vous voulez : vos pages, actualités et documents suivent. Essayez :</p>
        </div>
        <a class="lien-fort" href="/themes">Découvrir les quatre thèmes</a>
      </div>
      <SelecteurThemes />
    </div>
  </section>

  <!-- 6 L'administration -->
  <section class="section fond-blanc" aria-labelledby="t-admin">
    <div class="conteneur pile" style="gap:48px">
      <div class="admin-entete">
        <div class="pile titre-bloc" style="max-width:700px">
          <span class="surtitre">L’administration</span>
          <h2 id="t-admin" class="h2">Aussi simple qu’un traitement de texte</h2>
          <p class="texte doux">Tout se fait dans un navigateur, sur ordinateur, tablette ou téléphone. Rien à installer.</p>
        </div>
        <div class="demo-publication" data-demo-publication>
          <span class="doux">Essayez le bouton :</span>
          <button type="button" class="bouton-publier">
            <svg class="icone-publier" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
              ><path d="M12 13v8M4 14.9A7 7 0 1 1 15.7 8h1.8a4.5 4.5 0 0 1 2.5 8.2M8 17l4-4 4 4"></path></svg
            ><svg class="icone-en-ligne" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
              ><path d="M20 6 9 17l-5-5"></path></svg
            ><span class="libelle">Mettre en ligne</span>
          </button>
          <ol aria-live="polite">
            {
              etapesPublication.map((etape) => (
                <li data-nom={etape}>
                  <span class="rond" aria-hidden="true">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </span>
                  {etape}
                  <span class="sr-only etat" />
                </li>
              ))
            }
          </ol>
        </div>
      </div>
      <div class="admin-grille">
        <Navigateur
          src={tableauDeBord}
          adresse="app.communeo.fr"
          largeur={640}
          alt="Tableau de bord de Saint-Aubin-sur-Loire : une alerte coupure d’eau en cours, des modifications en attente de mise en ligne, la conformité à 50 %, la prochaine action recommandée et trois messages non lus."
        />
        <ul class="fonctions-admin">
          {
            fonctionsAdmin.map((f) => (
              <li>
                <b>{f.t}</b>
                <span class="doux">{f.p}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 7 Service-Public -->
  <section class="section" aria-labelledby="t-sp">
    <div class="conteneur deux-colonnes">
      <div class="pile" style="gap:20px">
        <span class="surtitre">Les démarches Service-Public intégrées</span>
        <p class="grand-chiffre"><span class="chiffre chiffres">3 000</span><span class="unite">fiches officielles</span></p>
        <h2 id="t-sp" class="titre-sp">Carte d’identité, passeport, état civil, urbanisme, élections : tout est déjà sur votre site.</h2>
        <p class="texte doux">
          Les fiches de Service-Public.fr sont tenues à jour par l’État. Vos habitants les consultent et les recherchent depuis le site de la commune. Quand une fiche indique « Où
          s’adresser : mairie », le lien mène à votre page contact.
        </p>
      </div>
      <div class="maquette-recherche" aria-hidden="true">
        <span class="doux" style="font-size:0.875rem">mairie-saint-aubin.fr/demarches</span>
        <div class="champ-recherche"><Icone nom="recherche" couleur="#4A4942" />carte d’identité<span class="curseur"></span></div>
        <div class="pile">
          {
            ['Carte d’identité d’un majeur : première demande', 'Carte d’identité : renouvellement', 'Carte d’identité perdue ou volée'].map((titre) => (
              <div class="resultat">
                <span>{titre}</span>
                <span class="source">Service-Public</span>
              </div>
            ))
          }
        </div>
        <div class="ou-sadresser"><Icone nom="lieu" /><span><b>Où s’adresser : mairie</b> · Contacter la mairie de Saint-Aubin</span></div>
      </div>
    </div>
  </section>

  <!-- 8 Alertes -->
  <section class="section alertes" aria-labelledby="t-alertes">
    <div class="conteneur alertes-grille" data-demo-alerte>
      <div class="alertes-telephone">
        <div
          class="appareil-alerte"
          role="img"
          aria-label="Sur le téléphone d’un habitant, le bandeau « Coupure d’eau mardi de 9 h à 12 h » apparaît en haut du site de la commune, 42 secondes après sa publication."
        >
          <div class="ecran-alerte">
            <div class="ilot-alerte"><span></span></div>
            <div class="bandeau-alerte">
              <div class="alerte">
                <Icone nom="triangle" taille={20} couleur="#7A4B00" />
                <div class="pile" style="gap:0.125rem">
                  <span class="niveau">ALERTE · ATTENTION</span>
                  <span class="titre-alerte">Coupure d’eau mardi de 9 h à 12 h</span>
                  <span class="detail-alerte">Rue des Lilas et rue du Stade</span>
                </div>
              </div>
            </div>
            <div class="tete-alerte"><span class="blason-alerte"></span><span>Saint-Aubin-sur-Loire</span></div>
            <div class="photo-alerte"></div>
            <div class="lignes"><span style="width:70%"></span><span style="width:90%"></span><span style="width:60%"></span></div>
          </div>
        </div>
      </div>
      <div class="pile alertes-texte">
        <span class="surtitre">Alertes en direct</span>
        <h2 id="t-alertes" class="h2">Coupure d’eau, route barrée : l’information est en ligne en moins d’une minute.</h2>
        <p class="texte">
          Vous publiez l’alerte depuis l’administration, avec un niveau de gravité et une date de fin. Le bandeau apparaît en haut de toutes les pages du site et se retire à la date
          de fin.
        </p>
        <div class="compteur">
          <Icone nom="chrono" taille={28} epaisseur={1.8} couleur="#0E4033" />
          <span class="chrono chiffres" aria-hidden="true">0:00</span>
          <span class="doux">entre la publication et<br />l’affichage chez l’habitant</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 9 Conformité -->
  <section class="section" aria-labelledby="t-conf">
    <div class="conteneur deux-colonnes deux-colonnes--large">
      <div class="pile" style="gap:1.375rem">
        <span class="surtitre">Conformité</span>
        <h2 id="t-conf" class="h2">Ce que la loi demande, point par point</h2>
        <p class="texte">
          L’écran Conformité liste les obligations du site d’une commune : mentions légales, RGPD (le règlement sur les données personnelles), accessibilité, publication des actes. Pour
          chaque point, il indique l’écran où le compléter.
        </p>
        <ul class="coches">
          <li>
            <Icone nom="coche" taille={22} couleur="#0E4033" /><span
              ><b>Pages légales générées</b> : mentions légales, données personnelles, déclaration d’accessibilité, cookies, exercice des droits, plan du site. Elles se remplissent avec les
              informations de votre commune.</span
            >
          </li>
          <li>
            <Icone nom="coche" taille={22} couleur="#0E4033" /><span
              ><b>Thèmes testés à chaque modification</b> : contrastes, titres, focus clavier, affichage à 320 px et texte agrandi à 200 %, complétés par des vérifications au lecteur d’écran.</span
            >
          </li>
          <li><Icone nom="coche" taille={22} couleur="#0E4033" /><span><b>Aucun traceur publicitaire</b> sur le site de votre commune.</span></li>
        </ul>
        <p class="encadre encadre--info">
          <Icone nom="info" taille={20} /><span
            >Communeo vous aide à être conforme et teste ses thèmes. La conformité finale dépend aussi de ce que vous publiez : textes alternatifs des images, documents PDF.</span
          >
        </p>
      </div>
      <Navigateur
        src={conformite}
        largeur={640}
        alt="Écran Conformité de Saint-Aubin-sur-Loire : 9 points sur 18 en ordre, répartis entre mentions légales, RGPD, accessibilité, publication des actes et cookies, chacun avec un lien vers l’écran à compléter."
      />
    </div>
  </section>

  <!-- 10 Tarifs -->
  <section class="section fond-clair" aria-labelledby="t-tarifs">
    <div class="conteneur pile" style="gap:2.5rem">
      <div class="entete-section">
        <div class="pile titre-bloc">
          <span class="surtitre">Tarifs</span>
          <h2 id="t-tarifs" class="h2">Un prix annuel selon la population, sans frais de mise en service</h2>
        </div>
        <a class="bouton bouton--sapin" href="/tarifs">Voir le détail des tarifs</a>
      </div>
      <ul class="tranches">
        {
          TRANCHES.map((t) => (
            <li>
              <span class="doux">{t.label}</span>
              <span class="prix chiffres">{t.price} €</span>
              <span class="doux petit">HT par an · soit {t.month} € par mois</span>
            </li>
          ))
        }
      </ul>
      <p class="doux" style="margin:0;font-size:1rem">Population municipale INSEE. TVA non applicable, art. 293 B du CGI : le prix HT est le prix payé.</p>
    </div>
  </section>

  <!-- 11 Comment ça marche -->
  <section class="section" aria-labelledby="t-comment">
    <div class="conteneur pile" style="gap:3rem">
      <div class="entete-section">
        <div class="pile titre-bloc">
          <span class="surtitre">Comment ça marche</span>
          <h2 id="t-comment" class="h2">Quatre temps, de l’inscription à votre domaine</h2>
        </div>
        <a class="lien-fort" href="/comment-ca-marche">Voir les sept étapes en détail</a>
      </div>
      <div class="quatre-temps">
        <svg class="liaison" aria-hidden="true" width="100%" height="60" viewBox="0 0 1200 60" preserveAspectRatio="none"
          ><path d="M30 30 C 180 -5, 300 65, 450 30 S 750 -5, 900 30 S 1100 65, 1170 30" fill="none" stroke="#0E4033" stroke-width="1.5" opacity=".45" vector-effect="non-scaling-stroke"
          ></path></svg
        >
        <ol>
          {
            quatreTemps.map((s) => (
              <li>
                <span class="rond-etape" aria-hidden="true">
                  {s.n}
                </span>
                <h3>{s.t}</h3>
                <p class="doux">{s.p}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 12 Questions -->
  <section class="section fond-blanc" aria-labelledby="t-faq">
    <div class="pile" style="max-width:60rem;margin:0 auto;gap:32px">
      <div class="entete-section" style="gap:16px">
        <h2 id="t-faq" class="h2">Vos questions</h2>
        <a class="lien-fort" href="/questions">Toutes les questions</a>
      </div>
      <Accordeon items={faq} prefixe="faq-accueil" />
    </div>
  </section>

  <!-- 13 Appel final -->
  <AppelFinal grand titre="Votre commune mérite un site à jour." mention="30 jours gratuits · Sans engagement · Sans carte bancaire" />
</Base>

<script>
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Démo du bouton « Mettre en ligne » : trois étapes de 900 ms, puis « En ligne »
  const demo = document.querySelector<HTMLElement>('[data-demo-publication]');
  if (demo) {
    const button = demo.querySelector<HTMLButtonElement>('button')!;
    const label = button.querySelector('.libelle')!;
    const steps = [...demo.querySelectorAll<HTMLLIElement>('li')];
    const names = steps.map((step) => step.dataset.nom ?? '');
    let timers: number[] = [];
    const show = (step: number) => {
      demo.dataset.etape = String(step);
      label.textContent = step < 0 ? 'Mettre en ligne' : step < 3 ? `${names[step]}…` : 'En ligne';
      button.setAttribute('aria-disabled', String(step >= 0 && step < 3));
      steps.forEach((li, index) => {
        li.classList.toggle('fait', index <= step);
        li.querySelector('.etat')!.textContent = index <= step ? ' : terminé' : '';
      });
    };
    button.addEventListener('click', () => {
      const current = Number(demo.dataset.etape ?? -1);
      if (current >= 0 && current < 3) return;
      timers.forEach(clearTimeout);
      if (reduce()) return show(3);
      show(0);
      timers = [1, 2, 3].map((step) => window.setTimeout(() => show(step), step * 900));
    });
  }

  // Alerte : quand la section est visible, le compteur monte à 0:42 puis le bandeau descend
  const alertSection = document.querySelector<HTMLElement>('[data-demo-alerte]');
  if (alertSection) {
    const clock = alertSection.querySelector('.chrono')!;
    const finish = () => {
      clock.textContent = '0:42';
      alertSection.classList.add('alerte-visible');
    };
    if (reduce()) finish();
    else {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          const start = performance.now();
          const tick = () => {
            const progress = Math.min(1, (performance.now() - start) / 1600);
            clock.textContent = `0:${String(Math.round(42 * (1 - Math.pow(1 - progress, 3)))).padStart(2, '0')}`;
            if (progress < 1) requestAnimationFrame(tick);
            else finish();
          };
          requestAnimationFrame(tick);
        },
        { threshold: 0.45 },
      );
      observer.observe(alertSection);
    }
  }
</script>

