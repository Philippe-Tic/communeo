{
  "kind": "collectionType",
  "collectionName": "waste_schedules",
  "info": {
    "singularName": "waste-schedule",
    "pluralName": "waste-schedules",
    "displayName": "Collecte des dechets",
    "description": "Planning de collecte des dechets par type et jour"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "waste_type": {
      "type": "enumeration",
      "enum": ["ordures-menageres", "tri-selectif", "verre", "dechets-verts", "encombrants"],
      "required": true
    },
    "collection_day": {
      "type": "enumeration",
      "enum": ["lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi", "dimanche"],
      "required": false
    },
    "frequency": {
      "type": "enumeration",
      "enum": ["hebdomadaire", "semaines-paires", "semaines-impaires", "bimensuel", "mensuel", "apport-volontaire", "sur-rendez-vous"],
      "default": "hebdomadaire",
      "required": true
    },
    "month_rank": {
      "type": "integer",
      "min": 1,
      "max": 5
    },
    "season_start_month": {
      "type": "integer",
      "min": 1,
      "max": 12
    },
    "season_end_month": {
      "type": "integer",
      "min": 1,
      "max": 12
    },
    "start_date": {
      "type": "date"
    },
    "zone": {
      "type": "string",
      "maxLength": 100
    },
    "notes": {
      "type": "text",
      "maxLength": 500
    },
    "active": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site",
      "inversedBy": "waste_schedules",
      "required": true
    }
  }
}
