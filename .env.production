# =============================================================================
# CMS Mairies — Variables d'environnement production
# =============================================================================
# IMPORTANT : Ne JAMAIS commiter ce fichier. Copier vers .env sur le serveur.
# Générer les secrets avec : openssl rand -base64 16
# Si une valeur contient un $, l'entourer de simples quotes pour éviter
# que Docker Compose ne l'interprète comme une variable.
# =============================================================================

# --- Domaine ---
DOMAIN=cms.tondomaine.fr

# --- PostgreSQL ---
POSTGRES_PASSWORD=CHANGEME_GENERATE_WITH_openssl_rand_base64_32

# --- Strapi secrets ---
# Générer chaque clé avec : openssl rand -base64 16
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=CHANGEME
ADMIN_JWT_SECRET=CHANGEME
TRANSFER_TOKEN_SALT=CHANGEME
JWT_SECRET=CHANGEME

# --- Netlify (déploiement des sites municipaux) ---
NETLIFY_TOKEN=your_netlify_access_token

# --- Strapi API token (à créer dans Strapi > Settings > API Tokens après premier démarrage) ---
STRAPI_API_TOKEN=

# --- Email (Resend HTTP API — gratuit 100 emails/jour, 3 000/mois) ---
# Passe par HTTPS (port 443), pas de SMTP (ports 465/587 bloqués sur Dedibox)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
EMAIL_DEFAULT_FROM=noreply@tondomaine.fr

# --- Super admin (optionnel, premier boot uniquement) ---
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
