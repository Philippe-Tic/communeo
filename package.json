{
  "name": "communeo",
  "private": true,
  "description": "Communeo — CMS multi-communes (monorepo V2)",
  "packageManager": "pnpm@10.18.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,md}\" \"themes/**/*.{ts,tsx,astro,json,md}\" \"*.{json,md,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
