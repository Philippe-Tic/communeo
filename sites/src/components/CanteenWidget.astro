---
import type { SchoolMenu, MealLabel } from '../types/strapi';
import { getStrapiImageUrl } from '../utils/strapi';

interface Props {
  menu: SchoolMenu;
}

const { menu } = Astro.props;

const DAY_LABELS: Record<string, string> = {
  'lundi': 'Lun',
  'mardi': 'Mar',
  'mercredi': 'Mer',
  'jeudi': 'Jeu',
  'vendredi': 'Ven',
};

const LABEL_EMOJIS: Record<MealLabel, string> = {
  'bio': '🌱',
  'local': '📍',
  'vegetarien': '🥬',
  'fait-maison': '👨‍🍳',
  'aop': '🏅',
};

const weekStart = new Date(menu.week_start + 'T00:00:00');
const friday = new Date(weekStart);
friday.setDate(friday.getDate() + 4);

const formatShortDate = (d: Date) => d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' });
const weekLabel = `Semaine du ${formatShortDate(weekStart)} au ${formatShortDate(friday)}`;
---

<div>
  <p class="text-sm text-gray-500 mb-3">{weekLabel}</p>

  {menu.menu_mode === 'image' && menu.menu_image ? (
    <div class="rounded-lg overflow-hidden border">
      <img
        src={getStrapiImageUrl(menu.menu_image.url)}
        alt="Menu de la semaine"
        class="w-full object-contain"
        loading="lazy"
      />
    </div>
  ) : menu.menu_mode === 'manual' && menu.meals && menu.meals.length > 0 ? (
    <div class="flex flex-col gap-2">
      {menu.meals.map((meal) => (
        <div class="flex items-center gap-3 rounded-lg bg-gray-50 px-3 py-2">
          <span class="text-xs font-semibold text-gray-500 w-8">{DAY_LABELS[meal.day]}</span>
          <span class="text-sm font-medium text-gray-900 flex-1">{meal.main_course}</span>
          {meal.labels && meal.labels.length > 0 && (
            <span class="text-xs" title={meal.labels.join(', ')}>
              {meal.labels.map((l: MealLabel) => LABEL_EMOJIS[l] || '').join('')}
            </span>
          )}
        </div>
      ))}
    </div>
  ) : (
    <p class="text-gray-500 text-sm">Menu non disponible.</p>
  )}

  <div class="mt-3">
    <a
      href="/cantine"
      class="inline-flex items-center text-primary-text hover:text-primary-text/80 font-medium text-sm group/link"
    >
      Voir le menu complet
      <svg class="ml-1 w-4 h-4 transition-transform group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>
</div>
