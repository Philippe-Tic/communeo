---
import type { Site, SocialPlatform } from '../types/strapi';
import { getSiteConfig, getStrapiImageUrl } from '../utils/strapi';
import { getOpeningHoursEntries } from '../utils/opening-hours';
import StrapiImage from './StrapiImage.astro';
import NewsletterForm from './NewsletterForm.astro';

let siteConfig: Site | null = null;

try {
  siteConfig = await getSiteConfig();
} catch (error) {
  console.error('Erreur lors de la récupération de la configuration du site:', error);
}

const currentYear = new Date().getFullYear();
const accessibilityLevel = siteConfig?.accessibilite?.accessibility_level || 'non-conforme';
const socialLinks = siteConfig?.social_links ?? [];
const showNewsletter = siteConfig?.homepage?.show_newsletter ?? false;

const SOCIAL_ICONS: Record<Exclude<SocialPlatform, 'autre'>, string> = {
  facebook: '<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>',
  instagram: '<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>',
  linkedin: '<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
  x: '<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"/></svg>',
  youtube: '<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>',
  tiktok: '<svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>',
};

const SOCIAL_PLATFORM_LABELS: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  linkedin: 'LinkedIn',
  x: 'X (Twitter)',
  youtube: 'YouTube',
  tiktok: 'TikTok',
};

// Pre-compute social link rendering data to avoid complex types in JSX
const socialLinksData = socialLinks.map((link) => {
  const isKnown = link.platform !== 'autre' && link.platform in SOCIAL_ICONS;
  return {
    url: link.url,
    ariaLabel: isKnown
      ? `Suivez-nous sur ${SOCIAL_PLATFORM_LABELS[link.platform] || link.platform}`
      : link.label || 'Réseau social',
    iconSvg: isKnown ? SOCIAL_ICONS[link.platform as keyof typeof SOCIAL_ICONS] : null,
    customIconUrl: !isKnown && link.icon?.url ? getStrapiImageUrl(link.icon.url) : null,
  };
});
---

<footer class="border-t-4 border-primary bg-[rgb(var(--color-footer-bg))] text-white" role="contentinfo" aria-label="Pied de page">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Logo + description -->
    <div class="pt-12 pb-8 border-b border-white/20">
      <div class="flex items-center gap-4 mb-4">
        {siteConfig?.logo && (
          <StrapiImage
            image={siteConfig.logo}
            alt={`Logo ${siteConfig.name}`}
            width={48}
            height={48}
            class="h-12 w-auto"
          />
        )}
        <div>
          <h2 class="text-xl font-bold text-white">{siteConfig?.name || 'Votre mairie'}</h2>
          {siteConfig?.address && (
            <p class="text-sm text-white/70">{siteConfig.address}</p>
          )}
        </div>
      </div>
      {socialLinksData.length > 0 && (
        <div class="flex items-center gap-3 mt-4">
          {socialLinksData.map((item) => (
            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.ariaLabel}
              class="flex items-center justify-center w-9 h-9 rounded-full bg-white/20 text-white/70 hover:bg-white/30 hover:text-white transition-colors"
            >
              {item.iconSvg ? (
                <Fragment set:html={item.iconSvg} />
              ) : item.customIconUrl ? (
                <img src={item.customIconUrl} alt="" class="w-5 h-5 rounded-sm object-contain" />
              ) : (
                <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
              )}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Main footer content -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 py-10">
      <!-- Column 1 - Contact -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Contact</h3>
        <address class="not-italic text-white/70 space-y-3 text-sm">
          {siteConfig?.contact_phone && (
            <p class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-white/50 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
              </svg>
              <a href={`tel:${siteConfig.contact_phone.replace(/\s/g, '')}`} class="hover:text-white transition-colors">
                {siteConfig.contact_phone}
              </a>
            </p>
          )}
          {siteConfig?.contact_mail && (
            <p class="flex items-center gap-2.5">
              <svg class="w-4 h-4 text-white/50 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              <a href={`mailto:${siteConfig.contact_mail}`} class="hover:text-white transition-colors">
                {siteConfig.contact_mail}
              </a>
            </p>
          )}
          {(() => {
            const entries = siteConfig?.infos_pratiques?.opening_hours
              ? getOpeningHoursEntries(siteConfig.infos_pratiques.opening_hours)
              : [];
            return entries.length > 0 ? (
              <div class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-white/50 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div class="text-sm">
                  {entries.map((entry) => (
                    <p>{entry.day} : {entry.hours}</p>
                  ))}
                </div>
              </div>
            ) : null;
          })()}
        </address>
      </div>

      <!-- Column 2 - Navigation -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Navigation</h3>
        <nav aria-label="Navigation du pied de page">
          <ul class="space-y-2.5 text-sm text-white/70">
            <li>
              <a href="/" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Accueil</a>
            </li>
            <li>
              <a href="/actualites" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Actualités</a>
            </li>
            <li>
              <a href="/evenements" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Événements</a>
            </li>
            <li>
              <a href="/equipe-municipale" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Équipe municipale</a>
            </li>
            <li>
              <a href="/associations" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Associations</a>
            </li>
            <li>
              <a href="/contact" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Nous contacter</a>
            </li>
          </ul>
        </nav>
      </div>

      <!-- Column 3 - Services -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Services</h3>
        <ul class="space-y-2.5 text-sm text-white/70">
          <li>
            <a href="/demarches" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Démarches en ligne</a>
          </li>
          <li>
            <a href="/documents" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Documents officiels</a>
          </li>
          <li>
            <a href="/contact" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">Contact et réclamations</a>
          </li>
        </ul>
      </div>

      <!-- Column 4 - Legal -->
      <div>
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">Informations légales</h3>
        <nav aria-label="Liens légaux">
          <ul class="space-y-2.5 text-sm text-white/70">
            <li>
              <a href="/mentions-legales" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">
                Mentions légales
              </a>
            </li>
            <li>
              <a href="/politique-confidentialite" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">
                Politique de confidentialité
              </a>
            </li>
            <li>
              <a href="/accessibilite" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">
                Accessibilité
              </a>
            </li>
            <li>
              <a href="#" data-cookie-settings class="hover:text-white hover:translate-x-0.5 transition-all inline-block">
                Gestion des cookies
              </a>
            </li>
            <li>
              <a href="/exercice-droits" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">
                Exercice des droits RGPD
              </a>
            </li>
            {siteConfig?.open_data_enabled && (
              <li>
                <a href="/open-data" class="hover:text-white hover:translate-x-0.5 transition-all inline-block">
                  Open Data
                </a>
              </li>
            )}
          </ul>
        </nav>
      </div>
    </div>

    <!-- Newsletter -->
    {showNewsletter && (
      <NewsletterForm variant="footer" />
    )}

    <!-- Bottom bar -->
    <div class="border-t border-white/20 py-6">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-white/60">
        <p>&copy; {currentYear} {siteConfig?.name || 'Votre mairie'}. Tous droits réservés.</p>
        <p>Site réalisé avec <a href="https://communeo.fr/" target="_blank" rel="noopener noreferrer" class="text-white/70 hover:text-white transition-colors">Communeo</a></p>
        <p>Accessibilité : <span class="font-medium text-white/70">{accessibilityLevel}</span></p>
      </div>
    </div>
  </div>
</footer>
