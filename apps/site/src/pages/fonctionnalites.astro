---
import type { ImageMetadata } from 'astro';
import conformite from '../assets/captures/conformite.png';
import messages from '../assets/captures/messages.png';
import pages from '../assets/captures/pages.png';
import tableauDeBord from '../assets/captures/tableau-de-bord.png';
import AppelFinal from '../components/AppelFinal.astro';
import BandeauPage from '../components/BandeauPage.astro';
import Navigateur from '../components/Navigateur.astro';
import Video from '../components/Video.astro';
import Base from '../layouts/Base.astro';
import type { IdVideo } from '../lib/videos';

interface Groupe {
  id: string;
  part: string;
  t: string;
  intro: string;
  /** Capture à droite de l'introduction, ou une vidéo à sa place */
  image?: ImageMetadata;
  video?: { id: IdVideo; libelle: string };
  adresse?: string;
  alt?: string;
  rubriques?: boolean;
  feats: Array<{ t: string; p: string; ex?: string }>;
}

const groupes: Groupe[] = [
  {
    id: 'informer',
    part: 'Le site public',
    t: 'Informer vos habitants',
    intro: 'Un site clair, lisible sur téléphone, qui fonctionne même avec une connexion lente. Vos habitants y trouvent l’essentiel sans appeler la mairie.',
    video: { id: 'v2-alerte', libelle: 'Voir l’alerte · 20 s' },
    rubriques: true,
    feats: [
      { t: 'Alertes en bandeau', p: 'Visibles sur le site en moins d’une minute, avec un niveau de gravité et une date de fin.', ex: '« Route barrée entre le bourg et le lavoir jusqu’à vendredi. »' },
      { t: 'Actualités et agenda', p: 'Actualités par catégories, événements avec lieu et inscription.', ex: 'La fête du village, la réunion publique sur le PLU.' },
      { t: 'Démarches Service-Public', p: 'Toutes les fiches officielles de Service-Public.fr, tenues à jour par l’État, recherchables depuis votre site.', ex: 'Un habitant cherche « passeport » et trouve la bonne fiche.' },
      { t: 'Horaires en direct', p: 'Les horaires de la mairie avec l’indication « ouvert » ou « fermé ».', ex: '« Ouvert jusqu’à 12 h » un mardi matin.' },
      { t: 'Vie pratique', p: 'Menu de la cantine, prochaines collectes, perturbations en cours.', ex: 'Le ramassage des encombrants du 12 juin.' },
      { t: 'Documents officiels', p: 'Délibérations, procès-verbaux, arrêtés, budgets, classés par type et par année.', ex: 'Le procès-verbal du dernier conseil municipal.' },
      { t: 'Recherche sur tout le site', p: 'Pages, actualités, documents et démarches.', ex: '« salle des fêtes » renvoie la page de location.' },
      { t: 'Votre adresse', p: 'Le site est en ligne sur nom-de-la-commune.communeo.fr dès l’essai, puis sur le domaine de la commune.', ex: 'mairie-saint-aubin.fr, avec certificat HTTPS.' },
    ],
  },
  {
    id: 'publier',
    part: 'L’administration',
    t: 'Publier sans stress',
    intro: 'L’administration s’utilise dans un navigateur, sur ordinateur, tablette ou téléphone. Rien à installer.',
    image: pages,
    alt: 'Écran Pages de l’administration : la liste des pages avec leur statut, leur adresse et leur date de modification, et le bouton « Nouvelle page ».',
    feats: [
      { t: 'Assistant de démarrage', p: 'À l’inscription, Communeo va chercher les données publiques de la commune et pré-remplit le site.', ex: 'Coordonnées et horaires de l’Annuaire de l’administration, population INSEE.' },
      { t: 'Éditeur par blocs', p: 'Texte, image, boutons, encadré, documents, galerie, questions-réponses, contact, vidéo.', ex: 'La page « Location de la salle des fêtes » avec tarifs et contrat en PDF.' },
      { t: 'Enregistrement automatique', p: 'Rien ne se perd pendant la saisie.', ex: 'Le téléphone sonne au milieu d’une phrase : vous reprenez où vous en étiez.' },
      { t: 'Aperçu et publication programmée', p: 'Voyez le brouillon dans votre thème, publiez à la date et à l’heure choisies.', ex: 'Le menu de la cantine part lundi à 7 h.' },
      { t: 'Historique des versions', p: 'Revenez à une version précédente d’une page.', ex: 'Retrouver les horaires d’été de l’an dernier.' },
      { t: 'Médiathèque', p: 'Images et documents réutilisables. Un texte alternatif est demandé pour chaque image.', ex: 'La photo de la mairie, utilisée sur trois pages.' },
      { t: 'Mise en ligne en un clic', p: 'En moins d’une minute, ou automatiquement quelques instants après vos changements.', ex: 'Le bouton « Mettre en ligne », en haut de chaque écran.' },
    ],
  },
  {
    id: 'repondre',
    part: 'L’administration',
    t: 'Répondre aux habitants',
    intro: 'Les messages envoyés depuis le site arrivent dans l’administration, classés par catégorie. Vous y répondez directement.',
    image: messages,
    alt: 'Écran Messages : une demande RGPD signalée avec son délai légal de réponse, la liste des messages par catégorie et le champ de réponse.',
    feats: [
      { t: 'Formulaire de contact', p: 'Avec catégories : état civil, urbanisme, voirie…', ex: '« Nid-de-poule dangereux à l’angle de la rue du Stade », catégorie Voirie.' },
      { t: 'Demandes RGPD identifiées', p: 'Les demandes sur les données personnelles sont signalées avec leur délai d’un mois.', ex: '« Réponse obligatoire avant le 25 octobre ».' },
      { t: 'Lettre d’information', p: 'Les habitants s’inscrivent depuis le site ; vous retrouvez la liste des inscrits.', ex: 'La lettre du mois envoyée aux inscrits.' },
      { t: 'Associations', p: 'Elles proposent leur fiche depuis le site ; vous la publiez ou la refusez.', ex: 'Le comité des fêtes met à jour ses contacts.' },
    ],
  },
  {
    id: 'regles',
    part: 'Conformité et sécurité',
    t: 'Être dans les règles',
    intro: 'Communeo est construit pour les obligations d’un site de commune. Il vous aide à être conforme et teste ses thèmes ; la conformité finale dépend aussi de vos contenus.',
    image: conformite,
    alt: 'Écran Conformité : 9 points sur 18 en ordre, avec la liste des points restants et l’écran où les compléter.',
    feats: [
      { t: 'Écran Conformité', p: 'Ce que la loi demande au site d’une commune, point par point, avec l’écran où le compléter.', ex: '« 2 images sans texte alternatif ».' },
      { t: 'Pages légales générées', p: 'Mentions légales, données personnelles, déclaration d’accessibilité, cookies, exercice des droits, plan du site.', ex: 'Remplies avec le SIRET et l’adresse de la mairie.' },
      { t: 'Thèmes testés en continu', p: 'À chaque modification, sur chaque page, selon les critères WCAG 2.2 AA sur lesquels s’appuie le RGAA : contrastes, titres, focus clavier, 320 px, texte agrandi à 200 %.', ex: 'Complétés par des vérifications au lecteur d’écran.' },
      { t: 'Aucun traceur publicitaire', p: 'Vidéos et cartes ne se chargent qu’après accord de l’habitant.', ex: 'Pas de bandeau cookies à afficher par défaut.' },
      { t: 'Sauvegardes chiffrées', p: 'Quotidiennes, conservées 90 jours hors du serveur.', ex: 'En cas d’incident, les contenus sont restaurés par l’équipe.' },
      { t: 'Cloisonnement strict', p: 'Chaque commune ne voit que ses propres données.' },
    ],
  },
  {
    id: 'plusieurs',
    part: 'L’administration',
    t: 'Travailler à plusieurs',
    intro: 'Le site ne dépend plus d’une seule personne. Secrétaire, maire, adjoint à la communication : chacun a son accès.',
    image: tableauDeBord,
    alt: 'Tableau de bord : prochaine action recommandée, derniers contenus modifiés avec leur auteur, messages non lus.',
    feats: [
      { t: 'Deux rôles', p: 'Administrateur (tout) et rédacteur (contenus, vie pratique, messages, médiathèque).', ex: 'L’adjointe publie l’agenda, la secrétaire gère les messages.' },
      { t: 'Journal d’activité', p: 'Qui a fait quoi, sur six mois.', ex: '« Sophie Leroy a modifié Inscriptions scolaires ».' },
      { t: 'Aide intégrée', p: 'À chaque écran, et une documentation complète en ligne, avec captures.' },
      { t: 'Accessible à tous', p: 'Mode sombre, navigation complète au clavier, pensée pour les lecteurs d’écran.' },
    ],
  },
];

const rubriques = [
  'Accroche',
  'Accès rapides',
  'Actualités à la une',
  'Agenda',
  'Mot du maire',
  'Chiffres clés',
  'Infos pratiques',
  'Météo',
  'Prochaines collectes',
  'Perturbations en cours',
  'Menu de la cantine',
  'Associations',
  'Partenaires',
  'Lettre d’information',
  'Contenu libre',
];
---

<Base
  titre="Fonctionnalités du site internet de mairie · Communeo"
  description="Alertes, actualités, démarches Service-Public, éditeur simple, publication programmée, écran Conformité : tout pour informer vos habitants."
  courant="fonctionnalites"
>
  <BandeauPage
    surtitre="Fonctionnalités"
    titre="Tout ce qu’il faut pour tenir le site de la commune."
    chapo="Le site public que voient vos habitants, l’administration où vous le tenez à jour, et ce qu’il faut pour être dans les règles."
    seed={1.3}
  />

  <nav class="sous-nav" aria-label="Dans cette page">
    <div class="sous-nav-liens">
      {groupes.map((g) => <a href={`#${g.id}`}>{g.t}</a>)}
    </div>
  </nav>

  {
    groupes.map((g, index) => (
      <section id={g.id} class:list={['section groupe', { 'fond-clair': index % 2 === 1 }]} aria-labelledby={`t-${g.id}`}>
        <div class="conteneur pile" style="gap:40px">
          <div class="intro">
            <div class="pile" style="gap:16px">
              <span class="surtitre">{g.part}</span>
              <h2 id={`t-${g.id}`} class="h2">
                {g.t}
              </h2>
              <p class="chapo-groupe">{g.intro}</p>
            </div>
            {g.video ? <Video id={g.video.id} libelle={g.video.libelle} compact /> : g.image && <Navigateur src={g.image} adresse={g.adresse} alt={g.alt ?? ''} largeur={640} />}
          </div>
          <ul class="fonctions">
            {g.feats.map((f) => (
              <li>
                <h3>{f.t}</h3>
                <p>{f.p}</p>
                {f.ex && (
                  <p class="exemple">
                    <b>Exemple</b> · {f.ex}
                  </p>
                )}
              </li>
            ))}
          </ul>
          {g.rubriques && (
            <div class="rubriques">
              <h3>Une page d’accueil à la carte : 15 rubriques à activer</h3>
              <ul>
                {rubriques.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
              <p>Vous choisissez les rubriques, le thème décide de la disposition.</p>
            </div>
          )}
        </div>
      </section>
    ))
  }

  <AppelFinal titre="Essayez Communeo sur votre commune" bouton="Essayer gratuitement 30 jours" />
</Base>

<style>
  .sous-nav {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--papier);
    border-bottom: 1px solid var(--grege);
  }

  .sous-nav-liens {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--gouttiere);
    display: flex;
    gap: 6px;
    overflow-x: auto;
  }

  .sous-nav a {
    flex: none;
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 0 14px;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .sous-nav a:hover {
    text-decoration: underline;
  }

  .sous-nav a:focus-visible {
    outline-offset: -3px;
  }

  .groupe {
    padding-block: clamp(64px, 8vw, 112px);
    scroll-margin-top: 56px;
  }

  .intro {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
  }

  .chapo-groupe {
    margin: 0;
    max-width: 34em;
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3125rem);
    line-height: 1.55;
    color: var(--encre-douce);
  }

  .fonctions {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 16px;
  }

  .fonctions li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-radius: 14px;
    background: var(--blanc);
    border: 1px solid var(--grege);
    transition: border-color 0.2s;
  }

  .fonctions li:hover {
    border-color: var(--sapin);
  }

  .fonctions h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--sapin);
  }

  .fonctions p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .fonctions .exemple {
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px dashed var(--grege);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--encre-douce);
  }

  .exemple b {
    color: var(--tuile);
  }

  .rubriques {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    border-radius: 16px;
    background: var(--sauge);
  }

  .rubriques h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--sapin);
  }

  .rubriques ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .rubriques li {
    padding: 8px 14px;
    border-radius: 20px;
    background: var(--blanc);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--sapin);
  }

  .rubriques p {
    margin: 0;
    font-size: 1rem;
  }
</style>
