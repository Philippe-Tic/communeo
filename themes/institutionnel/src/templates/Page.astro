---
import type { PageVM } from '@communeo/core';
import type { PageContext } from '@communeo/theme-contract';
import Layout from '../parts/Layout.astro';
import Content from '../parts/Content.astro';

interface Props { ctx: PageContext; page: PageVM }
const { ctx, page } = Astro.props;
---
<Layout ctx={ctx}>
  {page.lead && <p class="in-lead">{page.lead}</p>}
  {page.image && <img src={page.image.src} srcset={page.image.srcset ?? undefined} alt={page.image.alt} width={page.image.width ?? undefined} height={page.image.height ?? undefined} />}
  <Content blocks={page.blocks} toc={page.toc} />
  <p class="in-meta">Mis à jour le <time datetime={page.updatedAt.iso}>{page.updatedAt.label}</time></p>
</Layout>
