{
  "name": "@communeo/pipeline",
  "version": "0.0.0",
  "private": true,
  "description": "Pipeline de publication : hébergeurs (SitePublisher), file des builds (pg-boss) et échanges worker / Strapi.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "pg-boss": "^12.33.6"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.18.6",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "sideEffects": false
}
