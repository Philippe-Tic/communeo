---
import theme from 'virtual:communeo/theme';
import Document from '../layouts/Document.astro';
import { getSource, simplePage } from '../lib/content';
import { rightsForm } from '../lib/forms';

const source = getSource();
const site = await source.site();
const ctx = await simplePage(source, {
  path: '/exercer-mes-droits',
  title: 'Exercer mes droits',
  description: 'Demander l’accès, la rectification ou l’effacement de vos données personnelles',
});
const { RightsRequest } = theme.templates;
---
<Document ctx={ctx}><RightsRequest ctx={ctx} form={rightsForm(site.id)} /></Document>
