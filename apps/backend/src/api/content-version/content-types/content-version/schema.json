{
  "kind": "collectionType",
  "collectionName": "content_versions",
  "info": {
    "singularName": "content-version",
    "pluralName": "content-versions",
    "displayName": "Version d'un contenu",
    "description": "Instantané d'une page, actualité, événement ou document à chaque publication (historique, restauration)"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": { "visible": false },
    "content-type-builder": { "visible": false }
  },
  "attributes": {
    "site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site",
      "required": true
    },
    "content_type": {
      "type": "string",
      "required": true
    },
    "content_document_id": {
      "type": "string",
      "required": true
    },
    "kind": {
      "type": "enumeration",
      "enum": ["published", "draft"],
      "default": "published",
      "required": true
    },
    "snapshot": {
      "type": "json",
      "required": true
    },
    "summary": {
      "type": "string"
    },
    "block_count": {
      "type": "integer"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "author_name": {
      "type": "string"
    }
  }
}
