---
import type { Page, Article, Event } from '../types/strapi';
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import StrapiImage from '../components/StrapiImage.astro';
import Section from '../components/Section.astro';
import {
  getHomepage,
  getFeaturedArticles,
  getUpcomingEvents,
  formatDate
} from '../utils/strapi';

// Récupération des données pour la page d'accueil
let homepage: Page | null = null;
let featuredArticles: Article[] = [];
let upcomingEvents: Event[] = [];

try {
  [homepage, featuredArticles, upcomingEvents] = await Promise.all([
    getHomepage(),
    getFeaturedArticles(3),
    getUpcomingEvents(3)
  ]);
} catch (error) {
  console.error('Erreur lors de la récupération des données d\'accueil:', error);
}

// Accès rapides
const quickLinks = [
  { title: 'Démarches', href: '/demarches', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { title: 'État civil', href: '/demarches#etat-civil', icon: 'M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5zm6-10.125a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0zm1.294 6.336a6.721 6.721 0 01-3.17.789 6.721 6.721 0 01-3.168-.789 3.376 3.376 0 016.338 0z' },
  { title: 'Documents', href: '/documents', icon: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z' },
  { title: 'Contact', href: '/contact', icon: 'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75' },
  { title: 'Urgences', href: '/contact', icon: 'M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0' },
  { title: 'Horaires', href: '/contact', icon: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z' },
];
---

<Layout
  title={homepage?.title}
  description={homepage?.meta_description}
  image={homepage?.featured_image?.data?.url}
>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <main id="main-content">
    <!-- Hero Section -->
    {homepage ? (
      <Hero
        title={homepage.title}
        image={homepage.featured_image?.data || null}
        centered={false}
      >
        <div class="prose prose-lg max-w-none text-white/90 mb-6" set:html={homepage.content} />
        <div class="flex flex-wrap gap-4">
          <a
            href="/articles"
            class="inline-flex items-center px-6 py-3 bg-white text-primary font-medium rounded-lg hover:bg-white/90 transition-colors"
          >
            Découvrir
          </a>
          <a
            href="/contact"
            class="inline-flex items-center px-6 py-3 border-2 border-white text-white font-medium rounded-lg hover:bg-white/10 transition-colors"
          >
            Nous contacter
          </a>
        </div>
      </Hero>
    ) : (
      <Hero title="Bienvenue sur le site de votre mairie" />
    )}

    <!-- Accès rapides -->
    <section class="relative -mt-8 z-20 pb-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
          {quickLinks.map((link) => (
            <a
              href={link.href}
              class="flex flex-col items-center gap-2 bg-white rounded-xl border border-gray-100 p-4 shadow-sm hover:shadow-md hover:border-primary/30 hover:-translate-y-0.5 transition-all text-center group"
            >
              <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center group-hover:bg-primary/20 transition-colors">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={link.icon} />
                </svg>
              </div>
              <span class="text-sm font-medium text-gray-700 group-hover:text-primary transition-colors">{link.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Articles mis en avant -->
    {featuredArticles.length > 0 && (
      <Section title="Actualités" subtitle="Restez informés des dernières actualités et annonces de votre mairie.">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
          {featuredArticles.map((article) => (
            <article class="bg-white rounded-xl border border-gray-100 overflow-hidden hover:border-primary/30 hover:shadow-lg hover:-translate-y-0.5 transition-all">
              {article.image?.data && (
                <div class="relative aspect-[16/9] overflow-hidden">
                  <StrapiImage
                    image={article.image.data}
                    alt={article.title}
                    width={400}
                    height={225}
                    class="w-full h-full object-cover"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent" />
                  <span class={`absolute top-3 left-3 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${
                    article.category === 'emergency' ? 'bg-red-100 text-red-800' :
                    article.category === 'news' ? 'bg-blue-100 text-blue-800' :
                    article.category === 'event' ? 'bg-green-100 text-green-800' :
                    'bg-gray-100 text-gray-800'
                  }`}>
                    {article.category === 'emergency' ? 'Urgence' :
                     article.category === 'news' ? 'Actualité' :
                     article.category === 'event' ? 'Événement' :
                     'Information'}
                  </span>
                </div>
              )}

              <div class="p-5">
                <h3 class="text-lg font-bold text-gray-900 mb-2">
                  <a href={`/articles/${article.slug}`} class="hover:text-primary transition-colors">
                    {article.title}
                  </a>
                </h3>

                {article.publication_date && (
                  <time class="text-sm text-gray-400 block mb-3" datetime={article.publication_date}>
                    {formatDate(article.publication_date)}
                  </time>
                )}

                {article.summary && (
                  <p class="text-gray-600 text-sm line-clamp-3 mb-4">
                    {article.summary}
                  </p>
                )}

                <a
                  href={`/articles/${article.slug}`}
                  class="inline-flex items-center text-primary hover:text-primary/80 font-medium text-sm group/link"
                >
                  Lire la suite
                  <svg class="ml-1 w-4 h-4 transition-transform group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </article>
          ))}
        </div>

        <div class="text-center">
          <a
            href="/articles"
            class="inline-flex items-center px-6 py-3 text-base font-medium rounded-lg text-white bg-primary hover:bg-primary/90 transition-colors"
          >
            Voir toutes les actualités
          </a>
        </div>
      </Section>
    )}

    <!-- Événements à venir -->
    {upcomingEvents.length > 0 && (
      <Section title="Événements à venir" subtitle="Découvrez les prochains événements organisés par votre mairie." bg="gray">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
          {upcomingEvents.map((event) => {
            const eventDate = new Date(event.start_date);
            const day = eventDate.getDate();
            const month = eventDate.toLocaleDateString('fr-FR', { month: 'short' }).toUpperCase();
            return (
              <article class="bg-white rounded-xl border border-gray-100 overflow-hidden hover:border-primary/30 hover:shadow-lg hover:-translate-y-0.5 transition-all">
                <div class="flex">
                  {/* Bloc date calendrier */}
                  <div class="flex-shrink-0 w-20 bg-primary/5 flex flex-col items-center justify-center p-3 border-r border-gray-100">
                    <span class="text-2xl font-bold text-primary leading-none">{day}</span>
                    <span class="text-xs font-medium text-primary/70 uppercase mt-1">{month}</span>
                  </div>
                  <div class="flex-1 p-5">
                    <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium mb-2 ${
                      event.category === 'cultural' ? 'bg-purple-100 text-purple-800' :
                      event.category === 'sport' ? 'bg-green-100 text-green-800' :
                      event.category === 'meeting' ? 'bg-blue-100 text-blue-800' :
                      event.category === 'celebration' ? 'bg-yellow-100 text-yellow-800' :
                      'bg-gray-100 text-gray-800'
                    }`}>
                      {event.category === 'cultural' ? 'Culturel' :
                       event.category === 'sport' ? 'Sport' :
                       event.category === 'meeting' ? 'Réunion' :
                       event.category === 'celebration' ? 'Fête' :
                       'Atelier'}
                    </span>

                    <h3 class="text-lg font-bold text-gray-900 mb-2">
                      <a href={`/evenements/${event.slug}`} class="hover:text-primary transition-colors">
                        {event.title}
                      </a>
                    </h3>

                    {event.location && (
                      <div class="flex items-center gap-1.5 text-sm text-gray-500 mb-2">
                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                        </svg>
                        {event.location}
                      </div>
                    )}

                    <a
                      href={`/evenements/${event.slug}`}
                      class="inline-flex items-center text-primary hover:text-primary/80 font-medium text-sm group/link"
                    >
                      En savoir plus
                      <svg class="ml-1 w-4 h-4 transition-transform group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <div class="text-center">
          <a
            href="/evenements"
            class="inline-flex items-center px-6 py-3 text-base font-medium rounded-lg text-white bg-primary hover:bg-primary/90 transition-colors"
          >
            Voir tous les événements
          </a>
        </div>
      </Section>
    )}

    <!-- Section d'absence de contenu -->
    {!homepage && featuredArticles.length === 0 && upcomingEvents.length === 0 && (
      <section class="py-24 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h1 class="text-4xl font-bold text-gray-900 mb-4">
            Bienvenue sur le site de votre mairie
          </h1>
          <p class="text-xl text-gray-600 mb-8">
            Le contenu est en cours de préparation. Revenez bientôt pour découvrir toutes les actualités et services de votre commune.
          </p>
          <div class="bg-blue-50 border border-blue-200 rounded-lg p-6 max-w-2xl mx-auto">
            <p class="text-blue-800">
              <strong>Information :</strong> Si vous êtes administrateur, assurez-vous qu'une page avec le statut "Page d'accueil" est configurée dans votre CMS.
            </p>
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>
