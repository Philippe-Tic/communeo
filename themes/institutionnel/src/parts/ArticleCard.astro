---
/** Carte d'actualité : image, catégorie (jamais la couleur seule), date, titre, résumé. */
import type { ArticleCardVM } from '@communeo/core';

interface Props {
  article: ArticleCardVM;
  level?: 2 | 3;
  /** Carte mise en avant : titre plus grand */
  featured?: boolean;
  /** Article à la une : image et texte côte à côte */
  highlight?: boolean;
}

const { article, level = 3, featured = false, highlight = false } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
---
<article class:list={['in-card', 'in-card-article', { 'in-card-featured': featured, 'in-card-highlight': highlight }]}>
  {article.image && (
    <img
      class="in-card-image"
      src={article.image.src}
      alt={article.image.alt}
      srcset={article.image.srcset ?? undefined}
      width={article.image.width ?? undefined}
      height={article.image.height ?? undefined}
      loading="lazy"
    />
  )}
  <div class="in-card-body">
    <p class="in-card-meta">
      {highlight && <span class="in-tag in-tag-outline">À la une</span>}
      <span class="in-tag">
        {article.category.label}
      </span>
      <time datetime={article.date.iso}>{article.date.label}</time>
    </p>
    <Heading class="in-card-title"><a href={article.href}>{article.title}</a></Heading>
    {article.summary && <p class="in-card-summary">{article.summary}</p>}
    <span class="in-card-more" aria-hidden="true">Lire la suite</span>
  </div>
</article>
