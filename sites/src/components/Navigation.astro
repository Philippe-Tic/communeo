---
import type { Page, Site } from '../types/strapi';
import { getMenuPages, getSiteConfig, getPagePath } from '../utils/strapi';
import StrapiImage from './StrapiImage.astro';

// Récupération des pages du menu et de la configuration du site
let menuPages: Page[] = [];
let siteConfig: Site | null = null;

try {
  [menuPages, siteConfig] = await Promise.all([
    getMenuPages(),
    getSiteConfig()
  ]);
} catch (error) {
  console.error('Erreur lors de la récupération des données de navigation:', error);
}

// URL actuelle pour la navigation active
const currentPath = Astro.url.pathname;

// Construire l'arbre du menu : pages racines avec leurs enfants
const rootPages = menuPages.filter(p => !p.parent_page && !p.is_homepage);
const menuTree = rootPages.map(page => ({
  ...page,
  children: menuPages.filter(p => p.parent_page?.documentId === page.documentId)
}));

// Un lien est actif si le path courant correspond ou est un sous-path
const isActive = (pagePath: string) =>
  currentPath === pagePath || currentPath.startsWith(pagePath + '/');
---

<nav class="bg-white shadow-lg border-b border-gray-200" role="navigation" aria-label="Navigation principale">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo et nom de la mairie -->
      <div class="flex items-center">
        <a href="/" class="flex items-center space-x-3 text-gray-900 hover:text-primary transition-colors">
          {siteConfig?.logo?.data && (
            <StrapiImage
              image={siteConfig.logo.data}
              alt={`Logo ${siteConfig.name}`}
              width={40}
              height={40}
              class="h-10 w-auto"
              priority
            />
          )}
          <span class="font-bold text-xl">{siteConfig?.name}</span>
        </a>
      </div>

      <!-- Navigation desktop -->
      <div class="hidden md:block">
        <div class="ml-10 flex items-baseline space-x-4">
          <a
            href="/"
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
              currentPath === '/'
                ? 'bg-primary text-white'
                : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
            }`}
            aria-current={currentPath === '/' ? 'page' : undefined}
          >
            Accueil
          </a>

          {menuTree.map((page) => {
            const pagePath = '/' + getPagePath(page, menuPages);
            const active = isActive(pagePath);
            return page.children.length > 0 ? (
              <div class="relative group">
                <a
                  href={pagePath}
                  class={`inline-flex items-center gap-1 px-3 py-2 rounded-md text-sm font-medium transition-colors ${
                    active
                      ? 'bg-primary text-white'
                      : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
                  }`}
                  aria-current={active ? 'page' : undefined}
                >
                  {page.title}
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </a>
                <div class="absolute left-0 top-full hidden group-hover:block group-focus-within:block bg-white rounded-md shadow-lg border border-gray-200 min-w-48 z-50 py-1">
                  {page.children.map((child) => {
                    const childPath = '/' + getPagePath(child, menuPages);
                    const childActive = currentPath === childPath;
                    return (
                      <a
                        href={childPath}
                        class={`block px-4 py-2 text-sm transition-colors ${
                          childActive
                            ? 'bg-primary/10 text-primary font-medium'
                            : 'text-gray-700 hover:bg-gray-100 hover:text-primary'
                        }`}
                        aria-current={childActive ? 'page' : undefined}
                      >
                        {child.title}
                      </a>
                    );
                  })}
                </div>
              </div>
            ) : (
              <a
                href={pagePath}
                class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
                  active
                    ? 'bg-primary text-white'
                    : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
                }`}
                aria-current={active ? 'page' : undefined}
              >
                {page.title}
              </a>
            );
          })}

          <a
            href="/articles"
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
              currentPath.startsWith('/articles')
                ? 'bg-primary text-white'
                : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
            }`}
            aria-current={currentPath.startsWith('/articles') ? 'page' : undefined}
          >
            Actualités
          </a>

          <a
            href="/evenements"
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
              currentPath.startsWith('/evenements')
                ? 'bg-primary text-white'
                : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
            }`}
            aria-current={currentPath.startsWith('/evenements') ? 'page' : undefined}
          >
            Événements
          </a>

          <a
            href="/documents"
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
              currentPath.startsWith('/documents')
                ? 'bg-primary text-white'
                : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
            }`}
            aria-current={currentPath.startsWith('/documents') ? 'page' : undefined}
          >
            Documents
          </a>

          <a
            href="/equipe-municipale"
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
              currentPath.startsWith('/equipe-municipale')
                ? 'bg-primary text-white'
                : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
            }`}
            aria-current={currentPath.startsWith('/equipe-municipale') ? 'page' : undefined}
          >
            Équipe municipale
          </a>

          <a
            href="/associations"
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
              currentPath.startsWith('/associations')
                ? 'bg-primary text-white'
                : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
            }`}
            aria-current={currentPath.startsWith('/associations') ? 'page' : undefined}
          >
            Associations
          </a>

          {siteConfig?.open_data_enabled && (
            <a
              href="/open-data"
              class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
                currentPath.startsWith('/open-data')
                  ? 'bg-primary text-white'
                  : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
              }`}
              aria-current={currentPath.startsWith('/open-data') ? 'page' : undefined}
            >
              Open Data
            </a>
          )}
        </div>
      </div>

      <!-- Bouton hamburger pour mobile -->
      <div class="md:hidden">
        <button
          type="button"
          class="bg-gray-100 inline-flex items-center justify-center p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-primary"
          aria-controls="mobile-menu"
          aria-expanded="false"
          id="mobile-menu-button"
        >
          <span class="sr-only">Ouvrir le menu principal</span>
          <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Menu mobile -->
  <div class="md:hidden hidden" id="mobile-menu" role="menu" aria-orientation="vertical" aria-labelledby="mobile-menu-button">
    <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3 bg-gray-50 border-t border-gray-200">
      <a
        href="/"
        class={`block px-3 py-2 rounded-md text-base font-medium transition-colors ${
          currentPath === '/'
            ? 'bg-primary text-white'
            : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
        }`}
        role="menuitem"
      >
        Accueil
      </a>

      {menuTree.map((page) => {
        const pagePath = '/' + getPagePath(page, menuPages);
        const active = isActive(pagePath);
        return (
          <>
            <a
              href={pagePath}
              class={`block px-3 py-2 rounded-md text-base font-medium transition-colors ${
                active
                  ? 'bg-primary text-white'
                  : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
              }`}
              role="menuitem"
            >
              {page.title}
            </a>
            {page.children.map((child) => {
              const childPath = '/' + getPagePath(child, menuPages);
              const childActive = currentPath === childPath;
              return (
                <a
                  href={childPath}
                  class={`block pl-8 pr-3 py-2 rounded-md text-sm font-medium transition-colors ${
                    childActive
                      ? 'bg-primary/10 text-primary'
                      : 'text-gray-600 hover:bg-gray-100 hover:text-primary'
                  }`}
                  role="menuitem"
                >
                  {child.title}
                </a>
              );
            })}
          </>
        );
      })}

      <a
        href="/articles"
        class={`block px-3 py-2 rounded-md text-base font-medium transition-colors ${
          currentPath.startsWith('/articles')
            ? 'bg-primary text-white'
            : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
        }`}
        role="menuitem"
      >
        Actualités
      </a>

      <a
        href="/evenements"
        class={`block px-3 py-2 rounded-md text-base font-medium transition-colors ${
          currentPath.startsWith('/evenements')
            ? 'bg-primary text-white'
            : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
        }`}
        role="menuitem"
      >
        Événements
      </a>

      <a
        href="/documents"
        class={`block px-3 py-2 rounded-md text-base font-medium transition-colors ${
          currentPath.startsWith('/documents')
            ? 'bg-primary text-white'
            : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
        }`}
        role="menuitem"
      >
        Documents
      </a>

      <a
        href="/equipe-municipale"
        class={`block px-3 py-2 rounded-md text-base font-medium transition-colors ${
          currentPath.startsWith('/equipe-municipale')
            ? 'bg-primary text-white'
            : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
        }`}
        role="menuitem"
      >
        Équipe municipale
      </a>

      <a
        href="/associations"
        class={`block px-3 py-2 rounded-md text-base font-medium transition-colors ${
          currentPath.startsWith('/associations')
            ? 'bg-primary text-white'
            : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
        }`}
        role="menuitem"
      >
        Associations
      </a>

      {siteConfig?.open_data_enabled && (
        <a
          href="/open-data"
          class={`block px-3 py-2 rounded-md text-base font-medium transition-colors ${
            currentPath.startsWith('/open-data')
              ? 'bg-primary text-white'
              : 'text-gray-900 hover:bg-gray-100 hover:text-primary'
          }`}
          role="menuitem"
        >
          Open Data
        </a>
      )}
    </div>
  </div>
</nav>

<!-- Script pour le menu mobile -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', () => {
        const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';

        // Toggle du menu
        mobileMenu.classList.toggle('hidden');
        mobileMenuButton.setAttribute('aria-expanded', (!isExpanded).toString());

        // Changement de l'icône (hamburger <-> X)
        const icon = mobileMenuButton.querySelector('svg');
        if (icon) {
          if (isExpanded) {
            // Icône hamburger
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
          } else {
            // Icône X
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />';
          }
        }
      });

      // Fermer le menu quand on clique sur un lien (mobile)
      const mobileLinks = mobileMenu.querySelectorAll('a');
      mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.add('hidden');
          mobileMenuButton.setAttribute('aria-expanded', 'false');
          const icon = mobileMenuButton.querySelector('svg');
          if (icon) {
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
          }
        });
      });
    }
  });
</script>
