---
/** Page 404 : grand bloc sombre, « 404 » en grand, recherche et liens utiles. */
import type { PageContext } from '@communeo/theme-contract';
import { SECTIONS } from '@communeo/core';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext }
const { ctx } = Astro.props;
const links = [
  { href: '/', label: 'Accueil' },
  SECTIONS.demarches,
  SECTIONS.actualites,
  SECTIONS.agenda,
  SECTIONS.contact,
  { path: '/plan-du-site', label: 'Plan du site' },
].map((link) => ('path' in link ? { href: link.path, label: link.label } : link));
---
<Layout ctx={ctx} heading={false}>
  <div class="mo-404 mo-on-dark">
    <div>
      <p class="mo-404-code" aria-hidden="true">404</p>
      <h1>{ctx.title}</h1>
      <p class="mo-404-lead">Cette page n'existe pas ou a été déplacée. Le lien est peut-être ancien, ou l'adresse contient une erreur.</p>
    </div>
    <div class="mo-404-help">
      <form role="search" action="/recherche" class="mo-mega-search">
        <label for="mo-404-q" class="cn-sr-only">Rechercher sur le site</label>
        <input id="mo-404-q" name="q" type="search" placeholder="Rechercher sur le site…" />
        <button type="submit">Rechercher</button>
      </form>
      <h2 class="mo-eyebrow">Liens utiles</h2>
      <ul class="mo-404-links">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>
  </div>
</Layout>
