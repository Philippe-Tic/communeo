{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "content": {
      "type": "richtext",
      "required": true
    },
    "meta_description": {
      "type": "string",
      "maxLength": 160
    },
    "featured_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "menu_order": {
      "type": "integer",
      "default": 0
    },
    "show_in_menu": {
      "type": "boolean",
      "default": true
    },
    "template": {
      "type": "enumeration",
      "enum": [
        "default",
        "about",
        "services"
      ],
      "default": "default"
    },
    "scheduled_at": {
      "type": "datetime"
    },
    "seo_keywords": {
      "type": "string",
      "maxLength": 255
    },
    "site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site",
      "inversedBy": "pages",
      "required": true
    }
  }
}
