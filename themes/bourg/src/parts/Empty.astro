---
/** État vide : encart arrondi, titre, explication et action facultative. */
interface Props {
  title: string;
  action?: { label: string; href: string } | null;
  tone?: 'light' | 'dark';
}

const { title, action = null, tone = 'light' } = Astro.props;
---
<div class:list={['bo-empty', { 'bo-empty-dark bo-on-dark': tone === 'dark' }]} role="status">
  <h2 class="bo-empty-title">{title}</h2>
  <p><slot /></p>
  {action && <a href={action.href} class="bo-button">{action.label}</a>}
</div>
