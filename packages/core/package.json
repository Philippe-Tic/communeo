{
  "name": "@communeo/core",
  "version": "0.0.0",
  "private": true,
  "description": "Types Strapi générés, client API, view-models et schémas de blocs partagés (backend, admin, renderer).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "gen:types": "tsx scripts/generate-strapi-types.ts",
    "lint": "eslint src scripts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "vitest": "^3.2.4",
    "tsx": "^4.20.5",
    "@types/node": "^22.18.6",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "zod": "^4.1.11"
  },
  "sideEffects": false
}
