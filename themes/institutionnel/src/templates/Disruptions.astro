---
/** Perturbations : une fiche par perturbation, sévérité portée par l'icône et le libellé. */
import type { AlertVM } from '@communeo/core';
import type { PageContext } from '@communeo/theme-contract';
import Info from '@lucide/astro/icons/info';
import OctagonAlert from '@lucide/astro/icons/octagon-alert';
import TriangleAlert from '@lucide/astro/icons/triangle-alert';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; alerts: AlertVM[] }
const { ctx, alerts } = Astro.props;
const icons = { info: Info, warning: TriangleAlert, critical: OctagonAlert };
---
<Layout ctx={ctx}>
  {alerts.length ? (
    <ul class="in-disruptions">
      {alerts.map((alert) => {
        const Icon = icons[alert.severity.key];
        return (
          <li class={`in-disruption in-alert-${alert.severity.key}`}>
            <Icon size={26} aria-hidden="true" />
            <div>
              <p class="in-disruption-kind">{alert.severity.label}{alert.type && <> · {alert.type.label}</>}</p>
              <h2 class="in-disruption-title">{alert.title}</h2>
              <p>{alert.message}</p>
              <p class="in-meta">
                {alert.period}
                {(alert.area || alert.location) && <>{alert.period && ' · '}Secteur : {alert.area ?? alert.location}</>}
              </p>
              {alert.link && (
                <p>
                  <a href={alert.link.href} target={alert.link.external ? '_blank' : undefined} rel={alert.link.external ? 'noopener noreferrer' : undefined}>
                    {alert.link.label}{alert.link.external && <span class="cn-sr-only"> (nouvelle fenêtre)</span>}
                  </a>
                </p>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  ) : (
    <p class="in-empty">Aucune perturbation en cours sur la commune.</p>
  )}
</Layout>
