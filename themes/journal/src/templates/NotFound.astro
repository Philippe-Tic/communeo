---
/** Page 404 : « 404 » en grand, recherche et liens utiles sur filets. */
import type { PageContext } from '@communeo/theme-contract';
import { SECTIONS } from '@communeo/core';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext }
const { ctx } = Astro.props;
const links = [
  { href: '/', label: 'Accueil' },
  SECTIONS.demarches,
  SECTIONS.actualites,
  SECTIONS.agenda,
  SECTIONS.contact,
  { path: '/plan-du-site', label: 'Plan du site' },
].map((link) => ('path' in link ? { href: link.path, label: link.label } : link));
---
<Layout ctx={ctx} heading={false}>
  <div class="jo-404">
    <p class="jo-404-code" aria-hidden="true">404</p>
    <h1>{ctx.title}</h1>
    <p class="jo-lead">Cette page n'existe pas ou a été déplacée. Le lien est peut-être ancien, ou l'adresse contient une erreur.</p>
    <form role="search" action="/recherche" class="jo-404-search">
      <label for="jo-404-q" class="cn-sr-only">Rechercher sur le site</label>
      <input id="jo-404-q" name="q" type="search" placeholder="Rechercher sur le site…" />
      <button type="submit" class="jo-button">Rechercher</button>
    </form>
    <div class="jo-section-head"><h2>Liens utiles</h2></div>
    <ul class="jo-404-links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </div>
</Layout>
