---
/** Partage : liens simples ; « Copier le lien » n'apparaît qu'avec JavaScript. */
import Copy from '@lucide/astro/icons/copy';
import Mail from '@lucide/astro/icons/mail';
import Share2 from '@lucide/astro/icons/share-2';

interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encoded = encodeURIComponent(url);
const subject = encodeURIComponent(title);
---
<p class="in-share">
  <span class="in-share-label"><Share2 size={20} aria-hidden="true" />Partager :</span>
  <a href={`https://www.facebook.com/sharer/sharer.php?u=${encoded}`} target="_blank" rel="noopener noreferrer">
    Facebook<span class="cn-sr-only"> (nouvelle fenêtre)</span>
  </a>
  <a href={`mailto:?subject=${subject}&body=${encoded}`}><Mail size={18} aria-hidden="true" />Par e-mail</a>
  <button type="button" class="in-share-copy" data-in-copy={url}>
    <Copy size={18} aria-hidden="true" />Copier le lien
  </button>
  <span class="cn-sr-only" role="status" data-in-copy-status></span>
</p>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-in-copy]')) {
    button.addEventListener('click', async () => {
      const status = document.querySelector<HTMLElement>('[data-in-copy-status]');
      try {
        await navigator.clipboard.writeText(button.dataset.inCopy!);
        if (status) status.textContent = 'Lien copié dans le presse-papiers.';
      } catch {
        if (status) status.textContent = "La copie a échoué : le lien est dans la barre d'adresse.";
      }
    });
  }
</script>
