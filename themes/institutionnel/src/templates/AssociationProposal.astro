---
import type { FormConfig } from '@communeo/theme-contract';
import type { PageContext } from '@communeo/theme-contract';
import Layout from '../parts/Layout.astro';
import ApiForm from '../parts/ApiForm.astro';

interface Props { ctx: PageContext; form: FormConfig }
const { ctx, form } = Astro.props;
---
<Layout ctx={ctx}>
  <p>Votre association n'est pas encore référencée ? Proposez-la : la mairie la publiera après vérification.</p>
  <ApiForm form={form} submitLabel="Proposer l'association" success="Merci ! Votre proposition sera examinée par la mairie.">
    <p><label for="as-name">Nom de l'association (obligatoire)</label><input id="as-name" name="name" required autocomplete="organization" /></p>
    <p><label for="as-category">Catégorie (obligatoire)</label>
      <select id="as-category" name="category" required>{(form.options ?? []).map((o) => <option value={o.key}>{o.label}</option>)}</select></p>
    <p><label for="as-description">Présentation</label><textarea id="as-description" name="description" rows="5"></textarea></p>
    <p><label for="as-submitter">Votre nom (obligatoire)</label><input id="as-submitter" name="submitted_by_name" required autocomplete="name" /></p>
    <p><label for="as-email">Votre e-mail (obligatoire)</label><input id="as-email" name="submitted_by_email" type="email" required autocomplete="email" /></p>
    <p class="in-meta">Vos coordonnées servent uniquement à traiter cette proposition. <a href="/donnees-personnelles">En savoir plus</a></p>
  </ApiForm>
</Layout>
