{
  "name": "@communeo/ui-a11y",
  "version": "0.0.0",
  "private": true,
  "description": "Composants Astro accessibles partagés par les thèmes : texte riche, blocs, liens d'évitement, fil d'Ariane, consentement, statut d'ouverture, scripts de comportement.",
  "type": "module",
  "exports": {
    "./search": "./src/search.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "astro check --root . --tsconfig tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@communeo/core": "workspace:*",
    "@communeo/theme-contract": "workspace:*"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
