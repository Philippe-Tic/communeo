---
/** Article : métadonnées, chapô, image, blocs, partage et autres actualités. */
import type { ArticleVM } from '@communeo/core';
import type { PageContext } from '@communeo/theme-contract';
import Blocks from '@communeo/ui-a11y/Blocks.astro';
import { blocks as components } from '../blocks/index';
import ArticleCard from '../parts/ArticleCard.astro';
import Layout from '../parts/Layout.astro';
import Share from '../parts/Share.astro';

interface Props { ctx: PageContext; article: ArticleVM }
const { ctx, article } = Astro.props;
---
<Layout ctx={ctx} heading={false}>
  <article class="in-article">
    <p class="in-card-meta">
      <span class="in-tag">{article.category.label}</span>
      <time datetime={article.date.iso}>Publié le {article.date.label}</time>
      {article.author && <span>· {article.author}</span>}
    </p>
    <h1>{article.title}</h1>
    {article.summary && <p class="in-lead">{article.summary}</p>}
    {article.image && (
      <figure class="in-cover">
        <img src={article.image.src} srcset={article.image.srcset ?? undefined} alt={article.image.alt} width={article.image.width ?? undefined} height={article.image.height ?? undefined} />
        {(article.image.caption || article.image.credit) && (
          <figcaption>{article.image.caption}{article.image.credit && <> Crédit : {article.image.credit}</>}</figcaption>
        )}
      </figure>
    )}
    <div class="in-blocks"><Blocks blocks={article.blocks} components={components} /></div>
    <Share title={article.title} url={`${ctx.site.url}${article.href}`} />
  </article>

  {article.related.length > 0 && (
    <section class="in-related" aria-labelledby="in-related-title">
      <h2 id="in-related-title">Autres actualités</h2>
      <div class="in-grid-3">{article.related.slice(0, 3).map((other) => <ArticleCard article={other} />)}</div>
    </section>
  )}
</Layout>
