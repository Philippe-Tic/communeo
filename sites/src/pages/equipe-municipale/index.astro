---
import type { TeamMember } from '../../types/strapi';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import StrapiImage from '../../components/StrapiImage.astro';
import { getTeamMembers } from '../../utils/strapi';
import { slugifyUnique } from '../../utils/slugify';

let teamMembers: TeamMember[] = [];

try {
  teamMembers = await getTeamMembers();
} catch (error) {
  console.error('Erreur lors de la récupération des membres:', error);
}

const ROLE_LABELS: Record<string, string> = {
  maire: 'Maire',
  adjoint: 'Adjoint(e)',
  conseiller: 'Conseiller(e) municipal(e)',
  dgs: 'Directeur Général des Services',
  agent: 'Agent municipal',
};

const ROLE_COLORS: Record<string, string> = {
  maire: 'bg-purple-100 text-purple-800',
  adjoint: 'bg-blue-100 text-blue-800',
  conseiller: 'bg-green-100 text-green-800',
  dgs: 'bg-orange-100 text-orange-800',
  agent: 'bg-gray-100 text-gray-800',
};

const ROLE_ORDER = ['maire', 'adjoint', 'conseiller', 'dgs', 'agent'];

const ROLE_SECTION_TITLES: Record<string, string> = {
  maire: 'Maire',
  adjoint: 'Adjoints au Maire',
  conseiller: 'Conseillers municipaux',
  dgs: 'Direction Générale',
  agent: 'Agents municipaux',
};

// Générer les slugs (même ordre que getStaticPaths de [slug].astro)
const slugsByDocumentId = new Map<string, string>();
const usedSlugs = new Set<string>();
for (const m of teamMembers) {
  slugsByDocumentId.set(m.documentId, slugifyUnique(`${m.first_name} ${m.last_name}`, usedSlugs));
}

// Grouper les membres par rôle
const membersByRole = ROLE_ORDER
  .map(role => ({
    role,
    title: ROLE_SECTION_TITLES[role],
    members: teamMembers.filter(m => m.role === role),
  }))
  .filter(group => group.members.length > 0);
---

<Layout
  title="Équipe municipale"
  description="Découvrez les élus et agents de votre mairie : maire, adjoints, conseillers municipaux et services administratifs."
>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <main id="main-content" data-pagefind-body>
    <Breadcrumb items={[{ label: 'Équipe municipale' }]} />

    <!-- Header -->
    <header class="bg-gradient-to-br from-primary to-primary/80 text-on-primary py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4">
            Équipe municipale
          </h1>
          <p class="text-lg sm:text-xl text-on-primary/80 max-w-3xl mx-auto">
            Découvrez les élus et agents qui administrent votre commune
          </p>
        </div>
      </div>
    </header>

    <!-- Membres par rôle -->
    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {membersByRole.length > 0 ? (
          <div class="space-y-16">
            {membersByRole.map((group) => (
              <div>
                <h2 class="text-2xl font-bold text-gray-900 mb-8 border-l-4 border-primary pl-4">
                  {group.title}
                </h2>

                <div class={`grid gap-8 ${
                  group.role === 'maire'
                    ? 'grid-cols-1 max-w-md mx-auto'
                    : 'grid-cols-1 md:grid-cols-2 lg:grid-cols-3'
                }`}>
                  {group.members.map((member) => (
                    <article class="bg-white rounded-xl border border-gray-100 overflow-hidden hover:border-primary/30 hover:shadow-lg transition-all">
                      {member.photo && (
                        <div class="aspect-[3/4] overflow-hidden">
                          <StrapiImage
                            image={member.photo}
                            alt={`${member.first_name} ${member.last_name}`}
                            width={400}
                            height={533}
                            widths={[200, 400]}
                            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                            class={`w-full h-full object-cover ${group.role === 'maire' ? 'rounded-b-none' : ''}`}
                          />
                        </div>
                      )}

                      <div class="p-6">
                        <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium mb-3 ${
                          ROLE_COLORS[member.role] || 'bg-gray-100 text-gray-800'
                        }`}>
                          {ROLE_LABELS[member.role] || member.role}
                        </span>

                        <h3 class="text-xl font-semibold text-gray-900 mb-1">
                          <a href={`/equipe-municipale/${slugsByDocumentId.get(member.documentId)}`} class="hover:text-primary-text transition-colors">
                            {member.first_name} {member.last_name}
                          </a>
                        </h3>

                        {member.delegation && (
                          <p class="text-primary-text font-medium text-sm mb-3">
                            {member.delegation}
                          </p>
                        )}

                        {member.bio && (
                          <p class="text-gray-600 text-sm leading-relaxed">
                            {member.bio}
                          </p>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Aucun membre de l'équipe</h2>
            <p class="text-gray-600">
              Les informations sur l'équipe municipale seront publiées prochainement.
            </p>
          </div>
        )}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
