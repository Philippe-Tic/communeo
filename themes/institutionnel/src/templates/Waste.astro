---
/** Collecte des déchets : prochaines collectes en cartes, puis calendrier détaillé. */
import type { WasteCollectionVM } from '@communeo/core';
import type { PageContext } from '@communeo/theme-contract';
import NextCollections from '@communeo/ui-a11y/NextCollections.astro';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; collections: WasteCollectionVM[]; notes: string | null }
const { ctx, collections, notes } = Astro.props;
---
<Layout ctx={ctx}>
  {notes && <p class="in-lead">{notes}</p>}
  {collections.length ? (
    <>
      <section aria-labelledby="in-waste-next">
        <h2 id="in-waste-next">Prochaines collectes</h2>
        <ul class="in-waste-cards">
          {collections.map((collection) => (
            <li class="in-box">
              <p><span class={`in-waste-badge in-waste-${collection.key}`} aria-hidden="true">{collection.abbreviation}</span></p>
              <h3 class="in-box-title">{collection.label}</h3>
              {collection.upcoming.length > 0 ? (
                <>
                  <p class="in-meta">Prochaine collecte</p>
                  <p class="in-waste-date"><NextCollections collection={collection} /></p>
                </>
              ) : (
                <p class="in-waste-date">{collection.day ? 'Hors saison' : collection.frequency.label}</p>
              )}
              {collection.day && <p class="in-meta">{collection.frequency.label}, le {collection.day.label}</p>}
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="in-waste-calendar">
        <h2 id="in-waste-calendar">Calendrier par type</h2>
        <div class="in-table-wrapper">
          <table class="in-table">
            <caption class="cn-sr-only">Jours, fréquences et zones de collecte</caption>
            <thead>
              <tr><th scope="col">Type</th><th scope="col">Jour</th><th scope="col">Fréquence</th><th scope="col">Zone</th><th scope="col">À savoir</th></tr>
            </thead>
            <tbody>
              {collections.map((collection) => (
                <tr>
                  <th scope="row">
                    <span class="in-waste-row">
                      <span class={`in-waste-badge in-waste-${collection.key}`} aria-hidden="true">{collection.abbreviation}</span>
                      {collection.label}
                    </span>
                  </th>
                  <td data-label="Jour">{collection.day?.label ?? '—'}</td>
                  <td data-label="Fréquence">{collection.frequency.label}</td>
                  <td data-label="Zone">{collection.zone ?? 'Toute la commune'}</td>
                  <td data-label="À savoir">{collection.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
  ) : (
    <p class="in-empty">Le calendrier de collecte sera bientôt publié.</p>
  )}
</Layout>
