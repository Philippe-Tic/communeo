---
import type { Event } from '../../types/strapi';
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import StrapiImage from '../../components/StrapiImage.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getEvents, formatDate, stripHtmlTags } from '../../utils/strapi';

// Récupération de tous les événements
let events: Event[] = [];

try {
  events = await getEvents();
} catch (error) {
  console.error('Erreur lors de la récupération des événements:', error);
}

// JSON-LD BreadcrumbList
const siteOrigin = Astro.site?.toString()?.replace(/\/$/, '') || Astro.url.origin;
const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": siteOrigin },
    { "@type": "ListItem", "position": 2, "name": "Événements" }
  ]
});
---

<Layout
  title="Événements"
  description="Découvrez tous les événements organisés par votre mairie : festivals, manifestations, réunions publiques et activités communales."
>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <script type="application/ld+json" set:html={breadcrumbJsonLd} />

  <main id="main-content" data-pagefind-body>
    <Breadcrumb items={[
      { label: 'Événements' }
    ]} />

    <Hero title="Événements" subtitle="Découvrez tous les événements organisés par votre mairie" />

    <!-- Liste des événements -->
    <Section>
        {events.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {events.map((event) => {
              const eventDate = new Date(event.start_date);
              const day = eventDate.getDate();
              const month = eventDate.toLocaleDateString('fr-FR', { month: 'short' }).toUpperCase();
              return (
                <article class="relative bg-white rounded-xl border border-gray-100 overflow-hidden hover:border-primary/30 hover:shadow-lg hover:-translate-y-0.5 transition-all">
                  {event.image && (
                    <div class="relative aspect-[16/9] overflow-hidden">
                      <StrapiImage
                        image={event.image}
                        alt={event.title}
                        width={400}
                        height={225}
                        widths={[320, 400, 640, 800]}
                        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                        class="w-full h-full object-cover"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent" />
                      {/* Date badge overlay */}
                      <div class="absolute top-3 left-3 bg-white rounded-lg shadow-sm px-2.5 py-1.5 text-center">
                        <span class="text-lg font-bold text-primary-text leading-none block">{day}</span>
                        <span class="text-[10px] font-medium text-primary-text/70 uppercase">{month}</span>
                      </div>
                    </div>
                  )}

                  <div class="p-5">
                    <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium mb-2 ${
                      event.category === 'cultural' ? 'bg-purple-100 text-purple-800' :
                      event.category === 'sport' ? 'bg-green-100 text-green-800' :
                      event.category === 'meeting' ? 'bg-blue-100 text-blue-800' :
                      event.category === 'celebration' ? 'bg-yellow-100 text-yellow-800' :
                      'bg-gray-100 text-gray-800'
                    }`}>
                      {event.category === 'cultural' ? 'Culturel' :
                       event.category === 'sport' ? 'Sport' :
                       event.category === 'meeting' ? 'Réunion' :
                       event.category === 'celebration' ? 'Fête' :
                       'Atelier'}
                    </span>

                    <h2 class="text-lg font-bold text-gray-900 mb-2">
                      <a href={`/evenements/${event.slug}`} class="hover:text-primary-text transition-colors card-link">
                        {event.title}
                      </a>
                    </h2>

                    {!event.image && (
                      <div class="text-sm text-gray-500 mb-2">
                        <time datetime={event.start_date}>
                          {formatDate(event.start_date)}
                        </time>
                      </div>
                    )}

                    {event.location && (
                      <div class="flex items-center gap-1.5 text-sm text-gray-500 mb-3">
                        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                        </svg>
                        {event.location}
                      </div>
                    )}

                    {event.description && (
                      <p class="text-gray-600 text-sm line-clamp-3 mb-4">
                        {stripHtmlTags(event.description).substring(0, 150)}...
                      </p>
                    )}

                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="text-center py-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-4">Aucun événement programmé</h2>
            <p class="text-gray-600">
              Les événements seront annoncés ici dès qu'ils seront programmés.
            </p>
          </div>
        )}
    </Section>
  </main>

  <Footer />
</Layout>

<style>
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
</style>
