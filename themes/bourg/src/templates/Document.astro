---
/** Document officiel : type et référence, dates, description, téléchargement en carte, annexes. */
import type { DocumentVM } from '@communeo/core';
import type { PageContext } from '@communeo/theme-contract';
import Download from '@lucide/astro/icons/download';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; document: DocumentVM }
const { ctx, document: doc } = Astro.props;
const type = (label: string) => label.split(' – ')[0];
const size = (label: string) => label.split(' – ')[1] ?? '';
---
<Layout ctx={ctx} heading={false}>
  <article class="bo-doc">
    <p class="bo-kicker">{doc.type.label}{doc.reference && <> · {doc.reference}</>}</p>
    <h1>{doc.title}</h1>
    <p class="bo-doc-dates">
      {doc.sessionDate && <>Séance du {doc.sessionDate.label} · </>}publié le <time datetime={doc.date.iso}>{doc.date.label}</time>
    </p>
    {doc.description && <p class="bo-doc-description">{doc.description}</p>}
    {doc.file && (
      <a href={doc.file.href} class="bo-document-single bo-doc-file" download>
        <span class="bo-document-icon" aria-hidden="true"><Download size={22} /></span>
        <span><strong class="bo-document-name">Télécharger le document</strong><span class="bo-document-meta">{doc.file.label}</span></span>
      </a>
    )}
    {doc.attachments.length > 0 && (
      <section aria-labelledby="bo-annexes" class="bo-documents">
        <h2 id="bo-annexes" class="bo-annexes-title">Annexes</h2>
        <ul class="bo-document-list">
          {doc.attachments.map((file) => (
            <li>
              <a href={file.href} download>
                <span class="bo-document-type" aria-hidden="true">{type(file.label)}</span>
                <span class="bo-document-name">{file.name}</span>
                <span class="bo-document-meta"><span class="cn-sr-only">{type(file.label)} – </span>{size(file.label)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Layout>
