---
/** Pied de page réduit, dans la colonne de contenu : mairie, horaires, liens utiles, réseaux, liens légaux. */
import type { PageContext } from '@communeo/theme-contract';

interface Props {
  ctx: PageContext;
}

const { site, nav } = Astro.props.ctx;
---
<footer class="jo-footer">
  <div class="jo-footer-grid">
    <section aria-labelledby="jo-footer-mairie">
      <h2 id="jo-footer-mairie" class="jo-footer-name">Mairie de {site.name}</h2>
      <address>
        {site.contact.address && <span>{site.contact.address}</span>}
        {site.contact.phone && <a href={site.contact.phone.href} class="jo-footer-phone">{site.contact.phone.label}</a>}
        <a href={site.contact.email.href} class="jo-footer-email">{site.contact.email.label}</a>
      </address>
    </section>

    {site.contact.hoursSummary.length > 0 && (
      <section aria-labelledby="jo-footer-hours">
        <h2 id="jo-footer-hours" class="jo-kicker">Horaires</h2>
        <dl class="jo-footer-hours">
          {site.contact.hoursSummary.map((line) => <div><dt>{line.days}</dt><dd>{line.hours}</dd></div>)}
        </dl>
      </section>
    )}

    {nav.footer.length > 0 && (
      <nav aria-labelledby="jo-footer-links">
        <h2 id="jo-footer-links" class="jo-kicker">Liens utiles</h2>
        <ul class="jo-footer-list">
          {nav.footer.map((link) => (
            <li>
              <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                {link.label}{link.external && <span class="cn-sr-only"> (nouvelle fenêtre)</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {site.social.length > 0 && (
      <section aria-labelledby="jo-footer-social">
        <h2 id="jo-footer-social" class="jo-kicker">Suivre la commune</h2>
        <ul class="jo-footer-social">
          {site.social.map((link) => (
            <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}<span class="cn-sr-only"> (nouvelle fenêtre)</span></a></li>
          ))}
        </ul>
      </section>
    )}
  </div>

  <ul class="jo-footer-legal" aria-label="Informations légales">
    {nav.legal.map((link) => (
      <li><a href={link.href} data-cn-cookie-preferences={link.href === '/gestion-des-cookies' ? '' : undefined}>{link.label}</a></li>
    ))}
  </ul>
</footer>
