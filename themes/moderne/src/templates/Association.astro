---
/** Association : catégorie, logo et nom, présentation, carte de contact. */
import type { AssociationVM } from '@communeo/core';
import type { PageContext } from '@communeo/theme-contract';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; association: AssociationVM }
const { ctx, association } = Astro.props;
---
<Layout ctx={ctx} heading={false}>
  <article class="mo-asso">
    <div class="mo-asso-head">
      {association.logo && (
        <img class="mo-asso-logo mo-asso-logo-large" src={association.logo.src} alt="" width={association.logo.width ?? undefined} height={association.logo.height ?? undefined} />
      )}
      <div>
        <span class="mo-chip-label mo-chip-info">{association.category.label}</span>
        <h1>{association.name}</h1>
      </div>
    </div>
    {association.description && <p class="mo-lead">{association.description}</p>}

    <section class="mo-facts-card" aria-labelledby="mo-asso-contact">
      <h2 id="mo-asso-contact" class="mo-eyebrow">Contact</h2>
      <dl class="mo-facts">
        {association.contact.name && <div><dt>Interlocuteur</dt><dd>{association.contact.name}</dd></div>}
        {association.contact.email && <div><dt>E-mail</dt><dd><a href={association.contact.email.href}>{association.contact.email.label}</a></dd></div>}
        {association.contact.phone && <div><dt>Téléphone</dt><dd><a href={association.contact.phone.href}>{association.contact.phone.label}</a></dd></div>}
        {association.address && <div><dt>Adresse</dt><dd>{association.address}</dd></div>}
        {association.website && (
          <div>
            <dt>Site internet</dt>
            <dd><a href={association.website.href} target="_blank" rel="noopener noreferrer">{association.website.label}<span class="cn-sr-only"> (nouvelle fenêtre)</span></a></dd>
          </div>
        )}
      </dl>
    </section>
  </article>
</Layout>
