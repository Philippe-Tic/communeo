# File des builds (pg-boss) : Postgres, par exemple `docker compose up postgres`
QUEUE_DATABASE_URL=postgres://strapi:strapi@localhost:5432/strapi

# Strapi : routes internes et données des communes
STRAPI_URL=http://localhost:1337
STRAPI_PUBLIC_URL=http://localhost:1337
# Token en lecture seule créé par Strapi au premier démarrage (« Build Token »)
STRAPI_API_TOKEN=
# Même valeur que WORKER_SECRET côté Strapi
WORKER_SECRET=

# Hébergeur : sans jeton, les builds échouent à la publication
NETLIFY_TOKEN=
# Adresse Communeo des sites, <slug>.<SITES_DOMAIN> (zone DNS gérée par Netlify, même valeur que Strapi)
# SITES_DOMAIN=communeo.fr
# Sans NETLIFY_TOKEN : sites écrits dans un dossier (PUBLISH_DIR/<slug>/, avec leurs règles Caddy dans
# .regles/site.caddy), servis sous PUBLISH_BASE_URL ; CADDY_ADMIN_URL : Caddy rechargé après chaque publication
# PUBLISH_DIR=/tmp/communeo-sites
# PUBLISH_BASE_URL=http://localhost:8080
# CADDY_ADMIN_URL=http://localhost:2019

# Facultatif
# BUILD_TIMEOUT_SECONDS=600
# Pages changées signalées aux moteurs (IndexNow, clé dérivée de WORKER_SECRET) ; off pour ne rien signaler
# INDEXNOW=off
# WORK_DIR=/tmp/communeo-builds
# RENDERER_DIR=../renderer
