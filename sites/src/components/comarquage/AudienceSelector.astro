---
interface Props {
  audiences: string[]
}

const { audiences } = Astro.props

const labels: Record<string, string> = {
  particuliers: 'Particuliers',
  professionnels: 'Professionnels',
}
---

<div class="flex gap-2 mt-6" role="tablist" aria-label="Type de public">
  {audiences.map((audience, index) => (
    <button
      type="button"
      role="tab"
      aria-selected={index === 0 ? 'true' : 'false'}
      data-audience-tab={audience}
      class:list={[
        'px-5 py-2.5 rounded-lg text-sm font-medium transition-all',
        index === 0
          ? 'bg-primary text-on-primary shadow-sm'
          : 'bg-gray-100 text-gray-600 hover:bg-gray-200',
      ]}
    >
      {labels[audience] ?? audience}
    </button>
  ))}
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('[data-audience-tab]')
    const panels = document.querySelectorAll<HTMLElement>('[data-audience-content]')

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const audience = tab.dataset.audienceTab

        // Update tabs
        tabs.forEach((t) => {
          const isActive = t.dataset.audienceTab === audience
          t.setAttribute('aria-selected', String(isActive))
          t.classList.toggle('bg-primary', isActive)
          t.classList.toggle('text-on-primary', isActive)
          t.classList.toggle('shadow-sm', isActive)
          t.classList.toggle('bg-gray-100', !isActive)
          t.classList.toggle('text-gray-600', !isActive)
          t.classList.toggle('hover:bg-gray-200', !isActive)
        })

        // Update panels
        panels.forEach((panel) => {
          panel.classList.toggle('hidden', panel.dataset.audienceContent !== audience)
        })
      })
    })
  })
</script>
