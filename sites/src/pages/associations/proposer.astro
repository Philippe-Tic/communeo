---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import { getSiteConfig } from '../../utils/strapi';

const siteConfig = await getSiteConfig();
const strapiUrl = import.meta.env.STRAPI_PUBLIC_URL;
const siteDocumentId = import.meta.env.SITE_DOCUMENT_ID;
---

<Layout title="Proposer une association" description={`Proposez une association à référencer dans l'annuaire de la ${siteConfig.name}`}>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <main id="main-content">
    <header class="bg-gradient-to-br from-primary to-primary/80 text-on-primary py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4">Proposer une association</h1>
          <p class="text-lg sm:text-xl text-on-primary/80 max-w-3xl mx-auto">
            Vous souhaitez référencer votre association dans l'annuaire communal ? Remplissez le formulaire ci-dessous.
          </p>
        </div>
      </div>
    </header>

    <section class="py-12">
      <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
        <div id="form-container">
          <form id="association-form" class="space-y-6" novalidate>
            <!-- Honeypot anti-spam -->
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <label for="fax_number">Ne pas remplir</label>
              <input type="text" id="fax_number" name="fax_number" tabindex="-1" autocomplete="off" />
            </div>

            <input type="hidden" name="site" value={siteDocumentId} />

            <!-- Informations sur l'association -->
            <div>
              <h2 class="text-lg font-semibold text-gray-900 mb-4">Informations sur l'association</h2>

              <div class="space-y-4">
                <div>
                  <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
                    Nom de l'association <span class="text-red-500">*</span>
                  </label>
                  <input type="text" id="name" name="name" required maxlength="200"
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                </div>

                <div>
                  <label for="category" class="block text-sm font-medium text-gray-700 mb-1">
                    Catégorie <span class="text-red-500">*</span>
                  </label>
                  <select id="category" name="category" required
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary">
                    <option value="">-- Choisir une catégorie --</option>
                    <option value="sport">Sport</option>
                    <option value="culture">Culture</option>
                    <option value="social">Social</option>
                    <option value="environnement">Environnement</option>
                    <option value="education">Éducation</option>
                    <option value="autre">Autre</option>
                  </select>
                </div>

                <div>
                  <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                  <textarea id="description" name="description" rows="4"
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                    placeholder="Décrivez brièvement les activités de l'association..."></textarea>
                </div>

                <div>
                  <label for="logo" class="block text-sm font-medium text-gray-700 mb-1">Logo de l'association (optionnel)</label>
                  <input type="file" id="logo" name="logo" accept="image/png,image/jpeg,image/webp"
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary file:mr-3 file:rounded-md file:border-0 file:bg-primary-text/10 file:px-3 file:py-1 file:text-sm file:font-medium file:text-primary-text" />
                  <p class="mt-1 text-xs text-gray-500">PNG, JPEG ou WebP. 2 Mo maximum.</p>
                  <div id="logo-preview" class="hidden mt-2">
                    <img id="logo-preview-img" src="" alt="Aperçu du logo" class="h-20 w-20 object-contain rounded-md border border-gray-200" />
                  </div>
                </div>
              </div>
            </div>

            <!-- Coordonnées de l'association -->
            <div>
              <h2 class="text-lg font-semibold text-gray-900 mb-4">Coordonnées de l'association</h2>

              <div class="space-y-4">
                <div>
                  <label for="contact_name" class="block text-sm font-medium text-gray-700 mb-1">Personne de contact</label>
                  <input type="text" id="contact_name" name="contact_name" maxlength="100"
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="contact_email" class="block text-sm font-medium text-gray-700 mb-1">Email de l'association</label>
                    <input type="email" id="contact_email" name="contact_email"
                      class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                  </div>
                  <div>
                    <label for="contact_phone" class="block text-sm font-medium text-gray-700 mb-1">Téléphone</label>
                    <input type="tel" id="contact_phone" name="contact_phone" maxlength="20"
                      class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                  </div>
                </div>

                <div>
                  <label for="website" class="block text-sm font-medium text-gray-700 mb-1">Site web</label>
                  <input type="url" id="website" name="website" maxlength="500" placeholder="https://..."
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                </div>

                <div>
                  <label for="address" class="block text-sm font-medium text-gray-700 mb-1">Adresse</label>
                  <textarea id="address" name="address" rows="2"
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"></textarea>
                </div>
              </div>
            </div>

            <!-- Vos coordonnées -->
            <div>
              <h2 class="text-lg font-semibold text-gray-900 mb-4">Vos coordonnées</h2>
              <p class="text-sm text-gray-500 mb-4">Ces informations ne seront pas publiées et servent uniquement au traitement de votre demande.</p>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="submitted_by_name" class="block text-sm font-medium text-gray-700 mb-1">
                    Votre nom <span class="text-red-500">*</span>
                  </label>
                  <input type="text" id="submitted_by_name" name="submitted_by_name" required maxlength="100"
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                </div>
                <div>
                  <label for="submitted_by_email" class="block text-sm font-medium text-gray-700 mb-1">
                    Votre email <span class="text-red-500">*</span>
                  </label>
                  <input type="email" id="submitted_by_email" name="submitted_by_email" required
                    class="w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
                </div>
              </div>
            </div>

            <!-- RGPD consent -->
            <div class="flex items-start gap-2">
              <input type="checkbox" id="rgpd_consent" name="rgpd_consent" required
                class="mt-1 h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary" />
              <label for="rgpd_consent" class="text-sm text-gray-600">
                J'accepte que mes données soient traitées conformément à la <a href="/politique-confidentialite" class="text-primary-text underline hover:text-primary-text/80">politique de confidentialité</a>. <span class="text-red-500">*</span>
              </label>
            </div>

            <div id="form-error" class="hidden rounded-md bg-red-50 border border-red-200 p-4 text-sm text-red-700"></div>

            <button type="submit" id="submit-btn"
              class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-3 text-sm font-medium text-on-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
              Envoyer ma proposition
            </button>
          </form>
        </div>

        <!-- Message de confirmation -->
        <div id="form-success" class="hidden rounded-md bg-green-50 border border-green-200 p-6">
          <div class="flex items-start gap-3">
            <svg class="h-6 w-6 text-green-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <div>
              <h3 class="text-lg font-semibold text-green-800">Proposition enregistrée</h3>
              <p class="mt-1 text-green-700">
                Votre proposition d'association a bien été enregistrée. Elle sera examinée par la mairie avant d'être publiée dans l'annuaire.
              </p>
              <a href="/associations" class="mt-4 inline-block text-sm text-green-700 underline hover:text-green-900">
                Retour à l'annuaire
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script define:vars={{ strapiUrl }}>
  (function() {
    const form = document.getElementById('association-form');
    if (!form) return;

    // Logo preview
    const logoInput = document.getElementById('logo');
    const logoPreview = document.getElementById('logo-preview');
    const logoPreviewImg = document.getElementById('logo-preview-img');

    if (logoInput) {
      logoInput.addEventListener('change', function() {
        const file = this.files[0];
        if (file) {
          if (file.size > 2 * 1024 * 1024) {
            alert('Le fichier est trop volumineux. Taille maximum : 2 Mo.');
            this.value = '';
            logoPreview.classList.add('hidden');
            return;
          }
          const reader = new FileReader();
          reader.onload = function(e) {
            logoPreviewImg.src = e.target.result;
            logoPreview.classList.remove('hidden');
          };
          reader.readAsDataURL(file);
        } else {
          logoPreview.classList.add('hidden');
        }
      });
    }

    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      const errorDiv = document.getElementById('form-error');
      const submitBtn = document.getElementById('submit-btn');
      const successDiv = document.getElementById('form-success');
      const formContainer = document.getElementById('form-container');

      // Honeypot check
      const honeypot = document.getElementById('fax_number');
      if (honeypot && honeypot.value) {
        formContainer.classList.add('hidden');
        successDiv.classList.remove('hidden');
        return;
      }

      // Validate RGPD consent
      const rgpdConsent = document.getElementById('rgpd_consent');
      if (!rgpdConsent.checked) {
        errorDiv.textContent = 'Vous devez accepter la politique de confidentialité pour envoyer votre proposition.';
        errorDiv.classList.remove('hidden');
        return;
      }

      // Collect form data
      const rawFormData = new FormData(form);
      const data = {
        name: rawFormData.get('name'),
        category: rawFormData.get('category'),
        description: rawFormData.get('description') || undefined,
        contact_name: rawFormData.get('contact_name') || undefined,
        contact_email: rawFormData.get('contact_email') || undefined,
        contact_phone: rawFormData.get('contact_phone') || undefined,
        website: rawFormData.get('website') || undefined,
        address: rawFormData.get('address') || undefined,
        submitted_by_name: rawFormData.get('submitted_by_name'),
        submitted_by_email: rawFormData.get('submitted_by_email'),
        site: rawFormData.get('site'),
      };

      // Client-side validation
      if (!data.name || !data.category || !data.submitted_by_name || !data.submitted_by_email) {
        errorDiv.textContent = 'Veuillez remplir tous les champs obligatoires.';
        errorDiv.classList.remove('hidden');
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(data.submitted_by_email)) {
        errorDiv.textContent = 'Veuillez saisir une adresse email valide.';
        errorDiv.classList.remove('hidden');
        return;
      }

      // Check logo size
      const logoFile = logoInput && logoInput.files[0];
      if (logoFile && logoFile.size > 2 * 1024 * 1024) {
        errorDiv.textContent = 'Le logo est trop volumineux. Taille maximum : 2 Mo.';
        errorDiv.classList.remove('hidden');
        return;
      }

      // Submit
      errorDiv.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Envoi en cours...';

      try {
        // Build FormData for multipart upload
        const sendFormData = new FormData();
        sendFormData.append('data', JSON.stringify(data));
        if (logoFile) {
          sendFormData.append('files.logo', logoFile);
        }

        const response = await fetch(`${strapiUrl}/api/associations/public`, {
          method: 'POST',
          body: sendFormData,
        });

        if (!response.ok) {
          const err = await response.json().catch(() => null);
          throw new Error(err?.error?.message || 'Une erreur est survenue lors de l\'envoi.');
        }

        // Show success
        formContainer.classList.add('hidden');
        successDiv.classList.remove('hidden');
      } catch (err) {
        errorDiv.textContent = err.message || 'Une erreur est survenue. Veuillez réessayer.';
        errorDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Envoyer ma proposition';
      }
    });
  })();
</script>
