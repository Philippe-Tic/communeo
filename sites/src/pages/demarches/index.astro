---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getSiteConfig } from '../../utils/strapi';
import { getComarquageCategories } from '../../utils/comarquage';
import CategoryGrid from '../../components/comarquage/CategoryGrid.astro';
import AudienceSelector from '../../components/comarquage/AudienceSelector.astro';
import SearchBar from '../../components/comarquage/SearchBar.tsx';

const siteConfig = await getSiteConfig();

// Comarquage: fetch categories at build time if enabled
const comarquageEnabled = siteConfig.comarquage_enabled === true;
const audiences = comarquageEnabled ? (siteConfig.comarquage_audiences ?? ['particuliers']) : [];
const particuliersThemes = audiences.includes('particuliers')
  ? await getComarquageCategories('particuliers')
  : [];
const professionnelsThemes = audiences.includes('professionnels')
  ? await getComarquageCategories('professionnels')
  : [];
---

<Layout
  title="Démarches en ligne"
  description="Accédez aux fiches pratiques de service-public.fr pour vos démarches administratives."
>
  <a href="#main-content" class="skip-link">Aller au contenu principal</a>

  <Navigation />

  <main id="main-content" data-pagefind-body>
    <Breadcrumb items={[{ label: 'Démarches' }]} />

    <!-- Header -->
    <header class="bg-gradient-to-br from-primary to-primary/80 text-on-primary py-16 lg:py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold mb-4">
            Démarches en ligne
          </h1>
          <p class="text-lg sm:text-xl text-on-primary/80 max-w-3xl mx-auto">
            Accédez aux services publics nationaux directement depuis le site de votre mairie
          </p>
        </div>
      </div>
    </header>

    {/* Section Comarquage — conditionnelle */}
    {comarquageEnabled && (particuliersThemes.length > 0 || professionnelsThemes.length > 0) && (
      <section class="py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-2xl font-bold text-gray-900">
            Guichet démarches — service-public.fr
          </h2>
          <p class="text-gray-600 mt-2">
            Retrouvez les fiches pratiques officielles pour vos démarches administratives.
          </p>

          {audiences.length > 1 && <AudienceSelector audiences={audiences} />}

          <SearchBar client:load defaultAudience={audiences[0] || 'particuliers'} />

          {audiences.includes('particuliers') && particuliersThemes.length > 0 && (
            <div data-audience-content="particuliers">
              <CategoryGrid themes={particuliersThemes} audience="particuliers" />
            </div>
          )}
          {audiences.includes('professionnels') && professionnelsThemes.length > 0 && (
            <div data-audience-content="professionnels" class={audiences.includes('particuliers') ? 'hidden' : ''}>
              <CategoryGrid themes={professionnelsThemes} audience="professionnels" />
            </div>
          )}
        </div>
      </section>
    )}
  </main>

  <Footer />
</Layout>
