---
/** Blocs d'un contenu, avec le sommaire quand la page est longue (actualité, événement). */
import type { BlockVM, TocEntryVM } from '@communeo/core';
import Blocks from '@communeo/ui-a11y/Blocks.astro';
import { blocks as components } from '../blocks/index';
import Toc from './Toc.astro';

interface Props {
  blocks: BlockVM[];
  toc?: TocEntryVM[];
}

const { blocks, toc = [] } = Astro.props;
const withToc = toc.length >= 3;
---
<div class:list={['mo-reading', { 'mo-reading-with-toc': withToc }]}>
  <div class="mo-blocks"><Blocks blocks={blocks} components={components} /></div>
  {withToc && <Toc entries={toc} />}
</div>
