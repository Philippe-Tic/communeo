---
/** Agenda : titre et compteur, filtres en pilules, événements à venir groupés par mois en grille. */
import { TIME_ZONE, type EventCardVM } from '@communeo/core';
import type { FilterOption, PageContext } from '@communeo/theme-contract';
import Empty from '../parts/Empty.astro';
import EventCard from '../parts/EventCard.astro';
import Filters from '../parts/Filters.astro';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; upcoming: EventCardVM[]; categories: FilterOption[] }
const { ctx, upcoming, categories } = Astro.props;

const monthLabel = (iso: string) => new Intl.DateTimeFormat('fr-FR', { timeZone: TIME_ZONE, month: 'long', year: 'numeric' }).format(new Date(iso));
const months: Array<{ label: string; events: EventCardVM[] }> = [];
for (const event of upcoming) {
  const label = monthLabel(event.start.iso);
  const last = months.at(-1);
  if (last?.label === label) last.events.push(event);
  else months.push({ label, events: [event] });
}
const slug = (label: string) => `mo-month-${label.normalize('NFD').replace(/[^\w]+/g, '-')}`;
const filter = categories.find((category) => category.current) ?? null;
---
<Layout ctx={ctx} heading={false}>
  <div class="mo-list-head">
    <div>
      <h1>{ctx.title}</h1>
      <p class="mo-count mo-count-large" role="status">{upcoming.length} événement{upcoming.length > 1 ? 's' : ''} à venir{filter && <> · {filter.label}</>}</p>
    </div>
  </div>
  <div class="mo-filter-bar">
    <Filters label="Filtrer par catégorie" options={categories} allHref="/agenda" />
  </div>

  {months.map((month) => (
    <section class="mo-month" aria-labelledby={slug(month.label)}>
      <h2 id={slug(month.label)} class="mo-month-title">
        <span class="mo-capitalize">{month.label}</span>
        <span class="mo-month-count">{month.events.length} événement{month.events.length > 1 ? 's' : ''}</span>
      </h2>
      <div class="mo-grid-3">{month.events.map((event) => <EventCard event={event} image />)}</div>
    </section>
  ))}

  {upcoming.length === 0 && (
    <Empty tone="dark" title="Rien de prévu pour l'instant" action={filter ? { label: 'Voir tout l’agenda', href: '/agenda' } : null}>
      La mairie et les associations publient régulièrement de nouveaux événements.
    </Empty>
  )}
</Layout>
