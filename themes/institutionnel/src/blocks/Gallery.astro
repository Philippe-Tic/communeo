---
/**
 * Galerie : grille de vignettes. Sans JavaScript, chaque vignette ouvre l'image dans l'onglet ;
 * avec JavaScript, elle s'agrandit dans la fenêtre modale partagée (Échap, flèches, focus rendu).
 */
import type { BlockOf } from '@communeo/core';
import Lightbox from '@communeo/ui-a11y/Lightbox.astro';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import X from '@lucide/astro/icons/x';

interface Props { block: BlockOf<'gallery'> }
const { block } = Astro.props;
---
<section class="in-gallery" aria-label={block.title ?? 'Galerie'} data-cn-gallery>
  {block.title && <h2>{block.title}</h2>}
  <ul>
    {block.images.map((image) => (
      <li>
        <a href={image.src} data-cn-lightbox-item data-cn-lightbox-caption={image.caption ?? undefined}>
          <img
            src={image.src}
            alt={image.alt}
            width={image.width ?? undefined}
            height={image.height ?? undefined}
            loading="lazy"
          />
          <span class="cn-sr-only">Agrandir{image.alt && <> : {image.alt}</>}</span>
        </a>
        {image.caption && <p class="in-meta">{image.caption}</p>}
      </li>
    ))}
  </ul>
</section>

<Lightbox class="in-lightbox">
  <Fragment slot="precedente"><ChevronLeft size={24} aria-hidden="true" />Précédente</Fragment>
  <Fragment slot="suivante">Suivante<ChevronRight size={24} aria-hidden="true" /></Fragment>
  <Fragment slot="fermer"><X size={24} aria-hidden="true" /><span class="cn-sr-only">Fermer l'image agrandie</span></Fragment>
</Lightbox>
