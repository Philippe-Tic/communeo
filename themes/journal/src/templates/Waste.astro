---
/** Collecte des déchets : une colonne par collecte (filet de couleur, prochaine date en grand), puis le calendrier. */
import type { WasteCollectionVM } from '@communeo/core';
import type { PageContext } from '@communeo/theme-contract';
import NextCollections from '@communeo/ui-a11y/NextCollections.astro';
import Empty from '../parts/Empty.astro';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; collections: WasteCollectionVM[]; notes: string | null }
const { ctx, collections, notes } = Astro.props;
---
<Layout ctx={ctx}>
  {notes && <p class="jo-lead jo-list-intro">{notes}</p>}
  {collections.length ? (
    <>
      <section class="jo-waste-section" aria-labelledby="jo-waste-next">
        <h2 id="jo-waste-next">Prochaines collectes</h2>
        <ul class="jo-waste-cards">
          {collections.map((collection) => (
            <li class={`jo-waste-card jo-bin-${collection.key}`}>
              <h3>{collection.label}</h3>
              {collection.upcoming.length > 0 ? (
                <p class="jo-waste-date"><NextCollections collection={collection} /></p>
              ) : (
                <p class="jo-waste-date">{collection.day ? 'Hors saison' : collection.frequency.label}</p>
              )}
              {collection.day
                ? <p class="jo-waste-rule">{collection.frequency.label}, le {collection.day.label}</p>
                : collection.notes && <p class="jo-waste-rule">{collection.notes}</p>}
            </li>
          ))}
        </ul>
      </section>

      <section class="jo-waste-section" aria-labelledby="jo-waste-calendar">
        <div class="jo-section-head"><h2 id="jo-waste-calendar">Calendrier par type</h2></div>
        <div class="jo-table-wrapper">
          <table class="jo-table jo-waste-table">
            <caption class="cn-sr-only">Jours, fréquences et zones de collecte</caption>
            <thead>
              <tr><th scope="col">Type</th><th scope="col">Jour</th><th scope="col">Fréquence</th><th scope="col">Zone</th><th scope="col">À savoir</th></tr>
            </thead>
            <tbody>
              {collections.map((collection) => (
                <tr>
                  <th scope="row">
                    <span class="jo-waste-row">
                      <span class={`jo-waste-swatch jo-bin-${collection.key}`} aria-hidden="true"></span>
                      {collection.label}
                    </span>
                  </th>
                  <td data-label="Jour">{collection.day?.label ?? '—'}</td>
                  <td data-label="Fréquence">{collection.frequency.label}</td>
                  <td data-label="Zone">{collection.zone ?? 'Toute la commune'}</td>
                  <td data-label="À savoir">{collection.notes}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
  ) : (
    <Empty title="Calendrier bientôt publié">Le calendrier de collecte sera bientôt publié.</Empty>
  )}
</Layout>
