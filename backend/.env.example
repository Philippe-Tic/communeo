# Configuration Strapi
HOST=0.0.0.0
PORT=1337

# Netlify Configuration - REQUIS POUR LE DÉPLOIEMENT
NETLIFY_TOKEN=your-netlify-token-here

# Strapi API pour les builds
STRAPI_PUBLIC_URL=http://localhost:1337
STRAPI_API_TOKEN=your-strapi-api-token-here

# SMTP — requis pour forgot-password et notifications email
# En dev : laisser vide (fallback MailHog localhost:1025)
# En prod avec Resend :
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USERNAME=resend
#   SMTP_PASSWORD=re_xxxxxxxxx  (clé API Resend)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DEFAULT_FROM=noreply@communeo.fr

# URL de l'admin dashboard (utilisée dans les liens des emails de reset password)
# En dev : http://localhost:5173
# En prod : https://app.communeo.fr
ADMIN_URL=http://localhost:5173

# Seed admin (production uniquement, créé au premier démarrage si aucun user n'existe)
SEED_SITE_NAME=Ma Commune
SEED_SITE_SLUG=ma-commune
SEED_ADMIN_EMAIL=admin@communeo.fr
SEED_ADMIN_PASSWORD=ChangeMe123!
