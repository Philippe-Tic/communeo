---
/**
 * Météo de la commune. Tout le bloc (titre compris) reste masqué tant que la prévision n'est pas
 * chargée, et le reste si le service ne répond pas : une page publique n'affiche pas un widget vide.
 * Les données viennent d'Open-Meteo, sans cookie.
 */
interface Props {
  /** Coordonnées de la mairie (infos pratiques du site) */
  position: { lat: number; lng: number };
  class?: string;
  /** Repère de la section d'accueil (`data-cn-home`), pour la preview */
  [attribute: `data-${string}`]: string;
}

const { position, class: className, ...attributes } = Astro.props;
---
<section class:list={['cn-weather', className]} aria-label="Météo" data-cn-weather={JSON.stringify(position)} hidden {...attributes}>
  <slot name="titre" />
  <div data-cn-weather-content></div>
</section>

<script>
  import './scripts/weather';
</script>
