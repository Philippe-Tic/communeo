---
import type { Alerte } from '../types/strapi';
import { getAlertTypeConfig } from '../utils/alert-types';

interface Props {
  alerts: Alerte[];
}

const { alerts } = Astro.props;
const displayAlerts = alerts.slice(0, 3);

const severityBorder: Record<string, string> = {
  info: 'border-l-blue-500',
  warning: 'border-l-orange-500',
  critical: 'border-l-red-500',
};
---

{displayAlerts.length > 0 ? (
  <div class="flex flex-col gap-3">
    {displayAlerts.map((alert) => {
      const typeConfig = getAlertTypeConfig(alert.alert_type);
      const borderClass = severityBorder[alert.severity] || severityBorder.info;
      return (
        <div class={`rounded-lg border border-l-4 ${borderClass} bg-white p-4 shadow-sm`}>
          <div class="flex items-start gap-3">
            {typeConfig.emoji && (
              <span class="text-xl" aria-hidden="true">{typeConfig.emoji}</span>
            )}
            <div class="min-w-0 flex-1">
              <p class="font-semibold text-sm text-gray-900">{alert.title}</p>
              <p class="text-sm text-gray-600 mt-0.5 line-clamp-2">{alert.message}</p>
              {alert.location && (
                <p class="text-xs text-gray-500 mt-1 flex items-center gap-1">
                  <svg class="w-3 h-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                  {alert.location}
                </p>
              )}
            </div>
          </div>
        </div>
      );
    })}
  </div>
  <div class="mt-4 text-center">
    <a
      href="/perturbations"
      class="inline-flex items-center text-primary-text hover:text-primary-text/80 font-medium text-sm group/link"
    >
      Voir toutes les perturbations
      <svg class="ml-1 w-4 h-4 transition-transform group-hover/link:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>
) : (
  <p class="text-gray-500 text-center py-4">Aucune perturbation en cours.</p>
)}
