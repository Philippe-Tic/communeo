---
/**
 * Accueil « bourg » : accroche dans un grand encart menthe, accès rapides en tuiles, actualités (une
 * grande carte et des compactes), agenda, mot du maire, cantine du jour et chiffres de la commune,
 * associations, lettre d'information et partenaires. Mairie, alertes, collectes et météo sont dans le
 * panneau « Pratique » (colonne de droite ou tiroir). Chaque section est facultative.
 */
import type { FormConfig, PageContext } from '@communeo/theme-contract';
import type { HomeVM } from '@communeo/core';
import NewsletterForm from '@communeo/ui-a11y/NewsletterForm.astro';
import RichText from '@communeo/ui-a11y/RichText.astro';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArticleCard from '../parts/ArticleCard.astro';
import EventCard from '../parts/EventCard.astro';
import Icon from '../parts/Icon.astro';
import Layout from '../parts/Layout.astro';

interface Props {
  ctx: PageContext;
  home: HomeVM;
  newsletterForm: FormConfig;
}

const { ctx, home, newsletterForm } = Astro.props;
const { site } = ctx;
const hero = home.hero;
const [lead, ...news] = home.featuredNews ?? [];
// Premier jour de cantine de la semaine affichée (le site est statique : pas de « aujourd'hui » fiable)
const today = home.canteen?.days.find((day) => !day.closed) ?? null;
const initials = (name: string) =>
  name
    .split(/[\s-]+/)
    .filter((word) => word.length > 2 || /^[A-Z]/.test(word))
    .slice(0, 2)
    .map((word) => word[0]!.toUpperCase())
    .join('');
---
<Layout ctx={ctx} heading={false} full>
  <section class:list={['bo-hero', { 'bo-hero-image': hero?.image }]} aria-labelledby="bo-hero-title" data-cn-home="hero">
    <div class="bo-hero-text">
      {site.population && <p class="bo-kicker bo-hero-kicker">Commune de {site.population.toLocaleString('fr-FR')} habitants</p>}
      <h1 id="bo-hero-title">{hero?.title ?? site.name}</h1>
      {hero?.subtitle && <p class="bo-hero-subtitle">{hero.subtitle}</p>}
      {(hero?.primary || hero?.secondary) && (
        <p class="bo-hero-actions">
          {hero?.primary && <a class="bo-button" href={hero.primary.href}>{hero.primary.label}</a>}
          {hero?.secondary && <a class="bo-button bo-button-light" href={hero.secondary.href}>{hero.secondary.label}</a>}
        </p>
      )}
    </div>
    {hero?.image && (
      <img
        class="bo-hero-photo"
        src={hero.image.src}
        alt={hero.image.alt}
        srcset={hero.image.srcset ?? undefined}
        width={hero.image.width ?? undefined}
        height={hero.image.height ?? undefined}
      />
    )}
  </section>

  {home.quickLinks && (
    <section class="bo-home-section" aria-labelledby="bo-quick" data-cn-home="quick_links">
      <h2 id="bo-quick" class="bo-home-title">Accès rapides</h2>
      <ul class="bo-tiles">
        {home.quickLinks.map((link, index) => (
          <li>
            <a href={link.href} class="bo-tile" target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
              <span class={`bo-tile-icon bo-tone-${index % 6}`}><Icon name={link.icon} size={20} /></span>
              <span>{link.label}{link.external && <span class="cn-sr-only"> (nouvelle fenêtre)</span>}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {lead && (
    <section class="bo-home-section" aria-labelledby="bo-news" data-cn-home="featured_news">
      <div class="bo-section-head">
        <h2 id="bo-news" class="bo-home-title">Actualités</h2>
        <a href="/actualites">Toutes les actualités<ArrowRight size={16} aria-hidden="true" /></a>
      </div>
      <div class:list={['bo-home-news', { 'bo-home-news-split': news.length > 0 }]}>
        <ArticleCard article={lead} featured />
        {news.length > 0 && (
          <div class="bo-home-news-list">
            {news.map((article) => <ArticleCard article={article} compact />)}
          </div>
        )}
      </div>
    </section>
  )}

  {home.agenda && (
    <section class="bo-home-section" aria-labelledby="bo-agenda" data-cn-home="agenda">
      <div class="bo-section-head">
        <h2 id="bo-agenda" class="bo-home-title">Agenda</h2>
        <a href="/agenda">Tout l'agenda<ArrowRight size={16} aria-hidden="true" /></a>
      </div>
      <div class="bo-grid-2">{home.agenda.map((event) => <EventCard event={event} />)}</div>
    </section>
  )}

  {home.mayorWord && (
    <section class:list={['bo-mayor', { 'bo-mayor-photo': home.mayorWord.photo }]} aria-labelledby="bo-mayor" data-cn-home="mayor_word">
      {home.mayorWord.photo && (
        <img
          src={home.mayorWord.photo.src}
          alt={home.mayorWord.photo.alt}
          width={home.mayorWord.photo.width ?? undefined}
          height={home.mayorWord.photo.height ?? undefined}
          loading="lazy"
        />
      )}
      <div>
        <h2 id="bo-mayor" class="bo-kicker">{home.mayorWord.title}</h2>
        <RichText doc={home.mayorWord.body} class="bo-mayor-text" />
        {(home.mayorWord.signature.name || home.mayorWord.signature.role) && (
          <p class="bo-mayor-signature">
            {home.mayorWord.signature.name && <strong>{home.mayorWord.signature.name}</strong>}{home.mayorWord.signature.name && home.mayorWord.signature.role && ', '}{home.mayorWord.signature.role}
          </p>
        )}
      </div>
    </section>
  )}

  {(home.canteen || home.keyFigures) && (
    <div class="bo-grid-2 bo-home-pair">
      {home.canteen && (
        <section class="bo-card bo-home-card" aria-labelledby="bo-canteen" data-cn-home="canteen">
          <div class="bo-section-head">
            <h2 id="bo-canteen" class="bo-home-card-title">{today ? `Cantine · ${today.day.label.toLowerCase()}` : 'Cantine'}</h2>
            <a href="/cantine">La semaine<ArrowRight size={16} aria-hidden="true" /></a>
          </div>
          {today ? (
            <ul class="bo-canteen">
              {today.courses.map((course) => (
                <li>
                  <span><span class="cn-sr-only">{course.label} : </span>{course.dish}</span>
                  {course.badges.length > 0 && (
                    <span class="bo-canteen-badges">{course.badges.map((badge) => <span class="bo-badge">{badge}</span>)}</span>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="bo-muted">Pas de cantine cette semaine.</p>
          )}
        </section>
      )}
      {home.keyFigures && (
        <section class="bo-card bo-card-lavender bo-home-card" aria-labelledby="bo-figures" data-cn-home="key_figures">
          <h2 id="bo-figures" class="bo-home-card-title bo-figures-title">La commune en chiffres</h2>
          <dl class="bo-figures">
            {home.keyFigures.map((figure) => (
              <div>
                <dt>{figure.label}</dt>
                <dd>{figure.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}
    </div>
  )}

  {home.associations && (
    <section class="bo-home-section" aria-labelledby="bo-assos" data-cn-home="associations">
      <div class="bo-section-head">
        <h2 id="bo-assos" class="bo-home-title">Associations</h2>
        <a href="/associations">L'annuaire<ArrowRight size={16} aria-hidden="true" /></a>
      </div>
      <ul class="bo-asso-pills">
        {home.associations.map((association, index) => (
          <li>
            <a href={association.href} class="bo-asso-pill">
              {association.logo ? (
                <img src={association.logo.src} alt="" width="36" height="36" loading="lazy" />
              ) : (
                <span class={`bo-asso-initials bo-tone-${index % 6}`} aria-hidden="true">{initials(association.name)}</span>
              )}
              {association.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {home.freeContent && (
    <section class="bo-home-section" aria-labelledby="bo-free" data-cn-home="free_content">
      <h2 id="bo-free" class="bo-home-title">{home.freeContent.title ?? `Découvrir ${site.name}`}</h2>
      <RichText doc={home.freeContent.body} class="bo-prose" />
    </section>
  )}

  {(home.newsletter || home.partners) && (
    <div class:list={['bo-home-pair', { 'bo-grid-2': home.newsletter && home.partners }]}>
      {home.newsletter && (
        <section class="bo-newsletter" aria-labelledby="bo-newsletter" data-cn-home="newsletter">
          <h2 id="bo-newsletter" class="bo-home-card-title">Lettre d'information</h2>
          <p>L'actualité de la commune, une fois par mois.</p>
          <NewsletterForm form={newsletterForm} class="bo-newsletter-form" placeholder="Votre adresse e-mail">
            <p class="bo-newsletter-note">Désinscription à tout moment. <a href="/donnees-personnelles">Données personnelles</a></p>
          </NewsletterForm>
        </section>
      )}
      {home.partners && (
        <section class="bo-partners" aria-labelledby="bo-partners" data-cn-home="partners">
          <h2 id="bo-partners" class="bo-home-card-title">Partenaires</h2>
          <ul>
            {home.partners.map((partner) => {
              const content = partner.logo ? <img src={partner.logo.src} alt={partner.name} loading="lazy" /> : <span>{partner.name}</span>;
              return (
                <li>
                  {partner.href ? (
                    <a href={partner.href} target="_blank" rel="noopener noreferrer">{content}<span class="cn-sr-only"> (nouvelle fenêtre)</span></a>
                  ) : (
                    content
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      )}
    </div>
  )}
</Layout>
