# Configuration Strapi
HOST=0.0.0.0
PORT=1337

# Hébergeur (domaines personnalisés). Sans jeton, Strapi démarre et ces actions répondent 503.
NETLIFY_TOKEN=your-netlify-token-here
# Adresse Communeo des sites, <slug>.<SITES_DOMAIN> (zone DNS gérée par Netlify). Vide : adresse *.netlify.app
# SITES_DOMAIN=communeo.fr

# Émetteur des devis (#312). TVA : 0 en franchise en base (art. 293 B du CGI), 0.2 sinon
COMMUNEO_LEGAL_NAME=
COMMUNEO_LEGAL_ADDRESS=
COMMUNEO_SIRET=
COMMUNEO_BILLING_EMAIL=
COMMUNEO_VAT_RATE=0

# Mises en ligne : file des builds (Postgres, pg-boss) traitée par le worker (apps/worker).
# Sans QUEUE_DATABASE_URL, « Mettre en ligne » répond 503.
QUEUE_DATABASE_URL=postgres://strapi:strapi@localhost:5432/strapi
# Secret partagé avec le worker (routes /api/build-worker/*)
WORKER_SECRET=change-me

# Preview des brouillons : secret des jetons signés (partagé avec le serveur de preview) et adresse du serveur
PREVIEW_SECRET=change-me
PREVIEW_URL=http://localhost:4321

# Hébergeur des sites, affiché dans les mentions légales de toutes les communes (non modifiable par elles).
# Vide : les valeurs déjà enregistrées sur chaque site sont conservées.
HOSTING_NAME=
HOSTING_ADDRESS=
HOSTING_PHONE=

STRAPI_PUBLIC_URL=http://localhost:1337
# Tokens en lecture seule, créés au premier démarrage s'ils ne sont pas définis (valeur dans les logs) :
# builds des sites (worker) et serveur de preview (brouillons)
STRAPI_API_TOKEN=your-strapi-api-token-here
PREVIEW_API_TOKEN=your-preview-api-token-here

# Email (Resend — API HTTP, pas de SMTP)
# Créer une clé sur https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_DEFAULT_FROM=noreply@communeo.fr

# URL de l'admin dashboard (utilisée dans les liens des emails de reset password)
# En dev : http://localhost:5173
# En prod : https://app.communeo.fr
ADMIN_URL=http://localhost:5173
# Équipe prévenue des inscriptions à vérifier à la main (mairie sans adresse officielle connue)
SIGNUP_NOTIFY_EMAIL=

# Seed admin (production uniquement, créé au premier démarrage si aucun user n'existe)
SEED_SITE_NAME=Ma Commune
SEED_SITE_SLUG=ma-commune
SEED_ADMIN_EMAIL=admin@communeo.fr
SEED_ADMIN_PASSWORD=ChangeMe123!
