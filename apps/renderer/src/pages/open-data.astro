---
import theme from 'virtual:communeo/theme';
import Document from '../layouts/Document.astro';
import { getSource, simplePage } from '../lib/content';

const source = getSource();
const site = await source.site();
const ctx = await simplePage(source, { path: '/open-data', title: 'Open data', description: 'Les données publiques de la commune' });
const { Frame } = theme.templates;
---
<Document ctx={ctx}><Frame ctx={ctx}>{site.services.openData.url ? <p>La commune publie ses données ouvertes sur <a href={site.services.openData.url}>sa plateforme open data</a>.</p> : <p>Aucun jeu de données publié pour le moment.</p>}</Frame></Document>
