---
/** Annuaire des associations : filtres en pilules, cartes (logo ou initiales), proposition d'ajout. */
import type { AssociationCardVM } from '@communeo/core';
import type { FilterOption, PageContext } from '@communeo/theme-contract';
import Plus from '@lucide/astro/icons/plus';
import Empty from '../parts/Empty.astro';
import Filters from '../parts/Filters.astro';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; associations: AssociationCardVM[]; categories: FilterOption[]; proposeHref: string }
const { ctx, associations, categories, proposeHref } = Astro.props;
const initials = (name: string) =>
  name
    .split(/[\s-]+/)
    .filter((word) => word.length > 2 || /^[A-Z]/.test(word))
    .slice(0, 2)
    .map((word) => word[0]!.toUpperCase())
    .join('');
const filter = categories.find((category) => category.current) ?? null;
---
<Layout ctx={ctx} heading={false}>
  <div class="jo-list-head">
    <div>
      <h1>{ctx.title}</h1>
      <p class="jo-count jo-count-large" role="status">{associations.length} association{associations.length > 1 ? 's' : ''}{filter && <> · {filter.label}</>}</p>
    </div>
    <a href={proposeHref} class="jo-button"><Plus size={20} aria-hidden="true" />Proposer une association</a>
  </div>
  <div class="jo-filter-bar">
    <Filters label="Filtrer par catégorie" options={categories} allHref="/associations" />
  </div>

  {associations.length ? (
    <ul class="jo-grid-3 jo-asso-cards">
      {associations.map((association) => (
        <li>
          <article class="jo-asso-card">
            {association.logo
              ? <img class="jo-asso-logo" src={association.logo.src} alt="" width={association.logo.width ?? undefined} height={association.logo.height ?? undefined} loading="lazy" />
              : <span class="jo-asso-logo jo-initials" aria-hidden="true">{initials(association.name)}</span>}
            <div>
              <span class="jo-tag">{association.category.label}</span>
              <h2 class="jo-card-title"><a href={association.href}>{association.name}</a></h2>
              {association.summary && <p class="jo-card-summary">{association.summary}</p>}
            </div>
          </article>
        </li>
      ))}
    </ul>
  ) : (
    <Empty title="Aucune association référencée" action={{ label: 'Proposer une association', href: proposeHref }}>
      Votre association n'apparaît pas ? Proposez-la : la mairie la publiera après vérification.
    </Empty>
  )}
</Layout>
