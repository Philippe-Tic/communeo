---
import type { BlockOf } from '@communeo/core';

interface Props { block: BlockOf<'gallery'> }
const { block } = Astro.props;
---
<section class="st-gallery" aria-label={block.title ?? 'Galerie'}>
  {block.title && <h2>{block.title}</h2>}
  <ul>
    {block.images.map((image) => (
      <li>
        <figure>
          <a href={image.src}><img src={image.src} alt={image.alt} width={image.width ?? undefined} height={image.height ?? undefined} loading="lazy" /></a>
          {image.caption && <figcaption>{image.caption}</figcaption>}
        </figure>
      </li>
    ))}
  </ul>
</section>
