---
/**
 * Sommaire en pastilles au-dessus du contenu (la colonne de droite est au panneau « Pratique ») :
 * les sections de premier niveau, celle en cours de lecture en encre. Défile à l'horizontale sur mobile.
 */
import type { TocEntryVM } from '@communeo/core';

interface Props {
  entries: TocEntryVM[];
}

const { entries } = Astro.props;
const top = entries.filter((entry) => entry.level === 2);
const shown = top.length >= 2 ? top : entries;
---
<nav class="bo-toc" aria-label="Sommaire" data-bo-toc>
  <ol>
    {shown.map((entry) => <li><a href={`#${entry.id}`}>{entry.label}</a></li>)}
  </ol>
</nav>

<script>
  // Section en cours de lecture : la pastille correspondante est marquée (aria-current)
  const toc = document.querySelector<HTMLElement>('[data-bo-toc]');
  const links = toc ? [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')] : [];
  const targets = links
    .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
    .filter((target): target is HTMLElement => !!target);
  if (targets.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const mark = () => {
      const current = targets.find((target) => visible.has(target)) ?? null;
      for (const link of links) {
        const active = current !== null && link.hash === `#${current.id}`;
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };
    const observer = new IntersectionObserver(
      (records) => {
        for (const record of records) {
          if (record.isIntersecting) visible.add(record.target);
          else visible.delete(record.target);
        }
        mark();
      },
      { rootMargin: '0px 0px -60% 0px' },
    );
    targets.forEach((target) => observer.observe(target));
  }
</script>
