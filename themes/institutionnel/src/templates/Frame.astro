---
import type { PageContext } from '@communeo/theme-contract';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; lead?: string | null }
const { ctx, lead } = Astro.props;
---
<Layout ctx={ctx}>
  {lead && <p class="in-lead">{lead}</p>}
  <div class="in-prose"><slot /></div>
</Layout>
