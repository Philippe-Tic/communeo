---
interface Props {
  title?: string;
  subtitle?: string;
  bg?: 'white' | 'gray' | 'gradient';
  class?: string;
}

const { title, subtitle, bg = 'white', class: className } = Astro.props;

const bgClass = bg === 'gray' ? 'bg-gray-50' : bg === 'gradient' ? 'bg-gradient-to-br from-primary/5 to-secondary/5' : 'bg-white';
---

<section class={`py-12 lg:py-16 ${bgClass} ${className || ''}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    {title && (
      <div class="text-center mb-10">
        <h2 class="section-title text-3xl font-bold text-gray-900 mb-3">{title}</h2>
        {subtitle && (
          <p class="text-gray-600 max-w-2xl mx-auto">{subtitle}</p>
        )}
      </div>
    )}
    <slot />
  </div>
</section>
