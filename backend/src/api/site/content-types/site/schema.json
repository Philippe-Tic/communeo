{
  "kind": "collectionType",
  "collectionName": "sites",
  "info": {
    "singularName": "site",
    "pluralName": "sites",
    "displayName": "Site",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 100
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "colors": {
      "type": "json"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "contact_mail": {
      "type": "email",
      "required": true
    },
    "contact_phone": {
      "type": "string"
    },
    "address": {
      "type": "text"
    },
    "netlify_site_id": {
      "type": "string",
      "required": false,
      "unique": true,
      "private": true
    },
    "live_url": {
      "type": "string",
      "required": false
    },
    "custom_domain": {
      "type": "string",
      "required": false,
      "regex": "^([a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,}$"
    },
    "domain_status": {
      "type": "enumeration",
      "enum": ["pending", "verified", "error"],
      "default": "pending",
      "required": false
    },
    "domain_type": {
      "type": "enumeration",
      "enum": ["apex", "subdomain"],
      "required": false
    },
    "domain_verification_token": {
      "type": "string",
      "required": false,
      "private": true
    },
    "domain_configured_at": {
      "type": "datetime",
      "required": false
    },
    "ssl_enabled": {
      "type": "boolean",
      "default": true,
      "required": false
    },
    "pages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::page.page",
      "mappedBy": "site"
    },
    "articles": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::article.article",
      "mappedBy": "site"
    },
    "evenements": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::evenement.evenement",
      "mappedBy": "site"
    },
    "deployments": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::deployment.deployment",
      "mappedBy": "site"
    },
    "contact_submissions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::contact-submission.contact-submission",
      "mappedBy": "site"
    },
    "official_documents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::official-document.official-document",
      "mappedBy": "site"
    },
    "team_members": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::team-member.team-member",
      "mappedBy": "site"
    },
    "associations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::association.association",
      "mappedBy": "site"
    },
    "alertes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::alerte.alerte",
      "mappedBy": "site"
    },
    "waste_schedules": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::waste-schedule.waste-schedule",
      "mappedBy": "site"
    },
    "media_items": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::media-item.media-item",
      "mappedBy": "site"
    },
    "mentions_legales": {
      "type": "component",
      "component": "legal.mentions-legales",
      "required": false
    },
    "rgpd": {
      "type": "component",
      "component": "legal.rgpd",
      "required": false
    },
    "accessibilite": {
      "type": "component",
      "component": "legal.accessibilite",
      "required": false
    },
    "infos_pratiques": {
      "type": "component",
      "component": "legal.infos-pratiques",
      "required": false
    },
    "demarches_identite": {
      "type": "component",
      "component": "legal.demarches-identite",
      "required": false
    },
    "open_data_enabled": {
      "type": "boolean",
      "default": false
    },
    "open_data_url": {
      "type": "string"
    },
    "open_data_platform": {
      "type": "enumeration",
      "enum": ["data-gouv-fr", "opendatasoft", "custom", "none"],
      "default": "none"
    },
    "homepage": {
      "type": "component",
      "component": "homepage.homepage-config",
      "required": false
    },
    "auto_deploy_enabled": {
      "type": "boolean",
      "default": false
    },
    "auto_deploy_delay": {
      "type": "integer",
      "default": 300,
      "min": 60,
      "max": 3600
    },
    "navigation_config": {
      "type": "json"
    },
    "social_links": {
      "type": "component",
      "repeatable": true,
      "component": "social.social-link"
    }
  }
}
