---
interface Props {
  variant: 'footer' | 'section';
}

const { variant } = Astro.props;
const strapiUrl = import.meta.env.STRAPI_PUBLIC_URL;
const siteDocumentId = import.meta.env.SITE_DOCUMENT_ID;
const formId = `newsletter-form-${variant}`;
---

{variant === 'section' ? (
  <section class="py-12 bg-primary/5">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="bg-white rounded-2xl border border-gray-100 p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">Restez informé</h2>
        <p class="text-gray-600 mb-6">
          Recevez les actualités et informations de votre commune directement dans votre boîte mail.
        </p>

        <form id={formId} class="space-y-4" novalidate>
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label for={`website-${variant}`}>Ne pas remplir</label>
            <input type="text" id={`website-${variant}`} name="website" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="site" value={siteDocumentId} />

          <div class="flex flex-col sm:flex-row gap-3 max-w-lg mx-auto">
            <input
              type="email"
              name="email"
              required
              placeholder="Votre adresse email"
              class="flex-1 rounded-md border border-gray-300 px-4 py-2.5 text-sm focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
            />
            <button
              type="submit"
              class="inline-flex items-center justify-center rounded-md bg-primary px-6 py-2.5 text-sm font-medium text-on-primary hover:bg-primary/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            >
              S'inscrire
            </button>
          </div>

          <div class="flex items-start gap-2 justify-center max-w-lg mx-auto">
            <input type="checkbox" id={`rgpd-${variant}`} name="rgpd_consent" required
              class="mt-1 h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary" />
            <label for={`rgpd-${variant}`} class="text-xs text-gray-500 text-left">
              J'accepte de recevoir la newsletter et que mes données soient traitées conformément à la <a href="/politique-confidentialite" class="text-primary-text underline hover:text-primary-text/80">politique de confidentialité</a>.
            </label>
          </div>

          <div id={`${formId}-error`} class="hidden rounded-md bg-red-50 border border-red-200 p-3 text-sm text-red-700 max-w-lg mx-auto"></div>
          <div id={`${formId}-success`} class="hidden rounded-md bg-green-50 border border-green-200 p-3 text-sm text-green-700 max-w-lg mx-auto"></div>
          <div id={`${formId}-already`} class="hidden rounded-md bg-amber-50 border border-amber-200 p-3 text-sm text-amber-700 max-w-lg mx-auto"></div>
        </form>
      </div>
    </div>
  </section>
) : (
  <div class="py-6 border-t border-white/20">
    <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-3">Newsletter</h3>
    <p class="text-sm text-white/70 mb-3">Recevez les actualités de votre commune.</p>

    <form id={formId} class="space-y-3" novalidate>
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for={`website-${variant}`}>Ne pas remplir</label>
        <input type="text" id={`website-${variant}`} name="website" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="site" value={siteDocumentId} />

      <div class="flex gap-2">
        <input
          type="email"
          name="email"
          required
          placeholder="Votre email"
          class="flex-1 rounded-md border border-white/30 bg-white/10 px-3 py-2 text-sm text-white placeholder:text-white/50 focus:border-white/50 focus:outline-none focus:ring-1 focus:ring-white/50"
        />
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-md bg-white/20 px-4 py-2 text-sm font-medium text-white hover:bg-white/30 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        >
          OK
        </button>
      </div>

      <div class="flex items-start gap-2">
        <input type="checkbox" id={`rgpd-${variant}`} name="rgpd_consent" required
          class="mt-0.5 h-3.5 w-3.5 rounded border-white/30 bg-white/10 text-primary focus:ring-white/50" />
        <label for={`rgpd-${variant}`} class="text-[11px] text-white/60">
          J'accepte la <a href="/politique-confidentialite" class="underline hover:text-white/80">politique de confidentialité</a>.
        </label>
      </div>

      <div id={`${formId}-error`} class="hidden rounded-md bg-red-500/20 border border-red-400/30 p-2 text-xs text-red-200"></div>
      <div id={`${formId}-success`} class="hidden rounded-md bg-green-500/20 border border-green-400/30 p-2 text-xs text-green-200"></div>
      <div id={`${formId}-already`} class="hidden rounded-md bg-amber-500/20 border border-amber-400/30 p-2 text-xs text-amber-200"></div>
    </form>
  </div>
)}

<script define:vars={{ strapiUrl, formId }}>
  (function() {
    const form = document.getElementById(formId);
    if (!form) return;

    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      const errorDiv = document.getElementById(`${formId}-error`);
      const successDiv = document.getElementById(`${formId}-success`);
      const alreadyDiv = document.getElementById(`${formId}-already`);
      const submitBtn = form.querySelector('button[type="submit"]');

      // Hide all feedback
      errorDiv.classList.add('hidden');
      successDiv.classList.add('hidden');
      alreadyDiv.classList.add('hidden');

      // Honeypot
      const honeypot = form.querySelector('input[name="website"]');
      if (honeypot && honeypot.value) {
        successDiv.textContent = 'Merci pour votre inscription !';
        successDiv.classList.remove('hidden');
        return;
      }

      // RGPD consent
      const consent = form.querySelector('input[name="rgpd_consent"]');
      if (!consent.checked) {
        errorDiv.textContent = 'Veuillez accepter la politique de confidentialité.';
        errorDiv.classList.remove('hidden');
        return;
      }

      const formData = new FormData(form);
      const email = formData.get('email');
      const site = formData.get('site');

      if (!email) {
        errorDiv.textContent = 'Veuillez saisir votre adresse email.';
        errorDiv.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = '...';

      try {
        const response = await fetch(`${strapiUrl}/api/newsletter-subscribers/public`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ data: { email, site } }),
        });

        if (response.status === 201) {
          successDiv.textContent = 'Merci pour votre inscription !';
          successDiv.classList.remove('hidden');
          form.querySelector('input[name="email"]').value = '';
          consent.checked = false;
        } else if (response.status === 409) {
          alreadyDiv.textContent = 'Cet email est déjà inscrit à la newsletter.';
          alreadyDiv.classList.remove('hidden');
        } else {
          throw new Error();
        }
      } catch {
        errorDiv.textContent = 'Une erreur est survenue. Veuillez réessayer.';
        errorDiv.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = originalText;
      }
    });
  })();
</script>
