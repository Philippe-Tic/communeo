---
import theme from 'virtual:communeo/theme';
import Document from '../layouts/Document.astro';
import { getSource, simplePage } from '../lib/content';

const source = getSource();
const site = await source.site();
const ctx = await simplePage(source, { path: '/gestion-des-cookies', title: 'Gestion des cookies', description: 'Vos choix sur les contenus tiers' });
const { Frame } = theme.templates;
---
<Document ctx={ctx}><Frame ctx={ctx}><p>Ce site ne dépose aucun cookie de mesure d’audience. Les vidéos et cartes hébergées par d’autres services ne sont chargées qu’avec votre accord.</p><p><button type="button" data-cn-cookie-preferences>Modifier mes choix</button></p></Frame></Document>
