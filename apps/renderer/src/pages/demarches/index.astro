---
/**
 * Démarches Service-Public : une recherche dans toutes les fiches (API publique, dans le navigateur)
 * et l'arborescence officielle (thème, sous-thème, dossier), construite au build. Chaque dossier ou
 * fiche renvoie vers la page de fiche, qui la charge depuis l'API publique.
 */
import { AUDIENCE_LABELS, demarcheHref } from '@communeo/core';
import theme from 'virtual:communeo/theme';
import Document from '../../layouts/Document.astro';
import { getSource, simplePage } from '../../lib/content';
import { demarcheAudiences, fetchThemes, searchEndpoint } from '../../lib/demarches';

const source = getSource();
const site = await source.site();
const ctx = await simplePage(source, {
  path: '/demarches',
  title: 'Démarches',
  description: `Les démarches administratives de service-public.fr, depuis le site de la mairie de ${site.name}`,
});

const audiences = demarcheAudiences(site.services.demarches.audiences);
const themes = await Promise.all(audiences.map(async (audience) => ({ audience, themes: await fetchThemes(audience) })));
const available = themes.filter((entry) => entry.themes.length > 0);
const { Frame } = theme.templates;
---
<Document ctx={ctx}>
  <Frame ctx={ctx} lead="Les fiches officielles de service-public.fr, mises à jour par l'État, avec les informations de la commune.">
    {available.length === 0 ? (
      <p>
        L'annuaire des démarches n'est pas disponible pour le moment.
        Vous pouvez consulter <a href="https://www.service-public.fr" target="_blank" rel="noopener noreferrer">service-public.fr<span class="cn-sr-only"> (nouvelle fenêtre)</span></a>
        ou <a href="/contact">contacter la mairie</a>.
      </p>
    ) : (
      <>
        <form role="search" aria-label="Rechercher une démarche" action="/demarches" method="get" class="cn-js-only" data-cn-demarches-search data-endpoint={searchEndpoint()}>
          <p>
            <label for="cn-demarches-q">Rechercher parmi toutes les démarches</label>
            <input id="cn-demarches-q" type="search" name="q" autocomplete="off" placeholder="Carte d'identité, permis de construire…" data-cn-demarches-input />
            {available.length > 1 && (
              <>
                <label for="cn-demarches-public">Public</label>
                <select id="cn-demarches-public" name="public" data-cn-demarches-audience>
                  {available.map((entry) => <option value={entry.audience}>{AUDIENCE_LABELS[entry.audience]}</option>)}
                </select>
              </>
            )}
            {available.length === 1 && <input type="hidden" name="public" value={available[0]!.audience} data-cn-demarches-audience />}
            <button type="submit">Rechercher</button>
          </p>
        </form>
        <p role="status" data-cn-search-count data-cn-demarches-count></p>
        <ol data-cn-search-results data-cn-demarches-results></ol>

        <h2>Parcourir par thème</h2>
        {available.map((entry) => (
          <section aria-labelledby={available.length > 1 ? `cn-demarches-${entry.audience}` : undefined}>
            {available.length > 1 && <h3 id={`cn-demarches-${entry.audience}`}>{AUDIENCE_LABELS[entry.audience]}</h3>}
            <ul class="cn-demarches-themes" data-pagefind-ignore>
              {entry.themes.map((themeEntry) => (
                <li>
                  <details>
                    <summary>{themeEntry.title}</summary>
                    <ul>
                      {themeEntry.children.map((child) => (
                        <li>
                          <p>{child.title}</p>
                          <ul>
                            {child.fiches.map((fiche) => (
                              <li>
                                <a href={demarcheHref(fiche.id, entry.audience)}>{fiche.title}</a>
                              </li>
                            ))}
                          </ul>
                        </li>
                      ))}
                      {themeEntry.fiches.map((fiche) => (
                        <li>
                          <a href={demarcheHref(fiche.id, entry.audience)}>{fiche.title}</a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </>
    )}
  </Frame>
</Document>

<script>
  import { initDemarchesSearch } from '../../lib/demarches-page-search';

  initDemarchesSearch();
</script>
