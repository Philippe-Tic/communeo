---
import type { AssociationVM } from '@communeo/core';
import type { PageContext } from '@communeo/theme-contract';
import Layout from '../parts/Layout.astro';

interface Props { ctx: PageContext; association: AssociationVM }
const { ctx, association } = Astro.props;
---
<Layout ctx={ctx}>
  <p class="st-meta">{association.category.label}</p>
  {association.logo && <img src={association.logo.src} alt={association.logo.alt} width={association.logo.width ?? undefined} height={association.logo.height ?? undefined} />}
  {association.description && <p>{association.description}</p>}
  <dl class="st-facts">
    {association.contact.name && <><dt>Contact</dt><dd>{association.contact.name}</dd></>}
    {association.contact.email && <><dt>E-mail</dt><dd><a href={association.contact.email.href}>{association.contact.email.label}</a></dd></>}
    {association.contact.phone && <><dt>Téléphone</dt><dd><a href={association.contact.phone.href}>{association.contact.phone.label}</a></dd></>}
    {association.address && <><dt>Adresse</dt><dd>{association.address}</dd></>}
  </dl>
  {association.website && <p><a href={association.website.href} target="_blank" rel="noopener noreferrer">{association.website.label}<span class="cn-sr-only"> (nouvelle fenêtre)</span></a></p>}
</Layout>
