---
/** Encadré : le type est porté par le libellé et le disque (« i », « ! », « !! », « ★ »), jamais par la seule couleur. */
import type { BlockOf } from '@communeo/core';
import RichText from '@communeo/ui-a11y/RichText.astro';

interface Props { block: BlockOf<'callout'> }
const { block } = Astro.props;
const signs: Record<string, string> = { info: 'i', warning: '!', important: '!!', tip: '★' };
---
<aside class={`bo-callout bo-callout-${block.variant}`} aria-label={block.title ?? block.variantLabel}>
  <span class="bo-callout-sign" aria-hidden="true">{signs[block.variant] ?? 'i'}</span>
  <div>
    <p class="bo-callout-label">{block.variantLabel}{block.title && block.title !== block.variantLabel && <> – {block.title}</>}</p>
    <RichText doc={block.body} class="bo-prose" />
  </div>
</aside>
